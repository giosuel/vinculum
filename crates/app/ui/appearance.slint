// Lituus's own look, in the Settings page, following the "Appearance" mockups: the wallpaper's
// colours (matugen) first, a built-in theme when they're off or missing, dark or light, and the
// hero glow. The hero shows the window in miniature in the colours in use.
import { Theme } from "theme.slint";
import { Switch, Focusable } from "controls.slint";
import { Segmented } from "dialogs.slint";
import { Hero, SettingRow } from "shell.slint";

/// A built-in theme's swatch: a tiny window in its colours.
export struct ThemeSwatch { name: string, bg: color, side: color, accent: color, selected: bool }
/// One of the wallpaper's colours, shown in the hero.
export struct ColourChip { label: string, value: color, hex: string }
/// A colour file from config.toml. tone: the status's colour.
export struct SourceRow { n: int, label: string, path: string, status: string, tone: string, swatches: [color] }

/// The window in miniature, drawn in the colours in use.
component MiniWindow inherits Rectangle {
    width: 300px;
    height: 168px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border2;
    background: Theme.bg;
    clip: true;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000040;
    Rectangle {
        x: 0;
        width: 78px;
        background: Theme.panel;
        VerticalLayout {
            padding: 12px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 7px;
            alignment: start;
            Rectangle { height: 8px; width: 60%; border-radius: 4px; background: Theme.accent; }
            for i in 6: Rectangle { height: 7px; border-radius: 3.5px; background: i == 2 ? Theme.accent-soft-bg : Theme.border2; }
        }
    }
    Rectangle {
        x: 88px;
        y: 10px;
        width: parent.width - 98px;
        height: 80px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: true;
        if Theme.gradient: Rectangle {
            width: parent.width * 1.6;
            height: self.width;
            x: parent.width * 0.7 - self.width / 2;
            y: -self.height / 2;
            background: @radial-gradient(circle, Theme.glow 0%, Theme.surface 70%);
        }
    }
    Rectangle { x: 88px; y: 98px; width: (parent.width - 106px) / 2; height: 60px; border-radius: 8px; background: Theme.surface; }
    Rectangle { x: 88px + (parent.width - 106px) / 2 + 8px; y: 98px; width: (parent.width - 106px) / 2; height: 60px; border-radius: 8px; background: Theme.surface; }
}

component Swatch inherits Focusable {
    in property <ThemeSwatch> swatch;
    callback clicked();
    height: 100px;
    // For the focus ring, around the preview and its name.
    border-radius: 10px;
    focus-key: "swatch:" + swatch.name;
    opacity: root.enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: swatch.name;
    accessible-checked: swatch.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { clicked(); } }
    activated => { root.clicked(); }
    preview := Rectangle {
        y: 0;
        height: 70px;
        border-radius: 10px;
        border-width: root.swatch.selected && root.enabled ? 2px : 1px;
        border-color: root.swatch.selected && root.enabled ? Theme.accent : Theme.ctrl-border;
        background: root.swatch.bg;
        clip: true;
        Rectangle {
            x: 2px;
            y: 2px;
            width: 34%;
            height: parent.height - 4px;
            background: root.swatch.side;
            VerticalLayout {
                padding: 8px;
                spacing: 5px;
                alignment: start;
                Rectangle { height: 5px; border-radius: 2.5px; background: root.swatch.accent; }
                Rectangle { height: 5px; width: 70%; border-radius: 2.5px; background: root.swatch.accent.transparentize(0.75); }
                Rectangle { height: 5px; width: 80%; border-radius: 2.5px; background: root.swatch.accent.transparentize(0.75); }
            }
        }
        Rectangle { x: parent.width * 0.42; y: 10px; width: parent.width * 0.5; height: 22px; border-radius: 5px; background: root.swatch.accent.transparentize(0.86); }
        Rectangle { x: parent.width - 36px; y: parent.height - 20px; width: 26px; height: 9px; border-radius: 4.5px; background: root.swatch.accent; }
    }
    Text {
        y: 78px;
        x: 0;
        width: parent.width;
        overflow: elide;
        text: root.swatch.name + (root.swatch.selected && root.enabled ? " · in use" : "");
        color: root.swatch.selected ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.swatch.selected ? 600 : 400;
    }
}

/// The Settings hero: the look in use and the window in miniature in its colours.
export component SettingsHero inherits Hero {
    /// The wallpaper's colours are what the window shows now.
    in property <bool> wallpaper-in-use;
    in property <string> name;
    in property <string> name-text;
    in property <[ColourChip]> chips;
    title: "Settings";
    // In a short window, as compact as the other heroes: the look's name and line, without the
    // miniature window (it doesn't fit) or the colour chips (the colour files show them).
    hero-height: root.compact ? 136px : 206px;
    picture-width: root.compact ? 0 : preview.width + 24px;
    VerticalLayout {
        x: 24px;
        width: parent.width - 48px - root.picture-width;
        height: self.preferred-height;
        y: parent.height - self.height - (root.compact ? 16px : 22px);
        spacing: 5px;
        Text { text: root.name; color: Theme.text; font-size: 22px; font-weight: 600; overflow: elide; }
        Text { text: root.name-text; color: Theme.muted; font-size: 13px; wrap: root.compact ? no-wrap : word-wrap; overflow: elide; }
        if root.wallpaper-in-use && !root.compact: HorizontalLayout {
            padding-top: 5px;
            spacing: 8px;
            alignment: start;
            for chip in root.chips: Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border2;
                background: chip.value;
                accessible-role: text;
                accessible-label: chip.label + " " + chip.hex;
            }
        }
    }
    preview := MiniWindow { x: parent.width - self.width - 24px; y: (parent.height - self.height) / 2; visible: !root.compact; }
}

/// The colour files from config.toml, with the colours each has.
export component ColourFiles inherits VerticalLayout {
    in property <[SourceRow]> sources;
    in property <string> config-path;
    spacing: 0;
    alignment: start;
    for s[i] in root.sources: HorizontalLayout {
        min-height: 46px;
        spacing: 10px;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; y: (parent.height - 8px) / 2; background: Theme.tone(s.tone); }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: s.path; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
            Text { text: s.label + " · " + s.status; color: Theme.faint; font-size: 12px; overflow: elide; }
        }
        HorizontalLayout {
            spacing: 3px;
            alignment: center;
            for c in s.swatches: Rectangle { width: 14px; height: 14px; y: (parent.height - 14px) / 2; border-radius: 4px; background: c; border-width: 1px; border-color: Theme.border2; }
        }
    }
    HorizontalLayout {
        padding-top: 8px;
        Text { text: "Add or reorder them in " + root.config-path + "."; color: Theme.faint; font-size: 12px; wrap: word-wrap; }
    }
}

/// The Appearance section of Settings: follow the wallpaper, a built-in theme, dark or light, and
/// the hero glow.
export component AppearanceSettings inherits VerticalLayout {
    in property <bool> follow;
    /// Whether a colour file is there to follow.
    in property <bool> follow-available;
    /// The wallpaper's colours are what the window shows now.
    in property <bool> wallpaper-in-use;
    in property <[ThemeSwatch]> swatches;
    in property <string> note;
    in property <int> mode;
    in property <bool> gradient;
    callback follow-toggled();
    callback theme-chosen(int);
    callback mode-chosen(int);
    callback gradient-toggled();
    spacing: 0;
    alignment: start;

    SettingRow {
        label: "Follow wallpaper";
        description: root.follow-available ? "Use the colours matugen makes from your wallpaper" : "No wallpaper colours found";
        first: true;
        // Turned off, with the reason in the line beside it.
        Switch {
            on: root.follow && root.follow-available;
            label: "Follow wallpaper";
            enabled: root.follow-available;
            toggled => { root.follow-toggled(); }
        }
    }
    SettingRow {
        label: "Built-in theme";
        description: root.note != "" ? root.note : "Used when Follow wallpaper is off or no colours are found";
    }
    HorizontalLayout {
        padding-bottom: 14px;
        spacing: 14px;
        for swatch[i] in root.swatches: Swatch {
            horizontal-stretch: 1;
            swatch: swatch;
            enabled: root.note == "";
            clicked => { root.theme-chosen(i); }
        }
    }
    SettingRow {
        label: "Mode";
        description: "Auto follows the desktop";
        Segmented {
            label: "Mode";
            // As wide as its options, beside the text that takes the rest of the row.
            horizontal-stretch: 0;
            height: 34px;
            options: ["Auto", "Dark", "Light"];
            selected: root.mode;
            enabled: !root.wallpaper-in-use;
            changed(i) => { root.mode-chosen(i); }
        }
    }
    SettingRow {
        label: "Hero gradient";
        description: "The accent glow behind each page's picture";
        Switch { on: root.gradient; label: "Hero gradient"; toggled => { root.gradient-toggled(); } }
    }
}
