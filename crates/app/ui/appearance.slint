// The Appearance page, following the "Appearance" mockups: the wallpaper's colours (matugen)
// first, a built-in theme when they're off or missing, dark or light, and the hero glow.
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Switch, SectionLabel } from "controls.slint";
import { Segmented } from "dialogs.slint";
import { Hero, Card } from "shell.slint";

/// A built-in theme's swatch: a tiny window in its colours.
export struct ThemeSwatch { name: string, bg: color, side: color, accent: color, selected: bool }
/// One of the wallpaper's colours, shown in the hero.
export struct ColourChip { label: string, value: color, hex: string }
/// A colour file from config.toml. tone: the status's colour.
export struct SourceRow { n: int, label: string, path: string, status: string, tone: string, swatches: [color] }

/// The window in miniature, drawn in the colours in use.
component MiniWindow inherits Rectangle {
    width: 300px;
    height: 168px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.ctrl-border;
    background: Theme.bg;
    clip: true;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000040;
    Rectangle {
        x: 0;
        width: 78px;
        background: Theme.panel;
        VerticalLayout {
            padding: 12px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 7px;
            alignment: start;
            Rectangle { height: 8px; width: 60%; border-radius: 4px; background: Theme.accent; }
            for i in 6: Rectangle { height: 7px; border-radius: 3.5px; background: i == 2 ? Theme.accent-soft-bg : Theme.border2; }
        }
    }
    Rectangle {
        x: 88px;
        y: 10px;
        width: parent.width - 98px;
        height: 80px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: true;
        if Theme.gradient: Rectangle {
            width: parent.width * 1.6;
            height: self.width;
            x: parent.width * 0.7 - self.width / 2;
            y: -self.height / 2;
            background: @radial-gradient(circle, Theme.glow 0%, Theme.surface 70%);
        }
    }
    Rectangle { x: 88px; y: 98px; width: (parent.width - 106px) / 2; height: 60px; border-radius: 8px; background: Theme.surface; }
    Rectangle { x: 88px + (parent.width - 106px) / 2 + 8px; y: 98px; width: (parent.width - 106px) / 2; height: 60px; border-radius: 8px; background: Theme.surface; }
}

component Swatch inherits Rectangle {
    in property <ThemeSwatch> swatch;
    in property <bool> enabled: true;
    callback clicked();
    height: 100px;
    opacity: enabled ? 1 : 0.42;
    accessible-role: button;
    accessible-label: swatch.name;
    accessible-checked: swatch.selected;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    preview := Rectangle {
        y: 0;
        height: 70px;
        border-radius: 10px;
        border-width: root.swatch.selected && root.enabled ? 2px : 1px;
        border-color: root.swatch.selected && root.enabled ? Theme.accent : Theme.ctrl-border;
        background: root.swatch.bg;
        clip: true;
        Rectangle {
            x: 2px;
            y: 2px;
            width: 34%;
            height: parent.height - 4px;
            background: root.swatch.side;
            VerticalLayout {
                padding: 8px;
                spacing: 5px;
                alignment: start;
                Rectangle { height: 5px; border-radius: 2.5px; background: root.swatch.accent; }
                Rectangle { height: 5px; width: 70%; border-radius: 2.5px; background: root.swatch.accent.transparentize(0.75); }
                Rectangle { height: 5px; width: 80%; border-radius: 2.5px; background: root.swatch.accent.transparentize(0.75); }
            }
        }
        Rectangle { x: parent.width * 0.42; y: 10px; width: parent.width * 0.5; height: 22px; border-radius: 5px; background: root.swatch.accent.transparentize(0.86); }
        Rectangle { x: parent.width - 36px; y: parent.height - 20px; width: 26px; height: 9px; border-radius: 4.5px; background: root.swatch.accent; }
    }
    Text {
        y: 78px;
        x: 0;
        text: root.swatch.name + (root.swatch.selected && root.enabled ? " · in use" : "");
        color: root.swatch.selected ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.swatch.selected ? 600 : 400;
    }
    TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

export component AppearancePage inherits VerticalLayout {
    in property <bool> follow;
    /// Whether a colour file is there to follow.
    in property <bool> follow-available;
    /// The wallpaper's colours are what the window shows now.
    in property <bool> wallpaper-in-use;
    in property <string> sub;
    in property <string> name;
    in property <string> name-text;
    in property <[ColourChip]> chips;
    in property <[ThemeSwatch]> swatches;
    in property <string> note;
    in property <int> mode;
    in property <bool> gradient;
    in property <[SourceRow]> sources;
    in property <string> config-path;
    callback follow-toggled();
    callback theme-chosen(int);
    callback mode-chosen(int);
    callback gradient-toggled();
    spacing: 14px;

    Hero {
        title: "Appearance";
        sub: root.sub;
        hero-height: 286px;
        HorizontalLayout {
            x: 24px;
            y: parent.height - self.height - 24px;
            width: parent.width - 48px;
            height: 168px;
            spacing: 32px;
            MiniWindow { }
            VerticalLayout {
                alignment: end;
                spacing: 12px;
                padding-bottom: 4px;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.name; color: Theme.text; font-size: 22px; font-weight: 600; }
                    Text { text: root.name-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                }
                if root.wallpaper-in-use: HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    for chip in root.chips: VerticalLayout {
                        spacing: 5px;
                        Rectangle { width: 52px; height: 52px; border-radius: 13px; background: chip.value; border-width: 1px; border-color: Theme.ctrl-border; }
                        Text { text: chip.label; color: Theme.text; font-size: 12px; }
                        Text { text: chip.hex; color: Theme.faint; font-size: 11px; font-family: "JetBrains Mono"; }
                    }
                }
            }
        }
        Rectangle {
            x: parent.width - self.width - 18px;
            y: 18px;
            width: follow-pill.preferred-width;
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.ctrl-border;
            background: Theme.input-bg;
            opacity: root.follow-available ? 1 : 0.5;
            follow-pill := HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 10px;
                Text { text: "Follow wallpaper"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                Switch {
                    on: root.follow && root.follow-available;
                    label: "Follow wallpaper";
                    switch-width: 40px;
                    y: (parent.height - self.height) / 2;
                    toggled => { if root.follow-available { root.follow-toggled(); } }
                }
            }
        }
    }

    Card {
        height: theme-card.preferred-height;
        theme-card := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: "Built-in theme"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Text {
                    text: root.note != "" ? root.note : "Used when Follow wallpaper is off or no colours are found";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                for swatch[i] in root.swatches: Swatch {
                    horizontal-stretch: 1;
                    swatch: swatch;
                    enabled: root.note == "";
                    clicked => { root.theme-chosen(i); }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 18px;
                spacing: 4px;
                alignment: start;
                Text { text: "Look"; color: Theme.text; font-weight: 600; height: 26px; }
                HorizontalLayout {
                    spacing: 16px;
                    min-height: 52px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Mode"; color: Theme.text; font-size: 13px; }
                        Text { text: "Auto follows the desktop"; color: Theme.faint; font-size: 12px; }
                    }
                    Segmented {
                        label: "Mode";
                        options: ["Auto", "Dark", "Light"];
                        selected: root.mode;
                        enabled: !root.wallpaper-in-use;
                        y: (parent.height - self.height) / 2;
                        changed(i) => { root.mode-chosen(i); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 16px;
                    min-height: 52px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Hero gradient"; color: Theme.text; font-size: 13px; }
                        Text { text: "The accent glow behind each page's picture"; color: Theme.faint; font-size: 12px; }
                    }
                    Switch { on: root.gradient; label: "Hero gradient"; y: (parent.height - self.height) / 2; toggled => { root.gradient-toggled(); } }
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 18px;
                spacing: 0;
                alignment: start;
                HorizontalLayout {
                    height: 30px;
                    Text { text: "Colour files"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: root.config-path; color: Theme.faint; font-size: 11px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
                for s[i] in root.sources: HorizontalLayout {
                    min-height: 46px;
                    spacing: 10px;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; y: (parent.height - 8px) / 2; background: Theme.tone(s.tone); }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: s.path; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
                        Text { text: s.label + " · " + s.status; color: Theme.faint; font-size: 12px; overflow: elide; }
                    }
                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;
                        for c in s.swatches: Rectangle { width: 14px; height: 14px; y: (parent.height - 14px) / 2; border-radius: 4px; background: c; border-width: 1px; border-color: Theme.border2; }
                    }
                }
                Text { text: "Add or reorder colour files in config.toml."; color: Theme.faint; font-size: 12px; height: 30px; vertical-alignment: bottom; }
            }
        }
    }
}
