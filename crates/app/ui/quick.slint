// The quick popup: a small window from the tray icon (left-click), `lituus --quick` or a
// keybind, with the nearest networks, the VPNs, the Bluetooth devices, the volume and airplane
// mode, each under its heading. Its rows come from Rust (src/quick.rs, and main.rs for the rest).
// Wayland doesn't let apps place windows, so a window rule floats it (see extras/hyprland.lua).
import { Theme } from "theme.slint";
import { Icon, SignalBars } from "icons.slint";
import { Button, IconButton, Switch, CardTitle, Scroll, Focus } from "controls.slint";
import { Slider } from "sound.slint";

/// A network, a VPN or a Bluetooth device. icon: "bars" (signal bars), or an icon name. active:
/// connected or connecting, which its meta line says first. button: "Connect", "Disconnect" or
/// "Cancel".
export struct QuickRow { id: string, name: string, meta: string, icon: string, bars: int, active: bool, button: string }

// One quick action, the button, as the guide allows in lists people scan to act on. A click on
// the row does the same, or opens Lituus on it once it's connected.
component Row inherits Rectangle {
    in property <QuickRow> entry;
    callback button-clicked();
    callback opened();
    height: 48px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: entry.name + ", " + entry.meta;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.entry.active { root.opened(); } else { root.button-clicked(); } }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        // Both drawn in one place, only one of them shown: no `if` per row.
        Rectangle {
            width: 20px;
            SignalBars { bars: root.entry.bars; y: (parent.height - 14px) / 2; visible: root.entry.icon == "bars"; }
            Icon { name: root.entry.icon == "bars" ? "" : root.entry.icon; tint: root.entry.active ? Theme.accent : Theme.muted; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
            Text { text: root.entry.meta; color: root.entry.active ? Theme.accent : Theme.muted; font-size: 11px; overflow: elide; }
        }
        if root.entry.button != "": Button {
            label: root.entry.button;
            focus-key: "quick:" + root.entry.id;
            button-height: 28px;
            horizontal-stretch: 0;
            min-width: self.preferred-width;
            max-width: self.preferred-width;
            y: (parent.height - self.height) / 2;
            clicked => { root.button-clicked(); }
        }
    }
}

// A section's title, with its switch or tools on the right.
component Heading inherits HorizontalLayout {
    in property <string> text;
    height: 34px;
    spacing: 10px;
    CardTitle { text: root.text; horizontal-stretch: 1; }
    @children
}

// A line in place of a section's rows ("Wi-Fi: off", "No paired devices").
component Note inherits HorizontalLayout {
    in property <string> text;
    height: 34px;
    padding-left: 10px;
    Text { text: root.text; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
}

export component QuickWindow inherits Window {
    in property <bool> wifi-available;
    in property <bool> wifi-on;
    in property <string> wifi-status;
    in property <[QuickRow]> networks;
    in property <[QuickRow]> vpns;
    /// Bluetooth: there's an adapter (and BlueZ), it's on, and its paired devices.
    in property <bool> bt-available;
    in property <bool> bt-on;
    in property <[QuickRow]> devices;
    /// The output in use: its volume (1.0 is 100 %), mute, and the slider's top.
    in property <bool> sound-available;
    in property <float> volume;
    in property <bool> muted;
    in property <float> volume-max: 1;
    in property <bool> airplane;
    callback wifi-switched();
    callback rescan();
    /// A row's button, or a click on a row that isn't connected.
    callback row-button(string);
    /// A click on a connected row: Lituus opens on it.
    callback row-opened(string);
    callback bt-switched();
    callback volume-moved(float);
    callback mute-clicked();
    callback airplane-switched();
    callback open-main();
    callback open-settings();
    callback dismissed();

    title: "Lituus quick";
    icon: @image-url("assets/logo-mark.svg");
    width: 380px;
    height: 600px;
    background: Theme.surface;
    default-font-family: "Inter";
    default-font-size: 13px;

    // As in the main window (see there): when the control with the focus goes away, the
    // window takes it.
    Timer {
        interval: 150ms;
        running: Focus.on-control;
        triggered => {
            if Focus.answer != Focus.probe {
                Focus.on-control = false;
                Focus.key = "";
                keys.focus();
            }
            Focus.probe += 1;
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Heading {
                text: "Wi-Fi";
                if root.wifi-on: IconButton { icon: "rescan"; label: "Rescan"; clicked => { root.rescan(); } }
                if root.wifi-available: Switch {
                    on: root.wifi-on;
                    label: "Wi-Fi";
                    switch-width: 40px;
                    y: (parent.height - self.height) / 2;
                    toggled => { root.wifi-switched(); }
                }
            }
            // The lists scroll when there's more than the popup's height; the volume, airplane
            // mode and the buttons stay at the bottom.
            Scroll {
                vertical-stretch: 1;
                spacing: 2px;
                bar-inset: -12px;
                if root.networks.length == 0: Note { text: root.wifi-status; }
                for n in root.networks: Row { entry: n; button-clicked => { root.row-button(n.id); } opened => { root.row-opened(n.id); } }
                if root.vpns.length > 0: Heading { text: "VPN"; padding-top: 10px; height: 44px; }
                for v in root.vpns: Row { entry: v; button-clicked => { root.row-button(v.id); } opened => { root.row-opened(v.id); } }
                if root.bt-available: Heading {
                    text: "Bluetooth";
                    padding-top: 10px;
                    height: 44px;
                    VerticalLayout {
                        alignment: center;
                        Switch { on: root.bt-on; label: "Bluetooth"; switch-width: 40px; toggled => { root.bt-switched(); } }
                    }
                }
                if root.bt-available && root.devices.length == 0: Note { text: root.bt-on ? "No paired devices" : "Off"; }
                for d in root.devices: Row { entry: d; button-clicked => { root.row-button(d.id); } opened => { root.row-opened(d.id); } }
            }
            Rectangle { height: 1px; background: Theme.border2; }
            if root.sound-available: VerticalLayout {
                spacing: 2px;
                Heading { text: "Volume"; }
                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 4px;
                    spacing: 10px;
                    height: 36px;
                    IconButton {
                        icon: root.muted ? "volume-off" : "volume";
                        label: root.muted ? "Unmute" : "Mute";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.mute-clicked(); }
                    }
                    Slider {
                        label: "Volume";
                        value: root.volume;
                        maximum: root.volume-max;
                        mark: root.volume-max > 1 ? 1 : -1;
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        moved(v) => { root.volume-moved(v); }
                    }
                    Text {
                        text: root.muted ? "Muted" : round(root.volume * 100) + " %";
                        color: Theme.muted;
                        font-size: 12px;
                        font-family: "JetBrains Mono";
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        width: 48px;
                    }
                }
            }
            HorizontalLayout {
                padding-left: 2px;
                height: 44px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    CardTitle { text: "Airplane mode"; }
                    Text { text: "Turns off Wi-Fi, Bluetooth and mobile broadband"; color: Theme.muted; font-size: 11px; overflow: elide; }
                }
                Switch { on: root.airplane; label: "Airplane mode"; switch-width: 40px; y: (parent.height - self.height) / 2; toggled => { root.airplane-switched(); } }
            }
            HorizontalLayout {
                padding-top: 4px;
                spacing: 8px;
                Button { label: "Open Lituus"; button-height: 36px; horizontal-stretch: 1; clicked => { root.open-main(); } }
                IconButton { icon: "settings"; label: "Settings"; size: 36px; clicked => { root.open-settings(); } }
            }
        }
    }
}
