// The frame every page shares, following the "Hero" mockups: the sidebar with its groups, status
// and search, the hero at the top of a page (a big live picture of what the page is about), and
// the cards below it.
import { Theme } from "theme.slint";
import { Icon, Logo, Spinner } from "icons.slint";
import { Button, Switch, SectionLabel, Banner, Focusable, Scroll, Focus } from "controls.slint";

/// sub: a short status on the right ("Home", "2 on", "45%"), and `spoken`, the same as a screen
/// reader says it ("2 connected"). open: an item showing its sub-items, on one of their pages.
/// indent: a sub-item. foldable: an item with sub-items, which its chevron folds away (folded).
/// The pages are one Tab stop, the `stop` (the current page, else the first); the arrow keys
/// move between them by `place` (top to bottom, from 0), and from a sub-item to its item's
/// place, `parent`. off: why the page can't be opened now (it needs Hyprland); empty when it can.
export struct NavItem { id: string, label: string, sub: string, spoken: string, icon: string, current: bool, open: bool, indent: bool, foldable: bool, folded: bool, stop: bool, place: int, parent: int, off: string }
export struct NavGroup { title: string, items: [NavItem] }
/// What a page's hero shows: a big icon, a name, a line under it and a monospaced line.
/// tone: the colour of `meta` ("accent", "muted", "danger", "faint").
export struct HeroInfo { icon: string, name: string, meta: string, tone: string, detail: string }

// A sub-item is smaller and indented, under its item. An item with sub-items has a chevron that
// folds them away; the rest of the row goes to the page. In the list of pages, only the `stop`
// is a Tab stop: ↑↓ move the focus, Enter or Space opens the page, and as in a tree, → unfolds
// (then goes to the first sub-item) and ← folds (or goes from a sub-item to its item).
component NavButton inherits Rectangle {
    in property <NavItem> item;
    /// What the arrow keys asked for: the place of the page that takes the focus (-1: the stop),
    /// and a count that goes up with each request.
    in property <int> want-place;
    in property <int> want-serial;
    callback clicked();
    callback fold-clicked();
    /// An arrow key: the page at this place is to take the focus.
    callback want(int);
    /// A page that can't be opened is pointed at, or reached with the keyboard (true), or no
    /// longer (false): the tooltip saying why goes beside it, at `y` in the window.
    callback tip(bool, length);
    property <bool> is-off: root.item.off != "";
    property <bool> pointed: root.is-off && (body.has-hover || (body.has-focus && Focus.keyboard));
    changed pointed => { root.tip(self.pointed, self.absolute-position.y); }
    height: item.indent ? 32px : 36px;
    accessible-role: button;
    accessible-enabled: !root.is-off;
    accessible-description: root.item.off;
    accessible-label: item.sub == "" ? item.label : item.label + ", " + (item.spoken != "" ? item.spoken : item.sub);
    accessible-expandable: item.foldable;
    accessible-expanded: !item.folded;
    accessible-action-default => { clicked(); }
    accessible-action-expand => { fold-clicked(); }
    forward-focus: body;
    changed want-serial => {
        if root.want-place == root.item.place || (root.want-place == -1 && root.item.stop) {
            Focus.keyboard = true;
            body.focus();
        }
    }
    body := Focusable {
        x: root.item.indent ? 20px : 0;
        width: parent.width - self.x;
        focus-key: "nav:" + root.item.id;
        tab-stop: root.item.stop;
        // The sidebar's list would cut off a ring outside it.
        ring-gap: -2px;
        border-radius: root.item.indent ? 9px : 10px;
        background: root.item.current ? Theme.accent-soft-bg : self.has-hover && !root.is-off ? Theme.hover : transparent;
        // Turned off, it stays reachable (so its tooltip can be read) but does nothing.
        activated => { if !root.is-off { root.clicked(); } }
        key(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if event.text == Key.DownArrow { root.want(root.item.place + 1); return accept; }
            if event.text == Key.UpArrow { if root.item.place > 0 { root.want(root.item.place - 1); } return accept; }
            if event.text == Key.RightArrow && root.item.foldable {
                if root.item.folded { root.fold-clicked(); } else { root.want(root.item.place + 1); }
                return accept;
            }
            if event.text == Key.LeftArrow && root.item.foldable && !root.item.folded { root.fold-clicked(); return accept; }
            if event.text == Key.LeftArrow && root.item.indent { root.want(root.item.parent); return accept; }
            reject
        }
        // The accent bar on the current page's left edge.
        if root.item.current: Rectangle { x: 0; width: 3px; height: parent.height - 12px; y: 6px; border-radius: 1.5px; background: Theme.accent; }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: root.item.indent ? 10px : 11px;
            Icon {
                name: root.item.icon;
                tint: root.is-off ? Theme.faint.transparentize(0.45) : root.item.current || root.item.open ? Theme.accent : root.item.indent ? Theme.faint : Theme.muted;
                size: root.item.indent ? 15px : 17px;
                y: (parent.height - self.size) / 2;
            }
            Text {
                text: root.item.label;
                color: root.is-off ? Theme.faint.transparentize(0.3) : root.item.indent && !root.item.current ? Theme.muted : Theme.text;
                font-size: root.item.indent ? 13px : 14px;
                font-weight: root.item.current || root.item.open ? 600 : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                // The name stays whole; the status beside it elides ("Netw…" beside a folded
                // Network's "Lumen Home").
                min-width: self.preferred-width;
                overflow: elide;
            }
            Text {
                text: root.item.sub;
                color: root.item.current ? Theme.accent : Theme.faint;
                font-size: root.item.indent ? 11px : 12px;
                vertical-alignment: center;
                overflow: elide;
                max-width: 90px;
            }
            // For the pointer: the keyboard folds with ← and →, so it's no Tab stop.
            if root.item.foldable: Focusable {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                tab-stop: false;
                border-radius: 6px;
                activated => { root.fold-clicked(); }
                accessible-role: button;
                accessible-label: root.item.label + " pages, " + (root.item.folded ? "collapsed" : "expanded");
                accessible-expandable: true;
                accessible-expanded: !root.item.folded;
                accessible-action-default => { root.fold-clicked(); }
                accessible-action-expand => { root.fold-clicked(); }
                Icon {
                    name: "chevron";
                    size: 16px;
                    tint: root.is-off ? Theme.faint.transparentize(0.45) : parent.has-hover ? Theme.text : Theme.muted;
                    // Down when unfolded, right when folded.
                    transform-rotation: root.item.folded ? -90deg : 0deg;
                    animate transform-rotation { duration: 120ms; easing: ease-out; }
                }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[NavGroup]> groups;
    in property <bool> settings-current;
    in property <bool> airplane;
    in property <string> hostname;
    /// Incremented to move the keyboard focus into the search field (Ctrl+K).
    in property <int> focus-requests;
    /// Incremented to move it to the list of pages (F6 from the page).
    in property <int> list-focus-requests;
    /// F6 in the sidebar: the page is to take the focus.
    callback leave();
    callback navigate(string);
    /// The chevron of an item with sub-items.
    callback fold(string);
    callback search(string);
    /// Enter in the search field: go to the first page found.
    callback search-accepted();
    /// Esc in the search field, to give the focus back to the window.
    callback search-left();
    callback airplane-toggled();
    callback hostname-clicked();
    /// Why the page pointed at can't be opened, and where it is (y in the window), for the
    /// tooltip the window shows beside the sidebar.
    out property <string> tip;
    out property <length> tip-y;
    width: 250px;
    background: Theme.panel;
    // The page the arrow keys (or F6) send the focus to; see NavButton.
    property <int> want-place: -1;
    property <int> want-serial;
    changed list-focus-requests => {
        // Nothing matches the search: back to the search field.
        if root.groups.length == 0 {
            input.focus();
        } else {
            root.want-place = -1;
            root.want-serial += 1;
        }
    }
    // Only for F6 from any of its controls: no Tab stop of its own.
    FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.F6 { root.leave(); return accept; }
            reject
        }
        VerticalLayout {
            padding: 12px;
            padding-top: 14px;
            spacing: 1px;
            HorizontalLayout {
                padding-left: 8px;
                height: 44px;
                spacing: 10px;
                alignment: start;
                Logo { size: 26px; y: (parent.height - 26px) / 2; }
                Text { text: "Lituus"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                property <int> requests: root.focus-requests;
                changed requests => { input.focus(); }
                height: 34px;
                border-radius: 10px;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.ctrl-border;
                background: Theme.input-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;
                    Icon { name: "search"; tint: Theme.muted; size: 14px; y: (parent.height - 14px) / 2; }
                    Rectangle {
                        horizontal-stretch: 1;
                        input := TextInput {
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-label: "Search settings";
                            edited => { root.search(self.text); }
                            accepted => { root.search-accepted(); self.text = ""; root.search(""); root.search-left(); }
                            key-pressed(event) => {
                                if event.text == Key.Escape { self.text = ""; root.search(""); root.search-left(); return accept; }
                                if event.text == Key.F6 { root.leave(); return accept; }
                                reject
                            }
                        }
                        if input.text == "": Text { x: 0; text: "Search"; color: Theme.faint; font-size: 13px; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: kbd.preferred-width + 10px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.border2;
                        kbd := Text { text: "Ctrl K"; color: Theme.faint; font-size: 11px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            // The pages scroll when they don't fit between the search and Settings (Network's
            // sub-items in a short window), with the scrollbar in the padding on the right.
            page-list := Scroll {
                vertical-stretch: 1;
                spacing: 1px;
                bar-inset: -8px;
                for group in root.groups: VerticalLayout {
                    spacing: 1px;
                    SectionLabel { text: group.title; height: 30px; vertical-alignment: bottom; x: 12px; }
                    Rectangle { height: 4px; }
                    for item in group.items: NavButton {
                        item: item;
                        want-place: root.want-place;
                        want-serial: root.want-serial;
                        clicked => { root.navigate(item.id); }
                        fold-clicked => { root.fold(item.id); }
                        want(place) => { root.want-place = place; root.want-serial += 1; }
                        tip(shown, y) => {
                            if shown {
                                root.tip = item.off;
                                root.tip-y = y;
                            } else if root.tip-y == y {
                                root.tip = "";
                            }
                        }
                    }
                }
                if root.groups.length == 0: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text { text: "No setting matches the search."; color: Theme.faint; font-size: 12px; wrap: word-wrap; height: 40px; vertical-alignment: center; }
                }
            }
            // A line where the pages are cut off; always there, so the layout doesn't change.
            Rectangle { height: 1px; background: page-list.overflows ? Theme.border : transparent; }
            // A Tab stop of its own, below the list.
            NavButton {
                item: { id: "settings", label: "Settings", sub: "", icon: "settings", current: root.settings-current, stop: true, place: -1, parent: -1, off: "" };
                clicked => { root.navigate("settings"); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                height: 36px;
                spacing: 11px;
                Icon { name: "plane"; tint: Theme.muted; size: 17px; y: (parent.height - 17px) / 2; }
                Text { text: "Airplane mode"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                Switch { on: root.airplane; label: "Airplane mode"; y: (parent.height - self.height) / 2; toggled => { root.airplane-toggled(); } }
            }
            if root.hostname != "": Focusable {
                height: host-row.preferred-height;
                border-radius: 8px;
                ring-gap: -2px;
                background: self.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: "Change the hostname";
                accessible-action-default => { root.hostname-clicked(); }
                activated => { root.hostname-clicked(); }
                host-row := HorizontalLayout {
                    padding: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    Text { text: "Hostname"; color: Theme.faint; font-size: 12px; }
                    Text { text: root.hostname; color: Theme.muted; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; horizontal-stretch: 1; }
                    // It opens a dialog to change the name: the pencil says so.
                    VerticalLayout { alignment: center; Icon { name: "pencil"; size: 12px; tint: Theme.faint; } }
                }
            }
        }
    }
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
}

/// The top of a page: its title, a line under it, and a big picture placed by the page (its
/// children). Behind it, a glow in the accent colour from the top right.
export component Hero inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <length> hero-height: 230px;
    /// In a short window: the line goes beside the title, so the picture can move up.
    in property <bool> compact;
    /// The width of what the page puts in the top right corner, which the line stops before.
    in property <length> aside;
    /// Room kept free on the right of the title, for a picture there.
    in property <length> picture-width: 0px;
    height: hero-height;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;
    if Theme.gradient: Rectangle {
        // A circle twice the hero's height, centred on its top edge at 70 % of its width; the
        // gradient fades from the glow to the surface colour within it.
        width: root.height * 2.6;
        height: self.width;
        x: root.width * 0.7 - self.width / 2;
        y: -self.height / 2;
        background: @radial-gradient(circle, Theme.glow 0%, Theme.surface 70%);
    }
    if !root.compact: VerticalLayout {
        x: 24px;
        y: 18px;
        width: parent.width - 48px - root.picture-width;
        height: self.preferred-height;
        spacing: 4px;
        Text { text: root.title; color: Theme.text; font-size: 30px; font-weight: 600; }
        if root.sub != "": Text { text: root.sub; color: Theme.muted; font-size: 13px; overflow: elide; }
    }
    if root.compact: HorizontalLayout {
        x: 24px;
        y: 16px;
        width: parent.width - 48px - root.picture-width - (root.aside > 0 ? root.aside + 12px : 0);
        height: self.preferred-height;
        spacing: 14px;
        Text { text: root.title; color: Theme.text; font-size: 30px; font-weight: 600; }
        // On the title's baseline.
        if root.sub != "": VerticalLayout {
            alignment: end;
            padding-bottom: 5px;
            horizontal-stretch: 1;
            Text { text: root.sub; color: Theme.muted; font-size: 13px; overflow: elide; }
        }
    }
    @children
}

/// The subject of a hero, in its bottom left: a round icon, a name, and two lines.
export component HeroSubject inherits HorizontalLayout {
    in property <HeroInfo> info;
    /// A smaller circle, and no monospaced line.
    in property <bool> compact;
    in property <length> circle: compact ? 56px : 88px;
    spacing: 20px;
    alignment: start;
    Rectangle {
        width: root.circle;
        height: root.circle;
        y: parent.height - self.height;
        border-radius: self.width / 2;
        background: Theme.accent-soft-bg;
        Icon { name: root.info.icon; tint: Theme.accent; size: root.circle * 0.48; stroke-width: 1.3px; }
    }
    VerticalLayout {
        alignment: end;
        spacing: 5px;
        padding-bottom: 4px;
        Text { text: root.info.name; color: Theme.text; font-size: 22px; font-weight: 600; overflow: elide; }
        if root.info.meta != "": Text { text: root.info.meta; color: Theme.tone(root.info.tone); font-size: 13px; overflow: elide; }
        if root.info.detail != "" && !root.compact: Text { text: root.info.detail; color: Theme.faint; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
    }
}

/// "● Changed from 600 ms": a mark beside what differs from the default.
component Differs inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.accent; } }
    // No width of its own: showing it mustn't move the control beside it (a slider being dragged).
    Text { text: root.text; color: Theme.muted; font-size: 12px; overflow: elide; preferred-width: 0; horizontal-stretch: 1; }
}

/// A setting in a card, the one row every page's settings use: its name and a line under it on
/// the left (or, for a setting that differs from its default, what the default is), its control
/// (the children) on the right, and a line above it unless it's the first of its group.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> differs;
    in property <bool> first;
    min-height: 48px;
    Rectangle { y: 0; height: 1px; background: root.first ? transparent : Theme.border; }
    HorizontalLayout {
        spacing: 14px;
        padding-top: 5px;
        padding-bottom: 5px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            // The control gives way before the name does.
            min-width: 112px;
            Text { text: root.label; color: Theme.text; font-size: 13px; overflow: elide; }
            if root.differs != "": Differs { text: root.differs; }
            if root.differs == "" && root.description != "": Text { text: root.description; color: Theme.faint; font-size: 12px; wrap: word-wrap; }
        }
        // Centred by a layout: a `y` on the control put it at the top of the row.
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

/// A small note beside what it's about (a page in the sidebar that can't be opened): Select's
/// popup look, smaller.
export component Tooltip inherits Rectangle {
    in property <string> text;
    width: 250px;
    height: label.preferred-height + 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border2;
    background: Theme.ctrl-bg;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000073;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    label := Text {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        wrap: word-wrap;
    }
}

/// A panel on a page: the list, the details, a group of settings.
export component Card inherits Rectangle {
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;
}

/// A card that reaches the bottom of its column and scrolls what's in it, once that's taller.
/// Below `least` the page scrolls instead. With `whole` (cards stacked in one column) it's as
/// tall as what's in it, and the page scrolls. With `fill`, what's in it fills its height, as
/// in `Scroll`.
export component ScrollCard inherits Card {
    in property <bool> whole;
    in property <bool> fill;
    in property <length> least: 120px;
    min-width: scroll.min-width;
    min-height: root.whole ? scroll.content-height : min(root.least, scroll.content-height);
    preferred-height: root.whole ? scroll.content-height : 0;
    vertical-stretch: 1;
    scroll := Scroll {
        width: parent.width;
        height: parent.height;
        fill: root.fill;
        @children
    }
}

/// What a card shows when its page has nothing to show (a service isn't running, Wi-Fi is off,
/// no VPN yet): a 44 px icon (a spinner while `loading`), a title, why, a command that fixes it
/// with Copy, and a button. With a command, the button is secondary: the command is the fix.
export component EmptyState inherits VerticalLayout {
    in property <string> icon;
    in property <bool> loading;
    in property <string> title;
    in property <string> text;
    in property <string> command;
    in property <string> action;
    callback copied();
    callback action-clicked();
    alignment: center;
    spacing: 14px;
    padding: 18px;
    if root.loading: HorizontalLayout { alignment: center; Spinner { size: 20px; } }
    if !root.loading && root.icon != "": HorizontalLayout { alignment: center; Icon { name: root.icon; tint: Theme.faint; size: 44px; stroke-width: 1px; } }
    Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
    if root.text != "": HorizontalLayout {
        alignment: center;
        Text { text: root.text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; max-width: 460px; }
    }
    if root.command != "": HorizontalLayout {
        alignment: center;
        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border2;
            background: Theme.surface;
            width: command.preferred-width;
            height: 46px;
            copy-field := TextInput { visible: false; text: root.command; read-only: true; }
            command := HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 12px;
                Text { text: root.command; color: Theme.text; font-size: 13px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                Button {
                    label: "Copy";
                    button-height: 28px;
                    min-width: self.preferred-width;
                    y: (parent.height - self.height) / 2;
                    clicked => { copy-field.select-all(); copy-field.copy(); root.copied(); }
                }
            }
        }
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        Button { label: root.action; kind: root.command != "" ? "secondary" : "primary"; horizontal-stretch: 0; clicked => { root.action-clicked(); } }
    }
}

/// Above a page that writes Lituus's file to Hyprland's config folder, while Hyprland's own
/// config doesn't load it: `line` is what loads it, with a button to copy it.
export component LoadBanner inherits Rectangle {
    in property <string> line;
    height: banner.preferred-height;
    copy-field := TextInput { visible: false; text: root.line; read-only: true; }
    banner := Banner {
        width: parent.width;
        height: parent.height;
        tone: "warn";
        text: "Your Hyprland config doesn't load Lituus's file yet, so changes are lost when Hyprland restarts.";
        action: "Copy " + root.line;
        dismissible: false;
        action-clicked => { copy-field.select-all(); copy-field.copy(); }
    }
}
