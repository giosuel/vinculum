// The Sound page, following the "Lituus: Sound" mockups: the output in use is the hero, with a
// big volume slider; then devices, apps and cards in tabs. The output and the input in use are
// each chosen from a list, with that device's settings under it. What it shows comes from Rust
// (src/sound.rs); everything the user does goes back through `act(verb, id, value)`.
import { Theme } from "theme.slint";
import { Icon, Spinner } from "icons.slint";
import { Button, IconButton, Switch, CardTitle, Banner, Scroll, Focusable, Focus } from "controls.slint";
import { ViewSwitcher, Select } from "dialogs.slint";
import { Hero, HeroInfo, Card, SettingRow } from "shell.slint";

/// An app playing. output: its output's place in `outputs`.
export struct SoundApp { id: string, name: string, sub: string, volume: float, muted: bool, output: int }
/// A sound card and its profiles.
export struct SoundCard { id: string, name: string, profiles: [string], selected: int }
/// state: "list", "loading" or "not-running" (the empty-* fields say why).
export struct SoundView {
    state: string,
    sub: string,
    hero: HeroInfo,
    /// The output in use: volume (1.0 is 100 %), mute, ports and balance.
    out-volume: float,
    out-muted: bool,
    out-ports: [string],
    out-port: int,
    out-balance: float,
    has-balance: bool,
    /// The outputs: names, a line about each ("Bluetooth · Headphones"), and the one in use
    /// (-1: none). The apps choose from the same names.
    outputs-names: [string],
    outputs-details: [string],
    output: int,
    inputs-names: [string],
    inputs-details: [string],
    input: int,
    in-volume: float,
    in-muted: bool,
    apps: [SoundApp],
    cards: [SoundCard],
    /// The highest volume the sliders go to: 1.0, or 1.5 with "Louder than 100 %" on.
    max: float,
    overamplify: bool,
    /// The last change the server turned down.
    error: string,
    empty-title: string,
    empty-text: string,
    /// A command that fixes it, with a Copy button.
    empty-command: string,
}

/// A volume slider: drags and arrow keys move it; while it's dragged it shows its own value
/// rather than the server's, which lags behind.
export component Slider inherits Focusable {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> big;
    in property <string> label;
    /// A mark across the track, such as 100 % when it goes higher, or the centre of a balance.
    in property <float> mark: -1;
    /// What the arrow keys move it by.
    in property <float> step: 0.05;
    /// Its value for a screen reader, if not a percentage ("300 ms").
    in property <string> value-text;
    callback moved(float);
    property <float> local: value;
    property <bool> dragging: touch.pressed;
    property <float> shown: dragging ? local : value;
    property <length> knob: big ? 22px : 16px;
    property <float> fraction: (clamp(shown, minimum, maximum) - minimum) / (maximum - minimum);
    height: big ? 28px : 20px;
    min-width: 80px;
    opacity: root.enabled ? 1 : 0.5;
    // Round, for the focus ring.
    border-radius: self.height / 2;
    clickable: false;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: root.value-text != "" ? root.value-text : round(shown * 100) + " %";
    accessible-value-minimum: minimum * 100;
    accessible-value-maximum: maximum * 100;
    accessible-action-increment => { root.moved(min(root.maximum, root.value + root.step)); }
    accessible-action-decrement => { root.moved(max(root.minimum, root.value - root.step)); }
    key(event) => {
        // Alt+↑↓ and the like are the page's (moving a keyboard layout).
        if event.modifiers.alt || event.modifiers.control { return reject; }
        if event.text == Key.RightArrow || event.text == Key.UpArrow { root.moved(min(root.maximum, root.value + root.step)); return accept; }
        if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.moved(max(root.minimum, root.value - root.step)); return accept; }
        reject
    }
    track := Rectangle {
        x: root.knob / 2;
        width: parent.width - root.knob;
        height: root.big ? 8px : 4px;
        border-radius: self.height / 2;
        // A control's edge colour, so the track stands out 3:1 from the card.
        background: Theme.ctrl-border;
        if root.minimum >= 0: Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
        if root.mark >= 0: Rectangle {
            x: parent.width * (root.mark - root.minimum) / (root.maximum - root.minimum) - 1px;
            width: 2px;
            height: parent.height + 8px;
            y: -4px;
            background: Theme.faint;
        }
    }
    Rectangle {
        x: track.x + track.width * root.fraction - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.accent;
        border-width: 3px;
        border-color: Theme.surface;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            // A press moves the knob there at once; a drag carries on from it (moved below).
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                // Then the arrow keys move it too; the ring is only for the keyboard.
                Focus.keyboard = false;
                root.focus();
                root.local = root.minimum + clamp((self.mouse-x - track.x) / track.width, 0, 1) * (root.maximum - root.minimum);
                root.moved(root.local);
            }
        }
        moved => {
            if self.pressed {
                root.local = root.minimum + clamp((self.mouse-x - track.x) / track.width, 0, 1) * (root.maximum - root.minimum);
                root.moved(root.local);
            }
        }
    }
}

component Percent inherits Text {
    in property <float> value;
    in property <bool> muted;
    text: muted ? "Muted" : round(value * 100) + " %";
    color: Theme.muted;
    font-size: 12px;
    font-family: "JetBrains Mono";
    horizontal-alignment: right;
    vertical-alignment: center;
    width: 52px;
}

export component SoundPage inherits VerticalLayout {
    in property <SoundView> page;
    in-out property <int> tab;
    /// A short window: a smaller hero.
    in property <bool> compact;
    callback act(string, string, float);
    spacing: 14px;
    Hero {
        title: "Sound";
        sub: root.page.sub;
        // With nothing to show, the hero is only the title and its line.
        hero-height: root.compact || root.page.state == "not-running" ? 136px : 206px;
        compact: root.compact;
        aside: sound-tools.width + 18px;
        if root.page.state == "list": HorizontalLayout {
            x: 24px;
            y: parent.height - self.height - (root.compact ? 16px : 22px);
            width: parent.width - 48px;
            height: root.compact ? 63px : 96px;
            spacing: 20px;
            Rectangle {
                width: root.compact ? 56px : 88px;
                height: self.width;
                y: parent.height - self.height;
                border-radius: self.width / 2;
                background: Theme.accent-soft-bg;
                Icon { name: root.page.hero.icon; tint: Theme.accent; size: parent.width * 0.48; stroke-width: 1.3px; }
            }
            VerticalLayout {
                alignment: end;
                spacing: root.compact ? 4px : 10px;
                padding-bottom: 2px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: root.page.hero.name; color: Theme.text; font-size: 22px; font-weight: 600; overflow: elide; vertical-alignment: bottom; }
                    Text { text: root.page.hero.meta; color: Theme.muted; font-size: 13px; overflow: elide; vertical-alignment: bottom; horizontal-stretch: 1; }
                }
                // The slider stops at 640 px; a longer one gives no finer control.
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    IconButton {
                        icon: root.page.out-muted ? "volume-off" : "volume";
                        label: root.page.out-muted ? "Unmute" : "Mute";
                        clicked => { root.act("out-mute", "", 0); }
                    }
                    Slider {
                        big: true;
                        label: "Output volume";
                        value: root.page.out-volume;
                        maximum: root.page.max;
                        mark: root.page.max > 1 ? 1 : -1;
                        y: (parent.height - self.height) / 2;
                        preferred-width: 640px;
                        horizontal-stretch: 1;
                        moved(v) => { root.act("out-volume", "", v); }
                    }
                    Percent { value: root.page.out-volume; muted: root.page.out-muted; font-size: 14px; color: Theme.text; }
                }
            }
        }
        // The page's views, top right as on every page.
        sound-tools := HorizontalLayout {
            x: parent.width - self.width - 18px;
            y: 18px;
            width: self.preferred-width;
            height: 34px;
            if root.page.state == "list": ViewSwitcher {
                label: "Sound";
                // Cards only when there's a card with profiles to choose.
                options: root.page.cards.length > 0 ? ["Devices", "Apps", "Cards"] : ["Devices", "Apps"];
                selected <=> root.tab;
            }
        }
    }

    // Below the hero, the page scrolls when the window is too short for it. The cards are as
    // tall as what's in them; only the not-running card fills the page.
    Scroll {
        vertical-stretch: 1;
        fill: root.page.state != "list";
        spacing: 14px;
        bar-inset: -16px;
        // What the server turned down, above what it's about.
        if root.page.state == "list" && root.page.error != "": Banner {
            tone: "danger";
            text: root.page.error;
            dismissed => { root.act("dismiss", "", 0); }
        }

        if root.page.state == "list" && (root.tab == 0 || (root.tab > 1 && root.page.cards.length == 0)): HorizontalLayout {
            spacing: 14px;
            Card {
                horizontal-stretch: 1;
                // Setting rows stay at a width where the label is near its control.
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        padding: 18px;
                        padding-top: 14px;
                        spacing: 0;
                        alignment: start;
                        preferred-width: 756px;
                        max-width: 756px;
                        horizontal-stretch: 1;
                        CardTitle { text: "Output"; height: 30px; }
                        if root.page.outputs-names.length == 0: Text { text: "No speakers, headphones or other output."; color: Theme.faint; font-size: 12px; height: 40px; vertical-alignment: center; }
                        if root.page.outputs-names.length > 0: SettingRow {
                            label: "Output device";
                            description: "Where sound plays";
                            first: true;
                            Select {
                                min-width: 140px;
                                preferred-width: 240px;
                                horizontal-stretch: 0;
                                select-height: 34px;
                                label: "Output device";
                                options: root.page.outputs-names;
                                details: root.page.outputs-details;
                                selected: root.page.output;
                                chosen(i) => { root.act("default-sink", "", i); }
                            }
                        }
                        if root.page.out-ports.length > 1: SettingRow {
                            label: "Port";
                            description: "Which of its connectors plays";
                            Select {
                                min-width: 140px;
                                preferred-width: 240px;
                                horizontal-stretch: 0;
                                select-height: 34px;
                                label: "Port";
                                options: root.page.out-ports;
                                selected: root.page.out-port;
                                chosen(i) => { root.act("out-port", "" + i, 0); }
                            }
                        }
                        if root.page.has-balance: SettingRow {
                            label: "Balance";
                            HorizontalLayout {
                                spacing: 14px;
                                horizontal-stretch: 0;
                                Text { text: "L"; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                                Slider {
                                    preferred-width: 180px;
                                    label: "Balance";
                                    minimum: -1;
                                    maximum: 1;
                                    mark: 0;
                                    value: root.page.out-balance;
                                    y: (parent.height - self.height) / 2;
                                    moved(v) => { root.act("balance", "", abs(v) < 0.06 ? 0 : v); }
                                }
                                Text { text: "R"; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                        // It changes every volume slider (the input's and the apps' too), so it
                        // sits with the devices rather than under Cards.
                        SettingRow {
                            label: "Louder than 100 %";
                            description: "Lets the volume sliders go to 150 %; sound may distort";
                            first: root.page.outputs-names.length == 0;
                            Switch { on: root.page.overamplify; label: "Louder than 100 %"; toggled => { root.act("overamplify", "", 0); } }
                        }
                    }
                }
            }
            Card {
                horizontal-stretch: 1;
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        padding: 18px;
                        padding-top: 14px;
                        spacing: 0;
                        alignment: start;
                        preferred-width: 756px;
                        max-width: 756px;
                        horizontal-stretch: 1;
                        CardTitle { text: "Input"; height: 30px; }
                        if root.page.inputs-names.length == 0: Text { text: "No microphone or other input."; color: Theme.faint; font-size: 12px; height: 40px; vertical-alignment: center; }
                        if root.page.inputs-names.length > 0: SettingRow {
                            label: "Input device";
                            description: "What apps hear";
                            first: true;
                            Select {
                                min-width: 140px;
                                preferred-width: 240px;
                                horizontal-stretch: 0;
                                select-height: 34px;
                                label: "Input device";
                                options: root.page.inputs-names;
                                details: root.page.inputs-details;
                                selected: root.page.input;
                                chosen(i) => { root.act("default-source", "", i); }
                            }
                        }
                        // Muted the way the output and the apps are: the button beside its slider.
                        if root.page.inputs-names.length > 0: SettingRow {
                            label: "Volume";
                            description: root.page.in-muted ? "Muted in every app" : "";
                            HorizontalLayout {
                                spacing: 12px;
                                horizontal-stretch: 0;
                                IconButton {
                                    icon: root.page.in-muted ? "mic-off" : "mic";
                                    label: root.page.in-muted ? "Unmute the input" : "Mute the input";
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.act("in-mute", "", 0); }
                                }
                                Slider {
                                    preferred-width: 180px;
                                    label: "Input volume";
                                    value: root.page.in-volume;
                                    maximum: root.page.max;
                                    mark: root.page.max > 1 ? 1 : -1;
                                    y: (parent.height - self.height) / 2;
                                    moved(v) => { root.act("in-volume", "", v); }
                                }
                                Percent { value: root.page.in-volume; muted: root.page.in-muted; }
                            }
                        }
                    }
                }
            }
        }

        if root.page.state == "list" && root.tab == 1: Card {
            HorizontalLayout {
                alignment: start;
                apps := VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 0;
                    alignment: start;
                    preferred-width: 756px;
                    max-width: 756px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        height: 30px;
                        CardTitle { text: "Apps"; horizontal-stretch: 1; }
                        Text { text: root.page.apps.length == 1 ? "1 playing" : root.page.apps.length + " playing"; color: Theme.muted; font-size: 12px; }
                    }
                    if root.page.apps.length == 0: Text { text: "No app is playing sound."; color: Theme.faint; font-size: 13px; height: 48px; vertical-alignment: center; }
                    for a[i] in root.page.apps: HorizontalLayout {
                        min-height: 56px;
                        spacing: 12px;
                        Icon { name: "app"; tint: Theme.muted; size: 17px; y: (parent.height - 17px) / 2; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            width: 200px;
                            Text { text: a.name; color: Theme.text; font-size: 13px; overflow: elide; }
                            if a.sub != "": Text { text: a.sub; color: Theme.faint; font-size: 12px; overflow: elide; }
                        }
                        IconButton {
                            icon: a.muted ? "volume-off" : "volume";
                            label: a.muted ? "Unmute " + a.name : "Mute " + a.name;
                            focus-key: "app-mute:" + a.id;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act("app-mute", a.id, 0); }
                        }
                        Slider {
                            horizontal-stretch: 1;
                            label: a.name + " volume";
                            focus-key: "app-volume:" + a.id;
                            value: a.volume;
                            maximum: root.page.max;
                            mark: root.page.max > 1 ? 1 : -1;
                            y: (parent.height - self.height) / 2;
                            moved(v) => { root.act("app-volume", a.id, v); }
                        }
                        Percent { value: a.volume; muted: a.muted; }
                        Select {
                            width: 190px;
                            select-height: 32px;
                            label: "Output for " + a.name;
                            focus-key: "app-output:" + a.id;
                            options: root.page.outputs-names;
                            details: root.page.outputs-details;
                            selected: a.output;
                            y: (parent.height - self.height) / 2;
                            chosen(i) => { root.act("app-output", a.id, i); }
                        }
                    }
                }
            }
        }

        if root.page.state == "list" && root.tab == 2 && root.page.cards.length > 0: Card {
            HorizontalLayout {
                alignment: start;
                cards := VerticalLayout {
                    padding: 18px;
                    padding-top: 14px;
                    spacing: 0;
                    alignment: start;
                    preferred-width: 756px;
                    max-width: 756px;
                    horizontal-stretch: 1;
                    CardTitle { text: "Sound cards"; height: 30px; }
                    for c[i] in root.page.cards: SettingRow {
                        label: c.name;
                        description: "Profile: which outputs and inputs it offers";
                        first: i == 0;
                        Select {
                            min-width: 160px;
                            preferred-width: 300px;
                            horizontal-stretch: 0;
                            select-height: 34px;
                            label: "Profile for " + c.name;
                            focus-key: "profile:" + c.id;
                            options: c.profiles;
                            selected: c.selected;
                            chosen(p) => { root.act("profile", c.id, p); }
                        }
                    }
                }
            }
        }

        if root.page.state != "list": Card {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 14px;
                padding: 18px;
                if root.page.state == "loading": HorizontalLayout { alignment: center; Spinner { size: 20px; } }
                if root.page.state != "loading": HorizontalLayout { alignment: center; Icon { name: "volume-off"; tint: Theme.faint; size: 44px; stroke-width: 1px; } }
                Text { text: root.page.empty-title; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
                if root.page.empty-text != "": HorizontalLayout {
                    alignment: center;
                    Text { text: root.page.empty-text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; max-width: 460px; }
                }
                if root.page.empty-command != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border2;
                        background: Theme.surface;
                        width: command.preferred-width;
                        height: 46px;
                        copy-field := TextInput { visible: false; text: root.page.empty-command; read-only: true; }
                        command := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text { text: root.page.empty-command; color: Theme.text; font-size: 13px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                            Button {
                                label: "Copy";
                                button-height: 28px;
                                min-width: self.preferred-width;
                                y: (parent.height - self.height) / 2;
                                clicked => { copy-field.select-all(); copy-field.copy(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
