// The Displays page, following the "Displays (Speculum)" and "Hero" mockups: the monitors' layout
// is the hero, the selected monitor's settings are below in tabs, and a bar at the bottom says
// what's applied and saved. What it shows comes from Rust (src/displays.rs).
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, IconButton, Switch, SectionLabel, Scroll, Focusable } from "controls.slint";
import { Segmented, Select, TextField, CheckBox, Modal } from "dialogs.slint";
import { Hero, Card } from "shell.slint";
import { Slider } from "sound.slint";

/// A monitor on the layout, in layout pixels.
/// workspaces: the workspaces bound to it ("1★  2  3"; ★ is the default).
export struct LayoutMonitor { n: int, port: string, name: string, sub: string, x: float, y: float, w: float, h: float, selected: bool, disabled: bool, mirrored: bool, workspaces: string }
/// A workspace and the monitor it opens on: `monitor` is a place in `ws-monitors` (0: any).
/// Where a dragged monitor shows, in layout pixels, and the lines it lines up with: one down at
/// `vx` from `vy1` to `vy2` when `v`, one across at `hy` from `hx1` to `hx2` when `h`.
export struct DragSnap { x: float, y: float, v: bool, vx: float, vy1: float, vy2: float, h: bool, hy: float, hx1: float, hx2: float }
export struct WorkspaceRow { name: string, monitor: int, bound: bool, default: bool, persistent: bool }
export struct ProfileRow { name: string, summary: string, active: bool, auto: bool, exec: string }
/// state: "list", "loading" or "not-running".
export struct DisplaysView {
    state: string,
    sub: string,
    empty-title: string,
    empty-text: string,
    monitors: [LayoutMonitor],
    bounds-x: float,
    bounds-y: float,
    bounds-w: float,
    bounds-h: float,
    logical: string,
    sel-n: int,
    sel-title: string,
    sel-sub: string,
    sel-enabled: bool,
    resolutions: [string],
    resolution: int,
    rates: [string],
    rate: int,
    scale-text: string,
    scale-valid: bool,
    scale-hint: string,
    scale-chips: [string],
    scale-chip: int,
    rotation: int,
    flipped: bool,
    x-text: string,
    y-text: string,
    mirrors: [string],
    mirror: int,
    colour-modes: [string],
    colour-mode: int,
    hdr: bool,
    hdr-capable: bool,
    ten-bit: bool,
    sdr-brightness: float,
    sdr-saturation: float,
    vrr-options: [string],
    vrr: int,
    vrr-capable: bool,
    reserved: [string],
    status: string,
    status-tone: string,
    can-apply: bool,
    can-revert: bool,
    can-save: bool,
    keep-open: bool,
    keep-seconds: int,
    keep-fraction: float,
    not-loaded: bool,
    load-line: string,
    config-path: string,
    config-main: string,
    config-open: bool,
    config-text: string,
    /// "Name monitors by description" is on.
    by-description: bool,
    workspaces: [WorkspaceRow],
    ws-monitors: [string],
    profiles: [ProfileRow],
    /// The profile the monitors show now, if any.
    profile: string,
    switch-hotplug: bool,
}

component Badge inherits Rectangle {
    in property <int> n;
    in property <bool> on;
    in property <length> size: 22px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: on ? Theme.accent : Theme.ctrl-bg;
    border-width: on ? 0 : 1px;
    border-color: Theme.ctrl-border;
    Text { text: root.n; color: root.on ? Theme.on-accent : Theme.muted; font-size: max(11px, round(root.size / 2px) * 1px); font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}

/// The monitors to scale, draggable. A drag moves only the monitor on the screen, lined up with
/// the others' edges as it goes (`snap`, from Rust, which changes nothing); the drop goes to Rust.
component Layout inherits Rectangle {
    in property <DisplaysView> view;
    in property <bool> show-workspaces;
    callback select(int);
    /// A monitor dropped at (x, y), in layout pixels.
    callback drop(int, float, float);
    /// Where a monitor dragged to (x, y) shows: lined up with another's edge within `threshold`
    /// layout pixels, unless `free` (Shift is down).
    pure callback snap(int, float, float, float, bool) -> DragSnap;
    in property <length> margin: 18px;
    property <length> gap: 6px;
    // The layout's bounds; after a drop that changes them, the monitors glide to where they now
    // are instead of jumping. Nothing changes them during a drag (Rust hears only of the drop).
    property <float> bx: view.bounds-x;
    property <float> by: view.bounds-y;
    property <float> bw: max(1, view.bounds-w);
    property <float> bh: max(1, view.bounds-h);
    animate bx, by, bw, bh { duration: 200ms; easing: ease-out; }
    // Layout pixels to screen.
    property <float> k: min((self.width - 2 * margin) / 1px / bw, (self.height - 2 * margin) / 1px / bh);
    property <length> ox: (self.width - bw * k * 1px) / 2;
    property <length> oy: (self.height - bh * k * 1px) / 2;
    // How far a press moves before it drags, and how close an edge snaps, on the screen.
    property <length> dead-zone: 4px;
    property <length> snap-distance: 10px;
    // The monitor being dragged (-1: none), where it shows, and the point of it that was grabbed,
    // in layout pixels.
    property <int> dragging: -1;
    property <DragSnap> at;
    property <float> grab-x;
    property <float> grab-y;
    // Between the screen (on whole pixels, so borders and text stay sharp) and layout pixels.
    pure function to-x(v: float) -> length { round((root.ox + (v - root.bx) * root.k * 1px) / 1px) * 1px }
    pure function to-y(v: float) -> length { round((root.oy + (v - root.by) * root.k * 1px) / 1px) * 1px }
    pure function from-x(p: length) -> float { (p - root.ox) / 1px / root.k + root.bx }
    pure function from-y(p: length) -> float { (p - root.oy) / 1px / root.k + root.by }
    // Space or Enter selects one; dragging stays a mouse thing.
    for m[i] in root.view.monitors: tile := Focusable {
        property <bool> dragged: root.dragging == i;
        property <bool> movable: !m.disabled && !m.mirrored;
        property <float> mx: dragged ? root.at.x : m.x;
        property <float> my: dragged ? root.at.y : m.y;
        // A gap between monitors that touch.
        property <length> left: root.to-x(mx);
        property <length> top: root.to-y(my);
        property <length> right: root.to-x(mx + m.w);
        property <length> bottom: root.to-y(my + m.h);
        // The text is the same size on every tile, as on a diagram; a tile too small for it makes
        // it smaller, and drops the lines that don't fit; the number and the port stay.
        property <float> scale: min(self.width / 150px, self.height / 80px);
        property <float> f: clamp(scale, 0.8, 1);
        property <length> pad: clamp(round(10 * scale) * 1px, 4px, 12px);
        property <length> badge: round(18 * f) * 1px;
        property <length> line: 2px;
        property <length> port-size: round(11 * f) * 1px;
        property <length> name-size: round(13 * f) * 1px;
        property <length> sub-size: round(12 * f) * 1px;
        property <bool> show-name: self.height >= 2 * pad + badge + line + 1.3 * name-size;
        property <bool> show-sub: show-name && self.height >= 2 * pad + badge + 2 * line + 1.3 * (name-size + sub-size);
        x: left + root.gap / 2;
        y: top + root.gap / 2;
        z: dragged ? 1 : 0;
        width: right - left - root.gap;
        height: bottom - top - root.gap;
        border-radius: 8px;
        border-width: m.selected ? 2px : 1px;
        border-color: m.selected ? Theme.accent : Theme.ctrl-border;
        background: m.selected ? Theme.accent-soft-bg : Theme.ctrl-bg;
        opacity: m.disabled || m.mirrored ? 0.55 : 1;
        clip: true;
        focus-key: "monitor:" + m.port;
        clickable: false;
        // Inside its border, which the clip would cut a ring outside of, and which is already
        // the accent colour when it's selected.
        ring-gap: -5px;
        accessible-role: button;
        accessible-label: m.port + ", " + m.name + ", " + m.sub;
        accessible-action-default => { root.select(i); }
        activated => { root.select(i); }
        VerticalLayout {
            padding: tile.pad;
            spacing: tile.line;
            HorizontalLayout {
                spacing: round(6 * tile.f) * 1px;
                Badge { n: m.n; on: m.selected; size: tile.badge; }
                Text { text: m.port; color: m.selected ? Theme.accent : Theme.muted; font-size: tile.port-size; font-family: "JetBrains Mono"; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            }
            Rectangle { vertical-stretch: 1; }
            if tile.show-name: Text { text: m.name; color: Theme.text; font-size: tile.name-size; font-weight: 600; overflow: elide; }
            if tile.show-sub && !root.show-workspaces: Text { text: m.sub; color: Theme.muted; font-size: tile.sub-size; overflow: elide; }
            if tile.show-sub && root.show-workspaces: Text { text: m.workspaces == "" ? "No workspaces bound" : m.workspaces; color: m.workspaces == "" ? Theme.faint : Theme.accent; font-size: tile.sub-size; font-family: "JetBrains Mono"; overflow: elide; }
        }
        TouchArea {
            mouse-cursor: tile.movable ? move : pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left && !m.selected {
                    root.select(i);
                }
                // A press becomes a drag once it has moved a little, so a click only selects.
                if event.kind == PointerEventKind.move && self.pressed && tile.movable && !tile.dragged
                    && (abs(self.mouse-x - self.pressed-x) > root.dead-zone || abs(self.mouse-y - self.pressed-y) > root.dead-zone) {
                    root.grab-x = root.from-x(tile.x + self.pressed-x) - m.x;
                    root.grab-y = root.from-y(tile.y + self.pressed-y) - m.y;
                    root.at = { x: m.x, y: m.y };
                    root.dragging = i;
                }
                if event.kind == PointerEventKind.move && tile.dragged {
                    // The pointer, from the tile where it is now (it moves with the pointer), and
                    // the tile kept inside the layout.
                    root.at = root.snap(i,
                        clamp(root.from-x(tile.x + self.mouse-x) - root.grab-x, root.from-x(0px), root.from-x(root.width) - m.w),
                        clamp(root.from-y(tile.y + self.mouse-y) - root.grab-y, root.from-y(0px), root.from-y(root.height) - m.h),
                        root.snap-distance / 1px / root.k, event.modifiers.shift);
                }
                if event.kind == PointerEventKind.up && tile.dragged {
                    root.drop(i, root.at.x, root.at.y);
                    root.dragging = -1;
                }
                if event.kind == PointerEventKind.cancel {
                    root.dragging = -1;
                }
            }
        }
    }
    // The edges or centres a dragged monitor lines up with, a little past both monitors.
    if root.dragging >= 0 && root.at.v: Rectangle {
        x: root.to-x(root.at.vx);
        y: root.to-y(root.at.vy1) - 8px;
        z: 2;
        width: 1px;
        height: root.to-y(root.at.vy2) - root.to-y(root.at.vy1) + 16px;
        background: Theme.accent;
    }
    if root.dragging >= 0 && root.at.h: Rectangle {
        x: root.to-x(root.at.hx1) - 8px;
        y: root.to-y(root.at.hy);
        z: 2;
        width: root.to-x(root.at.hx2) - root.to-x(root.at.hx1) + 16px;
        height: 1px;
        background: Theme.accent;
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> bad;
    spacing: 6px;
    alignment: start;
    Text { text: root.label; color: Theme.muted; font-size: 12px; }
    @children
    if root.hint != "": Text { text: root.hint; color: root.bad ? Theme.danger : Theme.faint; font-size: 12px; wrap: word-wrap; }
}

export component DisplaysPage inherits VerticalLayout {
    in property <DisplaysView> view;
    in-out property <int> tab;
    /// Monitor, Workspaces or Profiles.
    in-out property <int> page-tab;
    /// A short window: a smaller layout, so the settings and the bar under them still fit.
    in property <bool> compact;
    in property <length> window-height;
    property <string> new-profile;
    callback act(string, string, float);
    callback drop(int, float, float);
    pure callback snap(int, float, float, float, bool) -> DragSnap;
    spacing: 14px;

    if root.view.not-loaded && root.view.state == "list": Rectangle {
        height: banner.preferred-height;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.warn-border;
        background: Theme.warn-bg;
        copy-field := TextInput { visible: false; text: root.view.load-line; read-only: true; }
        banner := HorizontalLayout {
            padding: 6px;
            padding-left: 14px;
            spacing: 10px;
            // Centred by a layout: a `y` here put the icon at the top when the text is one line.
            VerticalLayout { alignment: center; Icon { name: "warning"; tint: Theme.warn-text; } }
            Text {
                text: "Your Hyprland config doesn't load Lituus's file yet, so changes are lost when Hyprland restarts.";
                color: Theme.warn-text;
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    label: "Copy " + root.view.load-line;
                    button-height: 30px;
                    min-width: self.preferred-width;
                    horizontal-stretch: 0;
                    clicked => { copy-field.select-all(); copy-field.copy(); }
                }
            }
        }
    }

    // On the Monitor tab the hero (with the monitors) takes what the window's height leaves the
    // settings, up to 720 px, the same on each of the settings' tabs, so the monitors don't
    // change size with them. Workspaces and Profiles keep it at its smallest: their lists need
    // the room.
    hero-box := Rectangle {
        // Smaller in a shorter window, down to where the monitors are still readable, and the
        // settings scroll; the banner takes its height from the hero's, so the settings keep theirs.
        property <length> smallest: root.view.state != "list" ? 140px : clamp(root.window-height - 400px, 236px, 330px) - (root.view.not-loaded ? 44px : 0);
        property <bool> grows: root.view.state == "list" && root.page-tab == 0;
        property <length> tall: grows ? clamp(root.window-height - 396px - (root.view.not-loaded ? 44px : 0), smallest, 720px) : smallest;
        min-height: smallest;
        preferred-height: tall;
        max-height: tall;
        vertical-stretch: 0;
        Hero {
            title: "Displays";
            sub: root.view.sub;
            hero-height: hero-box.height;
            compact: root.compact;
            aside: display-tools.width + 18px;
            if root.view.state == "list": Layout {
                x: 20px;
                y: root.compact ? 54px : 76px;
                width: parent.width - 40px;
                height: parent.height - self.y - (root.compact ? 22px : 28px);
                margin: root.compact ? 8px : 18px;
                view: root.view;
                show-workspaces: root.page-tab == 1;
                select(i) => { root.act("select", "" + i, 0); }
                drop(i, x, y) => { root.drop(i, x, y); }
                snap(i, x, y, threshold, free) => { return root.snap(i, x, y, threshold, free); }
            }
            if root.view.state == "list": Text {
                x: 24px;
                y: parent.height - 24px;
                text: root.view.logical;
                color: Theme.faint;
                font-size: 12px;
            }
            display-tools := HorizontalLayout {
                x: parent.width - self.width - 18px;
                y: 18px;
                width: self.preferred-width;
                height: 36px;
                spacing: 8px;
                if root.view.state == "list": Segmented {
                    label: "Displays";
                    height: 36px;
                    options: ["Monitor", "Workspaces", "Profiles"];
                    selected <=> root.page-tab;
                }
                if root.view.state == "list": Button { label: "View config"; button-height: 36px; clicked => { root.act("view-config", "", 0); } }
            }
        }
    }

    // The settings scroll in a short window; the bar with Apply stays below them.
    if root.view.state == "list": Scroll {
        // What the hero leaves; shorter than the settings, it scrolls.
        vertical-stretch: 1;
        fill: true;
        spacing: 14px;
        bar-inset: -16px;
        if root.page-tab == 1: Card {
            vertical-stretch: 1;
            ws-list := VerticalLayout {
                padding: 18px;
                padding-top: 12px;
                spacing: 0;
                alignment: start;
                HorizontalLayout {
                    height: 30px;
                    spacing: 14px;
                    Text { text: "Workspace"; color: Theme.faint; font-size: 12px; width: 80px; vertical-alignment: center; }
                    Text { text: "Opens on"; color: Theme.faint; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: "Shown when the monitor turns on"; color: Theme.faint; font-size: 12px; width: 220px; vertical-alignment: center; }
                    Text { text: "Kept when empty"; color: Theme.faint; font-size: 12px; width: 120px; vertical-alignment: center; }
                }
                for w[i] in root.view.workspaces: HorizontalLayout {
                    height: 44px;
                    spacing: 14px;
                    Text { text: w.name; color: Theme.text; font-size: 14px; font-weight: 600; font-family: "JetBrains Mono"; width: 80px; vertical-alignment: center; }
                    Select {
                        horizontal-stretch: 1;
                        select-height: 32px;
                        label: "Monitor for workspace " + w.name;
                        focus-key: "ws-monitor:" + i;
                        options: root.view.ws-monitors;
                        selected: w.monitor;
                        y: (parent.height - self.height) / 2;
                        chosen(c) => { root.act("ws-monitor", "" + i, c); }
                    }
                    HorizontalLayout {
                        width: 220px;
                        Switch { on: w.default; label: "Default for its monitor"; focus-key: "ws-default:" + i; opacity: w.bound ? 1 : 0.4; y: (parent.height - self.height) / 2; toggled => { root.act("ws-default", "" + i, 0); } }
                    }
                    HorizontalLayout {
                        width: 120px;
                        Switch { on: w.persistent; label: "Kept when empty"; focus-key: "ws-persistent:" + i; opacity: w.bound ? 1 : 0.4; y: (parent.height - self.height) / 2; toggled => { root.act("ws-persistent", "" + i, 0); } }
                    }
                }
            }
        }

        if root.page-tab == 2: Card {
            vertical-stretch: 1;
            profile-list := VerticalLayout {
                padding: 18px;
                padding-top: 12px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "Switch when monitors are plugged in or out"; color: Theme.text; font-size: 13px; }
                        Text { text: "To the profile made for exactly the monitors plugged in, if it switches by itself. Lituus must be running (in the tray, or with --background)."; color: Theme.faint; font-size: 12px; wrap: word-wrap; }
                    }
                    Switch { on: root.view.switch-hotplug; label: "Switch profiles on hotplug"; switch-width: 40px; y: (parent.height - self.height) / 2; toggled => { root.act("switch-hotplug", "", 0); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.view.profiles.length == 0: Text { text: "No profiles yet. Save the layout you have now as one."; color: Theme.faint; font-size: 13px; height: 32px; vertical-alignment: center; }
                for p[i] in root.view.profiles: Rectangle {
                    height: prow.preferred-height;
                    border-radius: 10px;
                    background: p.active ? Theme.accent-soft-bg : transparent;
                    prow := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: p.name; color: Theme.text; font-size: 14px; font-weight: 600; }
                                    if p.active: Text { text: "In use"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
                                }
                                Text { text: p.summary; color: Theme.faint; font-size: 12px; }
                            }
                            Text { text: "By itself"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                            Switch { on: p.auto; label: "Switch to " + p.name + " by itself"; focus-key: "profile-auto:" + i; y: (parent.height - self.height) / 2; toggled => { root.act("profile-auto", "" + i, 0); } }
                            Button { label: "Use"; focus-key: "profile-use:" + i; button-height: 30px; horizontal-stretch: 0; enabled: !p.active; y: (parent.height - self.height) / 2; clicked => { root.act("profile-use", "" + i, 0); } }
                            Button { label: "Update"; focus-key: "profile-update:" + i; button-height: 30px; horizontal-stretch: 0; y: (parent.height - self.height) / 2; clicked => { root.act("profile-update", "" + i, 0); } }
                            Button { label: "Delete"; kind: "danger"; focus-key: "profile-delete:" + i; button-height: 30px; horizontal-stretch: 0; y: (parent.height - self.height) / 2; clicked => { root.act("profile-delete", "" + i, 0); } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Run after switching"; color: Theme.faint; font-size: 12px; vertical-alignment: center; width: 140px; }
                            TextField { text: p.exec; mono: true; placeholder: "e.g. pkill -SIGUSR2 waybar"; label: "Run after switching to " + p.name; height: 32px; accepted => { root.act("profile-exec", i + ":" + self.text, 0); } }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 10px;
                    TextField { text <=> root.new-profile; placeholder: "Name, e.g. Desk + TV"; label: "New profile's name"; height: 34px; accepted => { root.act("profile-save", root.new-profile, 0); root.new-profile = ""; } }
                    Button { label: "Save the current layout as a profile"; button-height: 34px; horizontal-stretch: 0; enabled: root.new-profile != ""; clicked => { root.act("profile-save", root.new-profile, 0); root.new-profile = ""; } }
                }
            }
        }

        if root.page-tab == 0: Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 18px;
                padding-top: 14px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Badge { n: root.view.sel-n; on: true; y: (parent.height - self.height) / 2; }
                    VerticalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;
                        Text { text: root.view.sel-title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                        Text { text: root.view.sel-sub; color: Theme.faint; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
                    }
                    Segmented {
                        label: "Monitor settings";
                        horizontal-stretch: 0;
                        options: ["Display", "Colour and HDR", "Advanced"];
                        selected <=> root.tab;
                    }
                    Text { text: "Enabled"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                    Switch { on: root.view.sel-enabled; label: "Enabled"; switch-width: 40px; y: (parent.height - self.height) / 2; toggled => { root.act("enabled", "", 0); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.tab == 0: GridLayout {
                    spacing-horizontal: 22px;
                    spacing-vertical: 14px;
                    Field {
                        label: "Resolution";
                        Select { options: root.view.resolutions; selected: root.view.resolution; label: "Resolution"; select-height: 34px; chosen(i) => { root.act("resolution", "" + i, 0); } }
                    }
                    Field {
                        label: "Refresh rate";
                        Select { options: root.view.rates; selected: root.view.rate; label: "Refresh rate"; select-height: 34px; chosen(i) => { root.act("rate", "" + i, 0); } }
                    }
                    Field {
                        label: "Scale";
                        hint: root.view.scale-hint;
                        bad: !root.view.scale-valid;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            IconButton { icon: "minus"; label: "Smaller scale"; width: 34px; height: 34px; clicked => { root.act("scale-step", "", -1); } }
                            Rectangle {
                                width: 52px;
                                height: 34px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.view.scale-valid ? Theme.ctrl-border : Theme.danger;
                                Text { text: root.view.scale-text; color: Theme.text; font-size: 13px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            IconButton { icon: "plus"; label: "Larger scale"; width: 34px; height: 34px; clicked => { root.act("scale-step", "", 1); } }
                            for c[k] in root.view.scale-chips: Focusable {
                                width: chip.preferred-width + 18px;
                                focus-key: "scale:" + c;
                                height: 26px;
                                y: 4px;
                                border-radius: 13px;
                                border-width: 1px;
                                border-color: k == root.view.scale-chip ? Theme.accent-soft-border : Theme.ctrl-border;
                                background: k == root.view.scale-chip ? Theme.accent-soft-bg : transparent;
                                accessible-role: button;
                                accessible-label: "Scale " + c;
                                accessible-action-default => { root.act("scale", "", c.to-float()); }
                                activated => { root.act("scale", "", c.to-float()); }
                                chip := Text { text: c; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Field {
                        row: 1;
                        label: "Rotation";
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Segmented {
                                label: "Rotation";
                                height: 34px;
                                options: ["0°", "90°", "180°", "270°"];
                                selected: root.view.rotation;
                                changed(i) => { root.act("rotation", "" + i, 0); }
                            }
                            CheckBox { checked: root.view.flipped; text: "Flip"; y: (parent.height - self.height) / 2; toggled(on) => { root.act("flip", "", 0); } }
                        }
                    }
                    Field {
                        label: "Position";
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "X"; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                            TextField { text: root.view.x-text; mono: true; label: "X"; height: 34px; accepted => { root.act("x", self.text, 0); } }
                            Text { text: "Y"; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
                            TextField { text: root.view.y-text; mono: true; label: "Y"; height: 34px; accepted => { root.act("y", self.text, 0); } }
                        }
                    }
                    Field {
                        label: "Mirror";
                        Select { options: root.view.mirrors; selected: root.view.mirror; label: "Mirror"; select-height: 34px; chosen(i) => { root.act("mirror", "" + i, 0); } }
                    }
                }
                if root.tab == 1: GridLayout {
                    spacing-horizontal: 22px;
                    spacing-vertical: 14px;
                    Field {
                        label: "Colour mode";
                        hint: root.view.hdr-capable ? "HDR needs a monitor and apps that support it." : "This monitor doesn't say it supports HDR.";
                        Select { options: root.view.colour-modes; selected: root.view.colour-mode; label: "Colour mode"; select-height: 34px; chosen(i) => { root.act("colour", "" + i, 0); } }
                    }
                    Field {
                        label: "Bit depth";
                        hint: "Some apps can't share a 10-bit screen.";
                        HorizontalLayout {
                            alignment: start;
                            Segmented { label: "Bit depth"; height: 34px; options: ["8-bit", "10-bit"]; selected: root.view.ten-bit ? 1 : 0; changed(i) => { root.act("bitdepth", "" + i, 0); } }
                        }
                    }
                    Rectangle { }
                    Field {
                        row: 1;
                        label: "SDR brightness in HDR";
                        hint: root.view.hdr ? "1.0 to 2.0 is typical." : "Only in HDR.";
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { label: "SDR brightness"; minimum: 0.5; maximum: 2.5; value: root.view.sdr-brightness; enabled: root.view.hdr; y: (parent.height - self.height) / 2; moved(v) => { root.act("sdr-brightness", "", v); } }
                            Text { text: round(root.view.sdr-brightness * 100) / 100; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; width: 36px; vertical-alignment: center; }
                        }
                    }
                    Field {
                        label: "SDR saturation in HDR";
                        hint: root.view.hdr ? "1.0 keeps colours as they are." : "Only in HDR.";
                        HorizontalLayout {
                            spacing: 10px;
                            Slider { label: "SDR saturation"; minimum: 0.5; maximum: 1.5; value: root.view.sdr-saturation; enabled: root.view.hdr; y: (parent.height - self.height) / 2; moved(v) => { root.act("sdr-saturation", "", v); } }
                            Text { text: round(root.view.sdr-saturation * 100) / 100; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; width: 36px; vertical-alignment: center; }
                        }
                    }
                }
                if root.tab == 2: GridLayout {
                    spacing-horizontal: 22px;
                    spacing-vertical: 14px;
                    Field {
                        label: "Variable refresh rate";
                        hint: root.view.vrr-capable ? "Off, on, or only for fullscreen apps." : "This monitor doesn't say it supports VRR.";
                        Select { options: root.view.vrr-options; selected: root.view.vrr; label: "Variable refresh rate"; select-height: 34px; chosen(i) => { root.act("vrr", "" + i, 0); } }
                    }
                    Field {
                        label: "Reserved area";
                        hint: "Space tiled windows keep free, besides bars: top, right, bottom, left.";
                        HorizontalLayout {
                            spacing: 6px;
                            for r[k] in root.view.reserved: TextField { text: r; mono: true; label: "Reserved " + k; height: 34px; accepted => { root.act("reserved", k + ":" + self.text, 0); } }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    if root.view.state == "list": HorizontalLayout {
        height: 34px;
        spacing: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: 4px;
            background: root.view.status-tone == "danger" ? Theme.danger : root.view.status-tone == "warn" ? Theme.warn-text : root.view.status-tone == "accent" ? Theme.accent : Theme.faint;
        }
        Text { text: root.view.status; color: root.view.status-tone == "danger" ? Theme.danger : Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.view.can-save: Button { label: "Save to config file"; button-height: 34px; horizontal-stretch: 0; min-width: 84px; clicked => { root.act("save", "", 0); } }
        Button { label: "Revert"; button-height: 34px; horizontal-stretch: 0; min-width: 84px; enabled: root.view.can-revert; clicked => { root.act("revert", "", 0); } }
        Button { label: "Apply"; kind: "primary"; button-height: 34px; horizontal-stretch: 0; min-width: 96px; enabled: root.view.can-apply; clicked => { root.act("apply", "", 0); } }
    }

    if root.view.state != "list": Card {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout { alignment: center; Icon { name: "monitor"; tint: Theme.faint; size: 44px; stroke-width: 1px; } }
            Text { text: root.view.empty-title; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
            Text { text: root.view.empty-text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}

/// After Apply: keep the new settings, or they go back by themselves. Esc goes back now.
export component KeepDialog inherits Modal {
    in property <DisplaysView> view;
    callback keep();
    callback revert();
    label: "Keep these display settings?";
    dismissed => { root.revert(); }
    Text { text: "Keep these display settings?"; color: Theme.text; font-size: 17px; font-weight: 600; }
    Text { text: "If a screen stays black, do nothing: the old settings come back by themselves."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.off-track;
        Rectangle { x: 0; width: parent.width * root.view.keep-fraction; border-radius: 3px; background: Theme.accent; }
    }
    Text { text: "Going back in " + root.view.keep-seconds + " s"; color: Theme.muted; font-size: 12px; }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button { label: "Go back now"; button-height: 36px; clicked => { root.revert(); } }
        Button { label: "Keep"; kind: "primary"; button-height: 36px; clicked => { root.keep(); } }
    }
}

/// The file Lituus writes, to look at and copy.
export component ConfigDialog inherits Modal {
    in property <DisplaysView> view;
    callback closed();
    callback name-by-description();
    card-width: min(self.width - 80px, 820px);
    card-spacing: 12px;
    label: "Config file";
    backdrop-dismisses: true;
    dismissed => { root.closed(); }
    Text { text: "Config file"; color: Theme.text; font-size: 17px; font-weight: 600; }
    Text { text: root.view.config-path + ", with the changes not applied yet"; color: Theme.muted; font-size: 12px; font-family: "JetBrains Mono"; }
    Rectangle {
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.input-bg;
        height: min(code.preferred-height + 24px, 360px);
        Flickable {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            viewport-width: max(self.width, code.preferred-width);
            viewport-height: code.preferred-height;
            code := TextInput { text: root.view.config-text; read-only: true; color: Theme.text; font-size: 12px; font-family: "JetBrains Mono"; wrap: no-wrap; }
        }
    }
    // Like nwg-displays' "Use desc:". The text above shows the change at once; the file changes
    // with "Save to config file".
    VerticalLayout {
        spacing: 4px;
        CheckBox { checked: root.view.by-description; text: "Name monitors by description"; toggled(on) => { root.name-by-description(); } }
        HorizontalLayout {
            padding-left: 28px;
            Text {
                text: "By make, model and serial, so a monitor keeps its settings on another port. Off: by port, such as DP-1.";
                color: Theme.faint;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button { label: "Copy"; button-height: 36px; clicked => { code.select-all(); code.copy(); } }
        Button { label: "Close"; kind: "primary"; button-height: 36px; clicked => { root.closed(); } }
    }
}
