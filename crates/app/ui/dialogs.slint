// The form controls and the password dialog, styled like the mockups (Password, Hidden network).
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button } from "controls.slint";

component FieldLabel inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
}

/// A one-line text field; with `password`, the text is hidden and an eye button shows it.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <bool> password;
    in property <string> label;
    in property <bool> autofocus;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> invalid;
    in property <bool> enabled: true;
    property <bool> shown;
    callback accepted();
    callback edited();
    init => { if root.autofocus { input.focus(); input.select-all(); } }
    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.invalid ? Theme.danger : input.has-focus ? Theme.accent : Theme.border2;
    opacity: root.enabled ? 1 : 0.5;
    background: Theme.input-bg;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            // A long path scrolls inside the field instead of running past its edge.
            clip: true;
            input := TextInput {
                text <=> root.text;
                width: parent.width;
                height: parent.height;
                input-type: root.password && !root.shown ? InputType.password : InputType.text;
                color: Theme.text;
                font-size: root.mono ? 13px : 14px;
                font-family: root.mono ? "JetBrains Mono" : "Inter";
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                accessible-label: root.label;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
            if input.text == "" && root.placeholder != "": Text {
                text: root.placeholder;
                color: Theme.faint;
                font-size: input.font-size;
                font-family: input.font-family;
                vertical-alignment: center;
                x: 0;
                height: parent.height;
            }
        }
        if root.password: Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: eye.has-hover ? Theme.sel-bg : transparent;
            accessible-role: button;
            accessible-label: root.shown ? "Hide password" : "Show password";
            accessible-action-default => { root.shown = !root.shown; }
            Icon { name: root.shown ? "eye-off" : "eye"; tint: Theme.icon-soft; }
            eye := TouchArea { mouse-cursor: pointer; clicked => { root.shown = !root.shown; } }
        }
    }
}

/// A row of mutually exclusive choices ("For me only", "All users", "Ask each time").
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> selected;
    /// Also called when the user picks one (for a choice that isn't bound two-way).
    callback changed(int);
    height: 40px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border2;
    accessible-role: tab-list;
    accessible-label: label;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            min-width: label.preferred-width + 24px;
            border-radius: 7px;
            border-width: i == root.selected ? 1px : 0;
            border-color: Theme.accent-soft-border;
            background: i == root.selected ? Theme.accent-soft-bg : touch.has-hover ? Theme.sel-bg : transparent;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.selected;
            accessible-action-default => { root.selected = i; root.changed(i); }
            label := Text {
                text: option;
                color: i == root.selected ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: i == root.selected ? 500 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; root.changed(i); } }
        }
    }
}

export component CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled(bool);
    height: 24px;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checked: checked;
    accessible-action-default => { checked = !checked; toggled(checked); }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: root.checked ? 0 : 1.5px;
            border-color: Theme.ctrl-border;
            background: root.checked ? Theme.accent : transparent;
            if root.checked: Icon { name: "check"; tint: Theme.on-accent; size: 14px; stroke-width: 2px; }
        }
        Text { text: root.text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

/// A drop-down list.
export component Select inherits Rectangle {
    in property <[string]> options;
    /// A second, smaller line under each option, if given.
    in property <[string]> details;
    in property <string> label;
    in-out property <int> selected;
    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border2;
    background: touch.has-hover ? Theme.sel-bg : Theme.input-bg;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: root.options[root.selected];
    accessible-action-default => { popup.show(); }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        Text { text: root.options[root.selected]; color: Theme.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Icon { name: "chevron"; tint: Theme.icon-soft; y: (parent.height - 16px) / 2; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.ctrl-border;
            background: Theme.surface;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: root.details.length > i ? 44px : 32px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.sel-bg : i == root.selected ? Theme.accent-soft-bg : transparent;
                    VerticalLayout {
                        padding-left: 10px;
                        alignment: center;
                        Text { text: option; color: Theme.text; font-size: 13px; }
                        if root.details.length > i: Text { text: root.details[i]; color: Theme.muted; font-size: 11px; }
                    }
                    item := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; } }
                }
            }
        }
    }
}

/// The password dialog. `mode` is "new" (joining a network, with the storage choice), "hidden"
/// (the network's name and security too) or "prompt" (NetworkManager asking, password only).
export component JoinDialog inherits Rectangle {
    in property <string> mode: "new";
    in property <string> title;
    in property <string> subtitle;
    /// Shown in red under the password: a rejected password, say.
    in property <string> error;
    in property <[string]> securities;
    /// Under the password field, by security ("8 to 63 characters").
    in property <[string]> password-hints;
    in property <[string]> storage-hints;
    in property <bool> valid;
    in-out property <string> name;
    in-out property <int> security;
    in-out property <string> password;
    in-out property <int> storage;
    in-out property <bool> autoconnect;
    callback accepted();
    callback cancelled();
    // Open networks (a hidden one with "None") need no password.
    property <bool> needs-password: root.mode != "hidden" || root.security != 0;

    background: #05060799;
    TouchArea { clicked => { root.cancelled(); } }
    Rectangle {
        width: 440px;
        height: form.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.ctrl-border;
        background: Theme.surface;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000080;
        accessible-role: groupbox;
        accessible-label: root.title;
        TouchArea {}
        form := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 14px;
                if root.mode != "hidden": Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.accent-soft-bg;
                    Icon { name: "lock"; tint: Theme.accent; size: 18px; }
                }
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                    Text { text: root.subtitle; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                }
            }
            if root.mode == "hidden": VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "Network name"; }
                TextField { text <=> root.name; label: "Network name"; autofocus: true; accepted => { if root.valid { root.accepted(); } } }
            }
            if root.mode == "hidden": VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "Security"; }
                Select { options: root.securities; selected <=> root.security; label: "Security"; }
            }
            if root.needs-password: VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "Password"; }
                TextField {
                    text <=> root.password;
                    password: true;
                    autofocus: root.mode != "hidden";
                    label: "Password";
                    accepted => { if root.valid { root.accepted(); } }
                }
                if root.error != "": Text { text: root.error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                if root.error == "" && root.password-hints[root.security] != "": Text {
                    text: root.password-hints[root.security];
                    color: Theme.faint;
                    font-size: 12px;
                }
            }
            if root.mode != "prompt" && root.needs-password: VerticalLayout {
                spacing: 8px;
                FieldLabel { text: "Remember the password"; }
                Segmented { options: ["For me only", "All users", "Ask each time"]; selected <=> root.storage; label: "Remember the password"; }
                Text { text: root.storage-hints[root.storage]; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            }
            if root.mode != "prompt": CheckBox { checked <=> root.autoconnect; text: "Connect automatically when in range"; }
            HorizontalLayout {
                padding-top: 4px;
                spacing: 8px;
                alignment: end;
                Button { label: "Cancel"; button-height: 36px; clicked => { root.cancelled(); } }
                Button { label: "Connect"; kind: "primary"; button-height: 36px; enabled: root.valid; clicked => { root.accepted(); } }
            }
        }
    }
}
