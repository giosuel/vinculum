// The form controls, the dialog frame every dialog uses, and the password dialog, styled like the
// mockups (Password, Hidden network).
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, IconButton, FieldLabel, Focusable, Focus, FocusTrap } from "controls.slint";

/// A one-line text field; with `password`, the text is hidden and an eye button shows it.
/// `committed` is for a field whose value takes effect by itself (not one with a dialog's
/// button): Enter, or the focus leaving the field after an edit.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <bool> password;
    in property <string> label;
    in property <bool> autofocus;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> invalid;
    in property <bool> enabled: true;
    property <bool> shown;
    callback accepted();
    callback edited();
    callback committed();
    // Edited since the last commit.
    property <bool> typed;
    property <bool> focused: input.has-focus;
    changed focused => {
        if !self.focused && self.typed {
            self.typed = false;
            root.committed();
        }
    }
    init => { if root.autofocus { input.focus(); input.select-all(); } }
    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.invalid ? Theme.danger : input.has-focus ? Theme.accent : Theme.ctrl-border;
    // Also what keeps it inlined in each dialog, so that the dialog's init runs before a field's
    // `autofocus` (and the dialog doesn't take the keyboard back from it).
    opacity: root.enabled ? 1 : 0.5;
    background: Theme.input-bg;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            // A long path scrolls inside the field instead of running past its edge.
            clip: true;
            input := TextInput {
                text <=> root.text;
                width: parent.width;
                height: parent.height;
                input-type: root.password && !root.shown ? InputType.password : InputType.text;
                color: Theme.text;
                font-size: root.mono ? 13px : 14px;
                font-family: root.mono ? "JetBrains Mono" : "Inter";
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                accessible-label: root.label;
                accepted => {
                    root.typed = false;
                    root.accepted();
                    root.committed();
                }
                edited => {
                    root.typed = true;
                    root.edited();
                }
            }
            if input.text == "" && root.placeholder != "": Text {
                text: root.placeholder;
                color: Theme.faint;
                font-size: input.font-size;
                font-family: input.font-family;
                vertical-alignment: center;
                x: 0;
                height: parent.height;
            }
        }
        if root.password: IconButton {
            icon: root.shown ? "eye-off" : "eye";
            label: root.shown ? "Hide password" : "Show password";
            flat: true;
            size: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.shown = !root.shown; }
        }
    }
}

/// A row of mutually exclusive choices, a value ("For me only", "All users", "Ask each time");
/// the views of a page are a ViewSwitcher. One stop for Tab; the arrow keys move the choice.
export component Segmented inherits Focusable {
    in property <[string]> options;
    /// A second, smaller line under each option, if given (the Bluetooth audio choice).
    in property <[string]> details;
    in property <string> label;
    in-out property <int> selected;
    /// Also called when the user picks one (for a choice that isn't bound two-way).
    callback changed(int);
    clickable: false;
    key(event) => {
        if event.text == Key.LeftArrow && root.selected > 0 { root.selected -= 1; root.changed(root.selected); return accept; }
        if event.text == Key.RightArrow && root.selected < root.options.length - 1 { root.selected += 1; root.changed(root.selected); return accept; }
        // At either end, the arrow is used up all the same, rather than moving a list behind.
        if event.text == Key.LeftArrow || event.text == Key.RightArrow { return accept; }
        reject
    }
    height: root.details.length > 0 ? 52px : 40px;
    border-radius: 9px;
    border-width: 1px;
    // Turned off, as a Button: a subtle edge, grey for the choice and faint text.
    border-color: root.enabled ? Theme.ctrl-border : Theme.border;
    accessible-role: radio-group;
    accessible-label: label;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            // Measured in the selected (heavier) weight, so choosing an option doesn't resize it.
            min-width: widest.preferred-width + 24px;
            border-radius: 7px;
            background: i == root.selected ? (root.enabled ? Theme.accent-soft-bg : Theme.ctrl-bg) : option-touch.has-hover && root.enabled ? Theme.hover : transparent;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checked: i == root.selected;
            accessible-enabled: root.enabled;
            accessible-action-default => { if root.enabled { root.selected = i; root.changed(i); } }
            VerticalLayout {
                alignment: center;
                spacing: root.details.length > 0 ? 2px : 0;
                Text {
                    text: option;
                    color: !root.enabled ? Theme.faint : i == root.selected ? Theme.text : Theme.muted;
                    font-size: 13px;
                    font-weight: i == root.selected ? 500 : 400;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                // Nothing (and no height) without details.
                Text {
                    text: root.details.length > i ? root.details[i] : "";
                    height: root.details.length > 0 ? self.preferred-height : 0;
                    color: Theme.faint;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            widest := Text { text: option; font-size: 13px; font-weight: 500; visible: false; }
            option-touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.selected = i; root.changed(i); } }
        }
    }
}

/// The views of a page, top right in its hero (Displays: Monitor, Workspaces, Profiles). Drawn
/// like a Segmented, but they're tabs, which is what a screen reader hears. One stop for Tab; the
/// arrow keys move it.
export component ViewSwitcher inherits Focusable {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> selected;
    clickable: false;
    key(event) => {
        if event.text == Key.LeftArrow && root.selected > 0 { root.selected -= 1; return accept; }
        if event.text == Key.RightArrow && root.selected < root.options.length - 1 { root.selected += 1; return accept; }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow { return accept; }
        reject
    }
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.ctrl-border;
    accessible-role: tab-list;
    accessible-label: label;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            min-width: widest.preferred-width + 24px;
            border-radius: 7px;
            background: i == root.selected ? Theme.accent-soft-bg : view-touch.has-hover ? Theme.hover : transparent;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.selected;
            accessible-action-default => { root.selected = i; }
            Text {
                text: option;
                color: i == root.selected ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: i == root.selected ? 500 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            widest := Text { text: option; font-size: 13px; font-weight: 500; visible: false; }
            view-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; } }
        }
    }
}

/// The views of a card (the selected monitor's Display, Colour and Advanced): underlined
/// labels on the card's line, so they don't look like the page's views. One stop for Tab; the
/// arrow keys move it.
export component Tabs inherits Focusable {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> selected;
    clickable: false;
    key(event) => {
        if event.text == Key.LeftArrow && root.selected > 0 { root.selected -= 1; return accept; }
        if event.text == Key.RightArrow && root.selected < root.options.length - 1 { root.selected += 1; return accept; }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow { return accept; }
        reject
    }
    height: 38px;
    border-radius: 6px;
    accessible-role: tab-list;
    accessible-label: label;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for option[i] in root.options: Rectangle {
            width: widest.preferred-width + 24px;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.selected;
            accessible-action-default => { root.selected = i; }
            Text {
                text: option;
                color: i == root.selected || tab-touch.has-hover ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: i == root.selected ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            widest := Text { text: option; font-size: 13px; font-weight: 600; visible: false; }
            Rectangle { y: parent.height - 2px; height: 2px; background: i == root.selected ? Theme.accent : transparent; }
            tab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; } }
        }
    }
}

/// A field in a form (the editor, the hotspot, a dialog with fields): its label in a 168 px
/// column, the control and the hints under it on the right. `label-top` lines the label up with
/// the text in the control: 10 px beside a field, 0 beside a switch or plain text.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-top: 10px;
    VerticalLayout {
        width: 168px;
        alignment: start;
        padding-top: root.label-top;
        padding-right: 12px;
        Text { text: root.label; color: Theme.text; font-size: 13px; wrap: word-wrap; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 6px;
        alignment: start;
        @children
    }
}

/// A check box and its text; `label` names it for screen readers when it has no text (a column
/// heading names it on the screen).
export component CheckBox inherits Focusable {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> label: text;
    callback toggled(bool);
    height: 24px;
    border-radius: 4px;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checked: checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { checked = !checked; toggled(checked); } }
    activated => { root.checked = !root.checked; root.toggled(root.checked); }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: root.checked ? 0 : 1.5px;
            border-color: Theme.ctrl-border;
            // Turned off: faint, and not the accent even when checked.
            background: !root.checked ? transparent : root.enabled ? Theme.accent : Theme.faint;
            // Hidden rather than an `if`, and no opacity layer for turned off: one of either per
            // check box makes the generated code too big to compile in 8 GB.
            Icon { name: "check"; tint: Theme.on-accent; size: 14px; stroke-width: 2px; visible: root.checked; }
        }
        Text { text: root.text; color: root.enabled ? Theme.text : Theme.faint; font-size: 13px; vertical-alignment: center; }
    }
}

/// A drop-down list. Space, Enter and the arrow keys open it; in it, the arrows move, Space or
/// Enter picks, and Esc closes it.
export component Select inherits Focusable {
    in property <[string]> options;
    /// A second, smaller line under each option, if given.
    in property <[string]> details;
    in property <string> label;
    in-out property <int> selected;
    in property <length> select-height: 38px;
    /// The user picked an option.
    callback chosen(int);
    // The option the arrow keys are on in the open list.
    property <int> highlighted;
    function open() {
        root.highlighted = root.selected;
        popup.show();
    }
    height: select-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.ctrl-border;
    background: self.has-hover ? Theme.hovered(Theme.input-bg) : Theme.input-bg;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: root.options[root.selected];
    accessible-action-default => { root.open(); }
    activated => { root.open(); }
    // Here rather than through `activated`, which would take the focus back from the list.
    key(event) => {
        if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow || event.text == Key.UpArrow {
            root.open();
            return accept;
        }
        reject
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        Text { text: root.options[root.selected]; color: Theme.text; font-size: root.select-height < 38px ? 13px : 14px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Icon { name: "chevron"; tint: Theme.icon-soft; y: (parent.height - 16px) / 2; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        forward-focus: list-keys;
        list-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.highlighted = min(root.highlighted + 1, root.options.length - 1); return accept; }
                if event.text == Key.UpArrow { root.highlighted = max(root.highlighted - 1, 0); return accept; }
                if event.text == " " || event.text == Key.Return {
                    root.selected = root.highlighted;
                    root.chosen(root.highlighted);
                    popup.close();
                    return accept;
                }
                if event.text == Key.Escape { popup.close(); return accept; }
                // Nothing behind the list gets the keys while it's open.
                accept
            }
        }
        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border2;
            background: Theme.surface;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: root.details.length > i ? 44px : 32px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.hover : i == root.selected ? Theme.accent-soft-bg : transparent;
                    // The arrow keys' option, drawn like the focus ring.
                    border-width: i == root.highlighted && Focus.keyboard ? 2px : 0;
                    border-color: Theme.accent;
                    VerticalLayout {
                        padding-left: 10px;
                        alignment: center;
                        Text { text: option; color: Theme.text; font-size: 13px; }
                        if root.details.length > i: Text { text: root.details[i]; color: Theme.muted; font-size: 11px; }
                    }
                    item := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; root.chosen(i); } }
                }
            }
        }
    }
}

/// A dialog over the window: a dimmed backdrop and a card with the children. Esc calls
/// `dismissed`, from any field in it; so does a click on the backdrop if `backdrop-dismisses`,
/// which is only for dialogs with nothing typed in them.
export component Modal inherits Rectangle {
    in property <length> card-width: 440px;
    in property <length> card-spacing: 14px;
    in property <string> label;
    in property <bool> backdrop-dismisses;
    callback dismissed();
    background: #05060799;
    // The page underneath doesn't scroll with the wheel either.
    TouchArea {
        clicked => { if root.backdrop-dismisses { root.dismissed(); } }
        scroll-event(event) => { accept }
    }
    FocusTrap {
        width: root.card-width;
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border2;
        background: Theme.surface;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000080;
        // Slint (1.18) has no dialog role; this is the nearest, and the one place to change.
        accessible-role: groupbox;
        accessible-label: root.label;
        TouchArea {}
        // The dialog takes the keyboard (a field in it that asks for focus gets it after this),
        // so the page underneath gets no keys, and Esc from a field ends here: the window's own
        // keys never see it.
        FocusScope {
            init => { self.focus(); }
            // Not a stop for Tab of its own: Shift+Tab from the first control goes round.
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { root.dismissed(); return accept; }
                reject
            }
            body := VerticalLayout {
                padding: 24px;
                spacing: root.card-spacing;
                @children
            }
        }
    }
}

/// The password dialog. `mode` is "new" (joining a network, with the storage choice), "hidden"
/// (the network's name and security too) or "prompt" (NetworkManager asking, password only).
export component JoinDialog inherits Modal {
    in property <string> mode: "new";
    in property <string> title;
    in property <string> subtitle;
    /// Shown in red under the password: a rejected password, say.
    in property <string> error;
    in property <[string]> securities;
    /// Under the password field, by security ("8 to 63 characters").
    in property <[string]> password-hints;
    in property <[string]> storage-hints;
    in property <bool> valid;
    in-out property <string> name;
    in-out property <int> security;
    in-out property <string> password;
    in-out property <int> storage;
    in-out property <bool> autoconnect;
    callback accepted();
    callback cancelled();
    // Open networks (a hidden one with "None") need no password.
    property <bool> needs-password: root.mode != "hidden" || root.security != 0;

    label: root.title;
    card-spacing: 16px;
    // A click beside it would lose the password, so only Esc and Cancel close it.
    dismissed => { root.cancelled(); }
    HorizontalLayout {
        spacing: 14px;
        if root.mode != "hidden": Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: Theme.accent-soft-bg;
            Icon { name: "lock"; tint: Theme.accent; size: 18px; }
        }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
            Text { text: root.subtitle; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
        }
    }
    if root.mode == "hidden": VerticalLayout {
        spacing: 6px;
        FieldLabel { text: "Network name"; }
        TextField { text <=> root.name; label: "Network name"; autofocus: true; accepted => { if root.valid { root.accepted(); } } }
    }
    if root.mode == "hidden": VerticalLayout {
        spacing: 6px;
        FieldLabel { text: "Security"; }
        Select { options: root.securities; selected <=> root.security; label: "Security"; }
    }
    if root.needs-password: VerticalLayout {
        spacing: 6px;
        FieldLabel { text: "Password"; }
        TextField {
            text <=> root.password;
            password: true;
            autofocus: root.mode != "hidden";
            label: "Password";
            accepted => { if root.valid { root.accepted(); } }
        }
        if root.error != "": Text { text: root.error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
        if root.error == "" && root.password-hints[root.security] != "": Text {
            text: root.password-hints[root.security];
            color: Theme.faint;
            font-size: 12px;
        }
    }
    if root.mode != "prompt" && root.needs-password: VerticalLayout {
        spacing: 8px;
        FieldLabel { text: "Remember the password"; }
        Segmented { options: ["For me only", "All users", "Ask each time"]; selected <=> root.storage; label: "Remember the password"; }
        Text { text: root.storage-hints[root.storage]; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    if root.mode != "prompt": CheckBox { checked <=> root.autoconnect; text: "Connect automatically when in range"; }
    HorizontalLayout {
        padding-top: 4px;
        spacing: 8px;
        alignment: end;
        Button { label: "Cancel"; button-height: 36px; clicked => { root.cancelled(); } }
        Button { label: "Connect"; kind: "primary"; button-height: 36px; enabled: root.valid; clicked => { root.accepted(); } }
    }
}
