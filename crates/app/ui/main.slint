// The main window: sidebar, a list page (Wi-Fi, Wired, VPN, Saved) with its details pane, or the
// Settings page. Everything shown comes from Rust (src/view.rs); this file is layout and looks,
// following the approved mockups.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, SignalBars, Logo } from "icons.slint";
import { Button, IconButton, Switch, SectionLabel, Kbd } from "controls.slint";
import { JoinDialog } from "dialogs.slint";

export { Theme }

export struct NavItem { id: string, label: string, sub: string, icon: string, current: bool }
/// icon: "bars" (signal bars), or an icon name. tone: "accent", "danger", "muted", "faint".
export struct Row { id: string, name: string, meta: string, tone: string, icon: string, bars: int, secure: bool, selected: bool }
export struct Section { title: string, rows: [Row] }
/// kind: "primary", "secondary", "danger".
export struct Action { id: string, label: string, kind: string, enabled: bool }
export struct Toggle { id: string, label: string, sub: string, on: bool }
export struct DetailItem { label: string, value: string, mono: bool }
export struct Details {
    title: string,
    status: string,
    status-tone: string,
    status-extra: string,
    actions: [Action],
    toggles: [Toggle],
    items: [DetailItem],
    note: string,
}
export struct SourceRow { n: int, label: string, path: string, status: string, tone: string, swatches: [color] }

component NavButton inherits Rectangle {
    in property <NavItem> item;
    callback clicked();
    height: sub.text == "" ? 36px : 50px;
    border-radius: 8px;
    background: item.current ? Theme.accent-soft-bg : touch.has-hover ? Theme.sel-bg : transparent;
    accessible-role: button;
    accessible-label: item.label;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        alignment: start;
        Icon { name: root.item.icon; tint: root.item.current ? Theme.accent : Theme.muted; y: 9px; }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text { text: root.item.label; color: Theme.text; font-weight: 500; }
            sub := Text { text: root.item.sub; color: Theme.muted; font-size: 12px; overflow: elide; visible: self.text != ""; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ListRow inherits Rectangle {
    in property <Row> entry;
    callback clicked();
    height: 52px;
    border-radius: 8px;
    border-width: 1px;
    border-color: entry.selected ? Theme.accent-soft-border : transparent;
    background: entry.selected ? Theme.accent-soft-bg : touch.has-hover ? Theme.sel-bg : transparent;
    accessible-role: list-item;
    accessible-label: entry.name + ", " + entry.meta;
    accessible-item-selected: entry.selected;
    accessible-action-default => { clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        if root.entry.icon == "bars": SignalBars { bars: root.entry.bars; y: (parent.height - 14px) / 2; }
        if root.entry.icon != "bars": Icon { name: root.entry.icon; tint: root.entry.selected ? Theme.accent : Theme.muted; y: (parent.height - 16px) / 2; width: 20px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Theme.text; font-weight: 500; overflow: elide; }
            Text { text: root.entry.meta; color: root.entry.selected && root.entry.tone == "muted" ? Theme.accent : Theme.tone(root.entry.tone); font-size: 12px; overflow: elide; }
        }
        if root.entry.secure: Icon { name: "lock"; tint: Theme.faint; size: 14px; y: (parent.height - 14px) / 2; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component DetailsPane inherits Rectangle {
    in property <Details> details;
    callback action(string);
    callback toggle(string);
    background: Theme.surface;
    // Its content would cap it at the content's width, and Slint shrinks the window to match.
    max-width: 100000px;
    // Slint sizes the window to the layout's preferred size when the layout changes; a fixed one
    // here keeps that at 1040 px (with the sidebar and list) instead of following the content.
    preferred-width: 460px;
    VerticalLayout {
        padding: 28px;
        padding-bottom: 20px;
        spacing: 22px;
        alignment: start;
        VerticalLayout {
            spacing: 6px;
            Text { text: root.details.title; color: Theme.text; font-size: 22px; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.tone(root.details.status-tone); y: (parent.height - 8px) / 2; }
                Text { text: root.details.status; color: Theme.tone(root.details.status-tone); font-size: 13px; }
                Text { text: root.details.status-extra; color: Theme.muted; font-size: 13px; }
            }
        }
        if root.details.actions.length > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for a in root.details.actions: Button {
                label: a.label;
                kind: a.kind;
                enabled: a.enabled;
                clicked => { root.action(a.id); }
            }
        }
        if root.details.toggles.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.border2;
            border-radius: 10px;
            VerticalLayout {
                for t[i] in root.details.toggles: Rectangle {
                    height: t.sub == "" ? 42px : 52px;
                    Rectangle { y: 0; height: 1px; background: i == 0 ? transparent : Theme.border2; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: t.label; color: Theme.text; }
                            if t.sub != "": Text { text: t.sub; color: Theme.muted; font-size: 12px; }
                        }
                        Switch { on: t.on; label: t.label; y: (parent.height - self.height) / 2; toggled => { root.toggle(t.id); } }
                    }
                }
            }
        }
        GridLayout {
            spacing-horizontal: 24px;
            spacing-vertical: 14px;
            for item[i] in root.details.items: VerticalLayout {
                col: mod(i, 2);
                row: floor(i / 2);
                spacing: 3px;
                Text { text: item.label; color: Theme.faint; font-size: 12px; }
                Text { text: item.value; color: Theme.text; font-size: 13px; font-family: item.mono ? "JetBrains Mono" : "Inter"; overflow: elide; }
            }
        }
        if root.details.note != "": Text { text: root.details.note; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
}

export component MainWindow inherits Window {
    in property <string> version;
    in property <[NavItem]> nav;
    in property <string> hostname;
    in property <string> page: "wifi";
    in property <string> page-title: "Wi-Fi";
    // Header of the list page.
    in property <bool> show-wifi-switch;
    in property <bool> wifi-on: true;
    in property <bool> show-rescan;
    in property <bool> show-add;
    in property <bool> show-search: true;
    in property <string> search-placeholder: "Search networks";
    in property <string> bottom-label;
    in property <[Section]> sections;
    in property <bool> has-details;
    in property <Details> details;
    // Shown instead of the list: Wi-Fi off, nothing found, NetworkManager not running.
    in property <string> empty-icon;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <string> empty-action;
    in property <string> banner;
    // Settings page.
    in property <string> config-path;
    in property <[SourceRow]> sources;
    in property <string> builtin-label;
    in property <string> placeholder;
    // A message above the list: an error ("danger"), a polkit problem ("warn"), or a note ("info").
    in property <string> message;
    in property <string> message-tone: "info";
    // A bold first line for the message ("Couldn't connect to Aster Café"), and a button on it.
    in property <string> message-title;
    in property <string> message-action;
    // The confirmation dialog (forgetting a connection).
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button;
    // The password dialog (see dialogs.slint); the fields are read back when it's accepted.
    in property <bool> join-open;
    in property <string> join-mode;
    in property <string> join-title;
    in property <string> join-subtitle;
    in property <string> join-error;
    in property <[string]> join-securities;
    in property <[string]> join-password-hints;
    in property <[string]> join-storage-hints;
    in-out property <string> join-name;
    in-out property <int> join-security;
    in-out property <string> join-password;
    in-out property <int> join-storage;
    in-out property <bool> join-autoconnect;
    // Sidebar switch, and where passwords are kept (for Settings).
    in property <bool> airplane;
    in property <string> keyring-label;
    // Whether the desktop asks for dark colours, for the "auto" built-in theme.
    out property <bool> prefers-dark: Palette.color-scheme != ColorScheme.light;

    callback navigate(string);
    callback select(string);
    callback action(string);
    callback toggle(string);
    callback search(string);
    callback move-selection(int);
    callback wifi-switched();
    callback rescan();
    callback activate-selected();
    callback dismiss-message();
    callback confirm-accepted();
    callback confirm-cancelled();
    callback message-action-clicked();
    callback bottom-clicked();
    callback airplane-toggled();
    callback join-accepted();
    callback join-cancelled();
    /// Whether the dialog's fields can be sent: (mode, name, security, password).
    pure callback join-check(string, string, int, string) -> bool;
    // Incremented to move the keyboard focus into the search field.
    property <int> search-focus-requests;

    title: "Vinculum";
    icon: @image-url("assets/logo-mark.svg");
    preferred-width: 1040px;
    preferred-height: 680px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 14px;

    forward-focus: keys;
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == "/" && root.show-search { root.search-focus-requests += 1; return accept; }
            if event.text == Key.DownArrow { root.move-selection(1); return accept; }
            if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
            if event.text == Key.Return && !root.confirm-open && !root.join-open { root.activate-selected(); return accept; }
            if event.text == Key.Escape && root.confirm-open { root.confirm-cancelled(); return accept; }
            if event.text == Key.Escape && root.join-open { root.join-cancelled(); return accept; }
            reject
        }

        HorizontalLayout {
            // Sidebar
            Rectangle {
                width: 196px;
                VerticalLayout {
                    padding: 12px;
                    padding-top: 18px;
                    spacing: 4px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-bottom: 14px;
                        spacing: 10px;
                        alignment: start;
                        Logo { size: 28px; }
                        Text { text: "Vinculum"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                    }
                    for item in root.nav: NavButton {
                        item: item;
                        clicked => { root.navigate(item.id); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    NavButton {
                        item: { id: "settings", label: "Settings", sub: "", icon: "settings", current: root.page == "settings" };
                        clicked => { root.navigate("settings"); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        height: 36px;
                        spacing: 10px;
                        Icon { name: "plane"; tint: Theme.muted; y: (parent.height - 16px) / 2; }
                        Text { text: "Airplane mode"; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                        Switch { on: root.airplane; label: "Airplane mode"; y: (parent.height - self.height) / 2; toggled => { root.airplane-toggled(); } }
                    }
                    if root.hostname != "": HorizontalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "Hostname"; color: Theme.faint; font-size: 12px; }
                        Text { text: root.hostname; color: Theme.muted; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                // The same minimum in every state (the list and the narrowest details pane), so the
                // first snapshot doesn't change the window's limits while it's being mapped.
                min-width: 740px;
                if root.banner != "": Rectangle {
                    height: 40px;
                    background: Theme.warn-bg;
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 10px;
                        Icon { name: "warning"; tint: Theme.warn-text; y: (parent.height - 16px) / 2; }
                        Text { text: root.banner; color: Theme.warn-text; font-size: 13px; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    // List page
                    if root.page != "settings" && root.placeholder == "": Rectangle {
                        // A fixed 384 px next to the details pane; otherwise (loading, or an empty
                        // state) all the room, and the window's 1040 px preferred width with the sidebar.
                        min-width: root.has-details ? 384px : 0px;
                        max-width: root.has-details ? 384px : 100000px;
                        preferred-width: root.has-details ? 384px : 844px;
                        horizontal-stretch: root.has-details ? 0 : 1;
                        background: Theme.panel;
                        VerticalLayout {
                            padding: 12px;
                            padding-top: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 10px;
                                Text { text: root.page-title; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                if root.show-rescan && root.wifi-on: IconButton { icon: "rescan"; label: "Rescan"; clicked => { root.rescan(); } }
                                if root.show-add: IconButton { icon: "plus"; label: "Add"; }
                                if root.show-wifi-switch: Switch {
                                    on: root.wifi-on;
                                    label: "Wi-Fi";
                                    switch-width: 40px;
                                    y: (parent.height - self.height) / 2;
                                    toggled => { root.wifi-switched(); }
                                }
                            }
                            if root.show-search && root.empty-title == "": Rectangle {
                                property <int> focus-requests: root.search-focus-requests;
                                changed focus-requests => { search-input.focus(); }
                                height: 36px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: search-input.has-focus ? Theme.accent : Theme.border2;
                                background: Theme.input-bg;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Icon { name: "search"; tint: Theme.faint; size: 15px; y: (parent.height - 15px) / 2; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        search-input := TextInput {
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accessible-label: root.search-placeholder;
                                            edited => { root.search(self.text); }
                                            key-pressed(event) => {
                                                if event.text == Key.Escape { self.text = ""; root.search(""); keys.focus(); return accept; }
                                                reject
                                            }
                                        }
                                        if search-input.text == "": Text { text: root.search-placeholder; color: Theme.faint; font-size: 13px; vertical-alignment: center; x: 0; }
                                    }
                                    Rectangle {
                                        width: 18px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        border-width: 1px;
                                        border-color: Theme.ctrl-border;
                                        border-radius: 4px;
                                        Text { text: "/"; color: Theme.faint; font-size: 11px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                            if root.message != "": Rectangle {
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.message-tone == "danger" ? Theme.danger : root.message-tone == "warn" ? Theme.warn-border : Theme.ctrl-border;
                                background: root.message-tone == "warn" ? Theme.warn-bg : transparent;
                                accessible-role: text;
                                accessible-label: root.message;
                                HorizontalLayout {
                                    padding: 10px;
                                    padding-right: 6px;
                                    spacing: 10px;
                                    Icon {
                                        name: root.message-tone == "info" ? "error" : root.message-tone == "warn" ? "warning" : "error";
                                        tint: root.message-tone == "danger" ? Theme.danger : root.message-tone == "warn" ? Theme.warn-text : Theme.muted;
                                        y: 2px;
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        if root.message-title != "": Text {
                                            text: root.message-title;
                                            color: root.message-tone == "danger" ? Theme.danger : Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.message;
                                            color: root.message-tone == "warn" ? Theme.warn-text : root.message-title != "" ? Theme.muted : Theme.text;
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }
                                    }
                                    if root.message-action != "": Button {
                                        label: root.message-action;
                                        button-height: 28px;
                                        min-width: self.preferred-width;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.message-action-clicked(); }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: close-touch.has-hover ? Theme.sel-bg : transparent;
                                        accessible-role: button;
                                        accessible-label: "Dismiss";
                                        accessible-action-default => { root.dismiss-message(); }
                                        Path {
                                            width: 12px; height: 12px;
                                            viewbox-width: 16; viewbox-height: 16;
                                            stroke: Theme.faint; stroke-width: 1.6px; fill: transparent;
                                            commands: "M4 4l8 8M12 4l-8 8";
                                        }
                                        close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.dismiss-message(); } }
                                    }
                                }
                            }
                            if root.empty-title == "": Flickable {
                                vertical-stretch: 1;
                                content-height: rows.preferred-height;
                                rows := VerticalLayout {
                                    alignment: start;
                                    spacing: 2px;
                                    for section[si] in root.sections: VerticalLayout {
                                        spacing: 2px;
                                        padding-top: si == 0 ? 4px : 14px;
                                        SectionLabel { text: section.title; x: 8px; height: 22px; vertical-alignment: center; }
                                        for row in section.rows: ListRow {
                                            entry: row;
                                            clicked => { root.select(row.id); keys.focus(); }
                                        }
                                    }
                                }
                            }
                            if root.empty-title != "": VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 14px;
                                Icon { name: root.empty-icon; tint: Theme.faint; size: 44px; stroke-width: 1px; x: (parent.width - 44px) / 2; }
                                Text { text: root.empty-title; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: root.empty-text; color: Theme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                                if root.empty-action != "": HorizontalLayout {
                                    alignment: center;
                                    Button { label: root.empty-action; kind: "primary"; button-height: 36px; clicked => { root.wifi-switched(); } }
                                }
                            }
                            if root.bottom-label != "" && root.empty-title == "": Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.ctrl-border;
                                background: bottom-touch.has-hover ? Theme.sel-bg : transparent;
                                accessible-role: button;
                                accessible-label: root.bottom-label;
                                accessible-action-default => { root.bottom-clicked(); }
                                Text { text: root.bottom-label; color: Theme.icon-soft; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                bottom-touch := TouchArea { mouse-cursor: pointer; clicked => { root.bottom-clicked(); } }
                            }
                        }
                        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; visible: root.has-details; }
                    }
                    if root.page != "settings" && root.placeholder == "" && root.has-details: DetailsPane {
                        horizontal-stretch: 1;
                        details: root.details;
                        action(id) => { root.action(id); }
                        toggle(id) => { root.toggle(id); }
                    }
                    if root.placeholder != "": Rectangle {
                        background: Theme.surface;
                        horizontal-stretch: 1;
                        Text { text: root.placeholder; color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; width: 70%; }
                    }
                    // Settings
                    if root.page == "settings": Rectangle {
                        background: Theme.surface;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 32px;
                            padding-top: 24px;
                            spacing: 22px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "Settings"; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; }
                                Text { text: "Read from"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                Text { text: root.config-path; color: Theme.icon-soft; font-size: 12px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                spacing: 10px;
                                Text { text: "Colours"; color: Theme.text; font-weight: 600; }
                                Text { text: "The first source that exists is used, and the window recolours when it changes."; color: Theme.muted; font-size: 13px; }
                                Rectangle {
                                    border-width: 1px;
                                    border-color: Theme.border2;
                                    border-radius: 10px;
                                    VerticalLayout {
                                        for s[i] in root.sources: Rectangle {
                                            height: 54px;
                                            Rectangle { y: 0; height: 1px; background: i == 0 ? transparent : Theme.border2; }
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 12px;
                                                Text { text: s.n; color: Theme.faint; font-size: 12px; font-family: "JetBrains Mono"; width: 14px; vertical-alignment: center; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    horizontal-stretch: 1;
                                                    Text { text: s.label; color: Theme.text; font-weight: 500; }
                                                    Text { text: s.path; color: Theme.muted; font-size: 12px; font-family: "JetBrains Mono"; overflow: elide; }
                                                }
                                                HorizontalLayout {
                                                    spacing: 3px;
                                                    alignment: center;
                                                    for c in s.swatches: Rectangle { width: 14px; height: 14px; y: (parent.height - 14px) / 2; border-radius: 4px; background: c; border-width: 1px; border-color: Theme.border2; }
                                                }
                                                Text { text: s.status; color: Theme.tone(s.tone); font-size: 12px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 24px;
                                Text { text: "Built-in theme"; color: Theme.icon-soft; width: 200px; }
                                Text { text: root.builtin-label; color: Theme.text; }
                            }
                            HorizontalLayout {
                                spacing: 24px;
                                Text { text: "Passwords \"for me only\""; color: Theme.icon-soft; width: 200px; }
                                Text { text: root.keyring-label; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            Text { text: "Changes are made in the file for now; editing them here comes in a later version."; color: Theme.faint; font-size: 12px; }
                        }
                    }
                }
                // Keyboard hints
                Rectangle {
                    height: 30px;
                    background: Theme.bg;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 18px;
                        alignment: start;
                        Kbd { key: "/"; label: "Search"; }
                        Kbd { key: "↑↓"; label: "Select"; }
                        Kbd { key: "↵"; label: "Connect"; }
                        Kbd { key: "Esc"; label: "Clear search"; }
                        // Lets the bar (and so the window) grow wider than its hints.
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    // The confirmation dialog, over everything.
    if root.confirm-open: Rectangle {
        background: #05060799;
        TouchArea { clicked => { root.confirm-cancelled(); } }
        Rectangle {
            width: 420px;
            height: dialog.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.ctrl-border;
            background: Theme.surface;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000080;
            accessible-role: groupbox;
            accessible-label: root.confirm-title;
            TouchArea {}
            dialog := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: root.confirm-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                Text { text: root.confirm-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 6px;
                    spacing: 8px;
                    alignment: end;
                    Button { label: "Cancel"; button-height: 36px; clicked => { root.confirm-cancelled(); } }
                    Button { label: root.confirm-button; kind: "destructive"; button-height: 36px; clicked => { root.confirm-accepted(); } }
                }
            }
        }
    }

    if root.join-open: JoinDialog {
        mode: root.join-mode;
        title: root.join-title;
        subtitle: root.join-subtitle;
        error: root.join-error;
        securities: root.join-securities;
        password-hints: root.join-password-hints;
        storage-hints: root.join-storage-hints;
        name <=> root.join-name;
        security <=> root.join-security;
        password <=> root.join-password;
        storage <=> root.join-storage;
        autoconnect <=> root.join-autoconnect;
        valid: root.join-check(root.join-mode, root.join-name, root.join-security, root.join-password);
        accepted => { root.join-accepted(); keys.focus(); }
        cancelled => { root.join-cancelled(); keys.focus(); }
    }
}
