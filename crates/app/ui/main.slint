// The main window: sidebar, a list page (Wi-Fi, Wired, VPN) with its details pane, the Hotspot
// page, or one of the other pages. Everything shown comes from Rust (src/view.rs); this file is layout and looks,
// following the approved mockups.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, SignalBars, Logo } from "icons.slint";
import { Button, IconButton, AddButton, Switch, PillSwitch, SectionLabel, Banner, Kbd, Hint, Scroll, Focusable, Focus } from "controls.slint";
import { JoinDialog, TextField, Segmented, FormRow, Modal } from "dialogs.slint";
import { QuickWindow, QuickRow } from "quick.slint";
import { Action, Toggle, DetailItem, Chip, ChipRow, Details, DetailsPane } from "details.slint";
import { Sidebar, Hero, HeroSubject, Card, SettingRow, EmptyState, NavItem, NavGroup, HeroInfo } from "shell.slint";
import { SettingsHero, AppearanceSettings, ColourFiles, ThemeSwatch, ColourChip, SourceRow } from "appearance.slint";
import { SendFilesDialog, IncomingFileDialog, FilesView, FileRow } from "files.slint";
import { DisplaysPage, DisplaysView, DragSnap, LayoutMonitor, WorkspaceRow, ProfileRow, KeepDialog, ConfigDialog } from "displays.slint";
import { SoundPage, SoundView, SoundApp, SoundCard } from "sound.slint";
import { KeyboardPage, MousePage, KeyboardView, MouseView, InputRow, InputSection, PointerSetting, LayoutRow, InputBar, AddLayoutDialog, OwnSettingsDialog } from "input.slint";
import { BluetoothPage, BtPage, BtSection, BtRow, BtPair, BtPairDialog, BtAdapterDialog, BtRenameDialog } from "bluetooth.slint";
import { Editor, EditorForm, EditorErrors, EditorOptions, EditorTab, AddressRow, RouteRow, IpFormUi, EapFormUi, PeerRow, WgFormUi, OvpnFormUi, VirtFormUi, PortRowUi, PortCandidateUi } from "editor.slint";

export { Theme, Focus, Hint, FilesView, FileRow, DisplaysView, DragSnap, LayoutMonitor, WorkspaceRow, ProfileRow, KeyboardView, MouseView, InputRow, InputSection, PointerSetting, LayoutRow, InputBar, SoundView, SoundApp, SoundCard, ThemeSwatch, ColourChip, SourceRow, NavItem, NavGroup, HeroInfo, Action, Toggle, DetailItem, Chip, ChipRow, Details, BtPage, BtSection, BtRow, BtPair, QuickWindow, QuickRow, EditorForm, EditorErrors, EditorOptions, EditorTab, AddressRow, RouteRow, IpFormUi, EapFormUi, PeerRow, WgFormUi, OvpnFormUi, VirtFormUi, PortRowUi, PortCandidateUi }

/// icon: "bars" (signal bars), or an icon name. tone: "accent", "danger", "muted", "faint".
/// indent: a port under its bridge or bond, or a VLAN under its device.
export struct Row { id: string, name: string, meta: string, tone: string, icon: string, bars: int, secure: bool, selected: bool, indent: bool }
export struct Section { title: string, rows: [Row] }
export struct HostRow { name: string, address: string, since: string }
/// A part of the window, in its coordinates.
struct Area { x: length, y: length, width: length, height: length }

// Space selects it, Enter selects it and connects (the window's Enter, for the selection), and
// the arrow keys move the selection, taking the focus along.
component ListRow inherits Focusable {
    in property <Row> entry;
    /// Whether the selected row scrolls into view (after a move with the keyboard).
    in property <bool> follow;
    callback clicked();
    /// Its place in the window, for the list to scroll to.
    callback reveal(length, length);
    height: 52px;
    border-radius: 8px;
    // The list would cut off a ring outside it.
    ring-gap: -2px;
    focus-key: "row:" + entry.id;
    selected-key: entry.selected ? "list:selected" : "";
    background: entry.selected ? Theme.accent-soft-bg : self.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: entry.name + ", " + entry.meta;
    accessible-item-selected: entry.selected;
    accessible-action-default => { clicked(); }
    activated => { root.clicked(); }
    key(event) => {
        if event.text == Key.Return { root.clicked(); root.focus(); return reject; }
        // The window moves the selection; the focus goes with it.
        if event.text == Key.UpArrow || event.text == Key.DownArrow { Focus.key = "list:selected"; }
        reject
    }
    HorizontalLayout {
        padding-left: root.entry.indent ? 34px : 10px;
        padding-right: 10px;
        spacing: 12px;
        if root.entry.icon == "bars": SignalBars { bars: root.entry.bars; y: (parent.height - 14px) / 2; }
        if root.entry.icon != "bars": Icon { name: root.entry.icon; tint: root.entry.selected ? Theme.accent : Theme.muted; y: (parent.height - 16px) / 2; width: 20px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.entry.name; color: Theme.text; font-weight: 500; overflow: elide; }
            Text { text: root.entry.meta; color: root.entry.selected && root.entry.tone == "muted" ? Theme.accent : Theme.tone(root.entry.tone); font-size: 12px; overflow: elide; }
        }
        if root.entry.secure: Icon { name: "lock"; tint: Theme.faint; size: 14px; y: (parent.height - 14px) / 2; }
    }
    // Rows are made anew with each update, so this runs once the new selected row is laid out.
    Timer {
        interval: 1ms;
        running: root.follow && root.entry.selected;
        triggered => { self.running = false; root.reveal(root.absolute-position.y, root.height); }
    }
}

export component MainWindow inherits Window {
    in property <string> version;
    in property <[NavGroup]> nav-groups;
    property <int> nav-focus-requests;
    property <int> nav-list-focus-requests;
    in property <string> hostname;
    in property <string> page: "wifi";
    in property <string> page-title: "Wi-Fi";
    // Network's pages (its sub-items in the sidebar): the hero and the line under its title. The
    // actions on what it shows are the details pane's.
    property <bool> network-page: root.page == "wifi" || root.page == "wired" || root.page == "vpn" || root.page == "hotspot";
    in property <string> net-sub;
    in property <HeroInfo> net-hero;
    in property <bool> wifi-available;
    // Above the list: "4 networks in range", the search field and Rescan.
    in property <string> count;
    in property <bool> show-wifi-switch;
    in property <bool> wifi-on: true;
    in property <bool> show-rescan;
    in property <bool> show-add;
    in property <bool> show-search: true;
    in property <string> search-placeholder: "Search networks";
    in property <string> bottom-label;
    in property <[Section]> sections;
    in property <bool> has-details;
    in property <Details> details;
    // Shown instead of the list: Wi-Fi off, nothing found, NetworkManager not running. No icon:
    // reading NetworkManager, with a spinner. `empty-page`: the page has nothing else to show
    // (Wi-Fi off, no VPN yet), so the hero is only its title and line.
    in property <string> empty-icon;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <string> empty-command;
    in property <string> empty-action;
    in property <bool> empty-page;
    in property <string> banner;
    /// The keys in the bar at the bottom that work on the page shown, from Rust.
    in property <[Hint]> hints;
    // Settings page.
    in property <string> config-path;
    // Files over Bluetooth (see files.slint).
    in property <FilesView> files;
    in-out property <bool> files-always;
    /// "cancel", "hide", "accept", "decline".
    callback files-act(string);
    // Displays page (see displays.slint).
    in property <DisplaysView> displays;
    in-out property <int> displays-tab;
    in-out property <int> displays-page-tab;
    callback displays-act(string, string, float);
    callback displays-drop(int, float, float);
    pure callback displays-snap(int, float, float, float, bool) -> DragSnap;
    // Sound page (see sound.slint).
    in property <SoundView> sound;
    in-out property <int> sound-tab;
    /// Everything done on the Sound page: (verb, id, value).
    callback sound-act(string, string, float);
    // The Input pages, Keyboard and Mouse & touchpad (see input.slint).
    in property <KeyboardView> keyboard;
    in property <MouseView> mouse;
    /// Everything done on them: (verb, argument, value).
    callback input-act(string, string, float);
    // Settings' Appearance section and hero (see appearance.slint).
    in property <[SourceRow]> sources;
    in property <bool> ap-follow;
    in property <bool> ap-follow-available;
    in property <bool> ap-wallpaper-in-use;
    in property <string> ap-name;
    in property <string> ap-name-text;
    in property <[ColourChip]> ap-chips;
    in property <[ThemeSwatch]> ap-swatches;
    in property <string> ap-note;
    in property <int> ap-mode;
    in property <bool> ap-gradient;
    /// Everything done in the Appearance section: ("follow" | "theme" | "mode" | "gradient", index).
    callback ap-act(string, int);
    in property <[Toggle]> options;
    callback option-toggled(string);
    // A message above the list: an error ("danger"), a polkit problem ("warn"), or a note ("info").
    in property <string> message;
    in property <string> message-tone: "info";
    // A bold first line for the message ("Couldn't connect to Aster Café"), and a button on it.
    in property <string> message-title;
    in property <string> message-action;
    // The confirmation dialog (forgetting a connection or a device, changing a display profile).
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button;
    /// The button is red (Forget, Delete); else it's the usual primary (Update).
    in property <bool> confirm-destructive: true;
    // The password dialog (see dialogs.slint); the fields are read back when it's accepted.
    in property <bool> join-open;
    in property <string> join-mode;
    in property <string> join-title;
    in property <string> join-subtitle;
    in property <string> join-error;
    in property <[string]> join-securities;
    in property <[string]> join-password-hints;
    in property <[string]> join-storage-hints;
    in-out property <string> join-name;
    in-out property <int> join-security;
    in-out property <string> join-password;
    in-out property <int> join-storage;
    in-out property <bool> join-autoconnect;
    // The connection editor (see editor.slint).
    in property <bool> editor-open;
    in property <string> editor-title;
    in property <string> editor-subtitle;
    in property <[EditorTab]> editor-tabs;
    in-out property <string> editor-tab: "general";
    in-out property <EditorForm> editor-form;
    in property <EditorErrors> editor-errors;
    in property <EditorOptions> editor-options;
    in property <bool> editor-dirty;
    in property <bool> editor-valid: true;
    in property <bool> editor-busy;
    in property <bool> editor-new;
    in property <string> editor-footer;
    in property <string> editor-footer-tone: "muted";
    in property <string> editor-routes;
    in property <bool> editor-ports-open;
    callback editor-port-chosen(string);
    // "Add a connection", and the hostname dialog.
    in property <bool> add-open;
    in property <bool> hostname-open;
    in-out property <string> hostname-input;
    in property <string> hostname-error;
    // The hotspot page.
    in property <bool> hotspot-available;
    in property <bool> hotspot-on;
    in property <string> hotspot-warning;
    in property <image> hotspot-qr;
    in property <[HostRow]> hotspot-clients;
    in-out property <string> hotspot-ssid;
    in-out property <string> hotspot-password;
    in-out property <int> hotspot-band;
    // Sharing a network: its QR code and password.
    in property <bool> share-open;
    in property <string> share-title;
    in property <string> share-password;
    in property <image> share-qr;
    // The Bluetooth page and its dialogs (see bluetooth.slint).
    in property <BtPage> bt;
    in property <bool> bt-pair-open;
    in property <BtPair> bt-pair;
    in-out property <string> bt-pair-code;
    in-out property <bool> bt-pair-always;
    in property <bool> bt-adapter-open;
    in property <string> bt-adapter-label;
    in-out property <bool> bt-pairable;
    in-out property <string> bt-adapter-name;
    in-out property <int> bt-visible-choice;
    in property <bool> bt-rename-open;
    in property <string> bt-rename-title;
    in property <string> bt-rename-hint;
    in-out property <string> bt-rename-name;
    /// Everything done on the Bluetooth page and its dialogs: (verb, argument).
    callback bt-act(string, string);
    // Sidebar switch, and where passwords are kept (for Settings).
    in property <bool> airplane;
    in property <string> keyring-label;
    // Whether the desktop asks for dark colours, for the "auto" built-in theme.
    out property <bool> prefers-dark: Palette.color-scheme != ColorScheme.light;

    callback navigate(string);
    /// The chevron of a sidebar item with sub-items (Network).
    callback nav-fold(string);
    callback nav-search(string);
    callback nav-search-accepted();
    callback select(string);
    callback action(string);
    callback toggle(string);
    /// The details pane's Metered choice: 0 Automatic, 1 Yes, 2 No.
    callback metered-chosen(int);
    callback search(string);
    callback move-selection(int);
    callback wifi-switched();
    callback rescan();
    callback activate-selected();
    callback dismiss-message();
    callback confirm-accepted();
    callback confirm-cancelled();
    callback message-action-clicked();
    callback bottom-clicked();
    callback airplane-toggled();
    callback editor-back();
    callback editor-apply();
    callback editor-revert();
    callback editor-edited();
    callback editor-add-row(string);
    callback editor-remove-row(string, int);
    callback editor-add-dns(string);
    callback editor-edit-routes(string);
    callback editor-routes-done(bool);
    callback editor-choose-file(string);
    callback editor-wg-generate();
    callback editor-wg-show-key();
    callback editor-wg-export();
    callback editor-add-allowed(int);
    callback add-clicked();
    callback hotspot-toggled();
    callback hotspot-new-password();
    callback hotspot-edited();
    callback share-closed();
    callback empty-action-clicked();
    callback add-chosen(string);
    callback add-cancelled();
    callback hostname-clicked();
    callback hostname-save();
    callback hostname-cancelled();
    callback join-accepted();
    callback join-cancelled();
    /// Whether the dialog's fields can be sent: (mode, name, security, password).
    pure callback join-check(string, string, int, string) -> bool;
    // Incremented to move the keyboard focus into the search field.
    property <int> search-focus-requests;
    // Set by the arrow keys, so the selected row stays in view; scrolling clears it.
    property <bool> follow-selection;
    // The window's height, set when it changes rather than bound to it: the height depends on
    // the layout, and the heroes' heights on this.
    property <length> window-height: 760px;
    changed height => { root.window-height = root.height; }
    init => { root.window-height = root.height; }
    // A short window: the heroes are smaller, so the lists keep their room.
    property <bool> compact: root.window-height < 720px;

    title: "Lituus";
    icon: @image-url("assets/logo-mark.svg");
    preferred-width: 1200px;
    preferred-height: 760px;
    // Fixed limits: Slint shrinks the window whenever the limits it works out from the content
    // change (an empty page getting a list and details, say), so they mustn't change.
    min-width: 1040px;
    min-height: 600px;
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 14px;

    forward-focus: keys;
    keys := FocusScope {
        init => { self.focus(); }
        // It has the focus when no control does; not a stop of its own for Tab.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            // The confirmation dialog is over everything: Esc cancels it, and the page gets no keys.
            if root.confirm-open && event.text == Key.Escape { root.confirm-cancelled(); return accept; }
            if root.confirm-open { return reject; }
            if event.modifiers.control && (event.text == "k" || event.text == "K") { root.nav-focus-requests += 1; return accept; }
            // From the page (or no control) to the sidebar's pages; the sidebar sends it back.
            if event.text == Key.F6 && !root.modal-open && !root.editor-open { root.nav-list-focus-requests += 1; return accept; }
            // The Keyboard page: Alt+↑↓ moves the selected layout, Del removes it.
            if root.page == "keyboard" && event.modifiers.alt && event.text == Key.UpArrow { root.input-act("layout-up", "", 0); return accept; }
            if root.page == "keyboard" && event.modifiers.alt && event.text == Key.DownArrow { root.input-act("layout-down", "", 0); return accept; }
            if root.page == "keyboard" && event.text == Key.Delete { root.input-act("layout-remove-selected", "", 0); return accept; }
            if event.text == "/" && root.show-search { root.search-focus-requests += 1; return accept; }
            if event.text == Key.DownArrow { root.follow-selection = true; root.move-selection(1); return accept; }
            if event.text == Key.UpArrow { root.follow-selection = true; root.move-selection(-1); return accept; }
            if event.text == Key.Escape && root.editor-open && root.editor-routes != "" { root.editor-routes-done(false); return accept; }
            if event.text == Key.Escape && root.editor-open { root.editor-back(); return accept; }
            if root.editor-open { return reject; }
            if event.text == Key.Escape && root.bt-pair-open { root.bt-act("pair-cancel", ""); return accept; }
            if event.text == Key.Escape && root.bt-adapter-open { root.bt-act("adapter-close", ""); return accept; }
            if event.text == Key.Escape && root.bt-rename-open { root.bt-act("rename-cancel", ""); return accept; }
            if root.bt-pair-open || root.bt-adapter-open || root.bt-rename-open { return reject; }
            if root.page == "bluetooth" && (event.text == "p" || event.text == "s") { root.bt-act("key", event.text); return accept; }
            if event.text == Key.Escape && root.add-open { root.add-cancelled(); return accept; }
            if event.text == Key.Escape && root.share-open { root.share-closed(); return accept; }
            if event.text == Key.Escape && root.hostname-open { root.hostname-cancelled(); return accept; }
            if event.text == "e" && root.has-details && !root.join-open { root.editor-from-details = true; root.action("edit"); return accept; }
            if event.text == Key.Return && !root.join-open { root.editor-from-details = false; root.activate-selected(); return accept; }
            if event.text == Key.Escape && root.join-open { root.join-cancelled(); return accept; }
            reject
        }

        HorizontalLayout {
            Sidebar {
                groups: root.nav-groups;
                settings-current: root.page == "settings";
                airplane: root.airplane;
                hostname: root.hostname;
                focus-requests: root.nav-focus-requests;
                list-focus-requests: root.nav-list-focus-requests;
                // Enter or a click opens the page; the window's keys work there. (A keyboard user
                // keeps the focus on the page's item: Focusable takes it back.)
                navigate(id) => { root.navigate(id); keys.focus(); }
                // F6: to the page's first control, as Tab from just before the page would.
                leave => { page-start.focus(); Focus.keyboard = true; Focus.step(true); }
                fold(id) => { root.nav-fold(id); }
                search(text) => { root.nav-search(text); }
                search-accepted => { root.nav-search-accepted(); }
                search-left => { keys.focus(); }
                airplane-toggled => { root.airplane-toggled(); }
                hostname-clicked => { root.hostname-clicked(); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                // The same minimum in every state, so the first snapshot doesn't change the
                // window's limits while it's being mapped.
                min-width: 790px;
                // Where F6 from the sidebar starts: Tab goes on from here to the page's first
                // control.
                page-start := FocusScope { height: 0; focus-on-tab-navigation: false; focus-on-click: false; }
                if root.banner != "": Rectangle {
                    height: 40px;
                    background: Theme.warn-bg;
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 10px;
                        VerticalLayout { alignment: center; Icon { name: "warning"; tint: Theme.warn-text; } }
                        Text { text: root.banner; color: Theme.warn-text; font-size: 13px; vertical-alignment: center; }
                    }
                }
                page-body := VerticalLayout {
                    vertical-stretch: 1;
                    padding: 18px;
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 14px;
                    // Network's pages: Wi-Fi, Wired, VPN and Hotspot, each with its hero.
                    if root.network-page: network-hero := Hero {
                        // With nothing on the page (Wi-Fi off, no VPN yet, no Wi-Fi card for a
                        // hotspot), only the title and its line: the card says the rest.
                        property <bool> empty: root.empty-page || (root.page == "hotspot" && !root.hotspot-available);
                        title: root.page-title;
                        sub: root.net-sub;
                        hero-height: root.compact || self.empty ? 136px : 206px;
                        compact: root.compact;
                        aside: net-tools.width + 18px;
                        if !network-hero.empty: HeroSubject {
                            x: 24px;
                            y: parent.height - self.height - (root.compact ? 16px : 22px);
                            width: parent.width - 48px;
                            height: root.compact ? 56px : 96px;
                            compact: root.compact;
                            info: root.net-hero;
                        }
                        net-tools := HorizontalLayout {
                            x: parent.width - self.width - 18px;
                            y: 18px;
                            width: self.preferred-width;
                            height: 34px;
                            spacing: 8px;
                            if root.page == "wifi" && root.wifi-available: PillSwitch { label: "Wi-Fi"; on: root.wifi-on; toggled => { root.wifi-switched(); } }
                            if root.page == "hotspot" && root.hotspot-available: PillSwitch { label: "Hotspot"; on: root.hotspot-on; toggled => { root.hotspot-toggled(); } }
                            if root.page != "hotspot": IconButton { icon: "plus"; label: "Add a connection"; size: 34px; clicked => { root.editor-from-details = false; root.add-clicked(); } }
                        }
                    }
                    // Below the hero, the page scrolls when the window is too short for the list
                    // and details at their smallest.
                    if root.network-page: page-scroll := Scroll {
                        // For the editor (see editor-area).
                        property <Area> area: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
                        init => { root.page-area = self.area; }
                        changed area => { root.page-area = self.area; }
                        vertical-stretch: 1;
                        fill: true;
                        spacing: 14px;
                        bar-inset: -16px;
                        if root.network-page && root.page != "hotspot" && (root.count != "" || root.show-search): HorizontalLayout {
                            height: 34px;
                            spacing: 10px;
                            Text { text: root.count; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.show-search: Rectangle {
                                property <int> focus-requests: root.search-focus-requests;
                                changed focus-requests => { search-input.focus(); }
                                width: 260px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: search-input.has-focus ? Theme.accent : Theme.ctrl-border;
                                background: Theme.input-bg;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Icon { name: "search"; tint: Theme.faint; size: 15px; y: (parent.height - 15px) / 2; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        search-input := TextInput {
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accessible-label: root.search-placeholder;
                                            edited => { root.search(self.text); }
                                            key-pressed(event) => {
                                                if event.text == Key.Escape { self.text = ""; root.search(""); keys.focus(); return accept; }
                                                reject
                                            }
                                        }
                                        if search-input.text == "": Text { text: root.search-placeholder; color: Theme.faint; font-size: 13px; vertical-alignment: center; x: 0; }
                                    }
                                    Rectangle {
                                        width: 18px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        border-width: 1px;
                                        border-color: Theme.border2;
                                        border-radius: 4px;
                                        Text { text: "/"; color: Theme.faint; font-size: 11px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                            if root.show-rescan && root.wifi-on: IconButton { icon: "rescan"; label: "Rescan"; size: 34px; clicked => { root.rescan(); } }
                        }
                        if root.network-page && root.page != "hotspot": HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            list-card := Card {
                                horizontal-stretch: 1;
                                min-width: 330px;
                                preferred-width: 440px;
                                // Up to 520 px beside the details, as Mouse & touchpad's list; alone,
                                // it fills the row.
                                max-width: root.has-details ? 520px : 100000px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                            if root.message != "": Banner {
                                tone: root.message-tone;
                                title: root.message-title;
                                text: root.message;
                                action: root.message-action;
                                action-clicked => { root.message-action-clicked(); }
                                dismissed => { root.dismiss-message(); }
                            }
                            // At least three rows before the page itself scrolls.
                            if root.empty-title == "": list := Scroll {
                                vertical-stretch: 1;
                                min-height: 160px;
                                spacing: 2px;
                                bar-inset: -8px;
                                scrolled => { root.follow-selection = false; }
                                for section[si] in root.sections: VerticalLayout {
                                    spacing: 2px;
                                    padding-top: si == 0 ? 4px : 14px;
                                    SectionLabel { text: section.title; x: 8px; height: 22px; vertical-alignment: center; }
                                    for row in section.rows: ListRow {
                                        entry: row;
                                        follow: root.follow-selection;
                                        reveal(top, size) => { list.reveal(top, size); }
                                        clicked => { root.follow-selection = false; root.select(row.id); keys.focus(); }
                                    }
                                }
                            }
                            if root.empty-title != "": EmptyState {
                                vertical-stretch: 1;
                                icon: root.empty-icon;
                                loading: root.empty-icon == "";
                                title: root.empty-title;
                                text: root.empty-text;
                                command: root.empty-command;
                                action: root.empty-action;
                                action-clicked => { root.editor-from-details = false; root.empty-action-clicked(); }
                            }
                            // As wide as its label: a button across the list was 800 px wide.
                            if root.bottom-label != "" && root.empty-title == "": HorizontalLayout {
                                alignment: start;
                                AddButton { label: root.bottom-label; clicked => { root.editor-from-details = false; root.bottom-clicked(); } }
                            }
                                }
                            }
                            if root.has-details: DetailsPane {
                                property <Area> area: { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
                                init => { root.details-area = self.area; }
                                changed area => { root.details-area = self.area; }
                                horizontal-stretch: 1;
                                details: root.details;
                                action(id) => { root.editor-from-details = true; root.action(id); }
                                toggle(id) => { root.toggle(id); }
                                metered-chosen(i) => { root.metered-chosen(i); }
                            }
                        }
                        if root.page == "hotspot" && !root.hotspot-available: Card {
                            vertical-stretch: 1;
                            EmptyState {
                                icon: "hotspot";
                                title: "No Wi-Fi card";
                                text: "A hotspot needs a Wi-Fi card to share the connection over.";
                            }
                        }
                        // The switch and the state are in the hero; the card is as tall as the form.
                        if root.page == "hotspot" && root.hotspot-available: Card {
                            height: hotspot-form.preferred-height;
                            // The form stops at 720 px with the code beside it; the fields are as wide
                            // as the editor's (360 px), and narrower only in a small window.
                            hotspot-form := HorizontalLayout {
                                padding: 16px;
                                spacing: 40px;
                                alignment: start;
                                VerticalLayout {
                                    spacing: 16px;
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    preferred-width: 720px;
                                    max-width: 720px;
                                    FormRow {
                                        label: "Network name";
                                        HorizontalLayout {
                                            alignment: start;
                                            TextField { text <=> root.hotspot-ssid; mono: true; label: "Network name"; enabled: !root.hotspot-on; horizontal-stretch: 1; preferred-width: 360px; max-width: 360px; edited => { root.hotspot-edited(); } }
                                        }
                                    }
                                    FormRow {
                                        label: "Password";
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            TextField { text <=> root.hotspot-password; mono: true; label: "Password"; enabled: !root.hotspot-on; horizontal-stretch: 1; preferred-width: 360px; max-width: 360px; edited => { root.hotspot-edited(); } }
                                            Button { label: "Generate"; button-height: 36px; horizontal-stretch: 0; enabled: !root.hotspot-on; clicked => { root.hotspot-new-password(); } }
                                        }
                                    }
                                    FormRow {
                                        label: "Security";
                                        label-top: 0;
                                        Text { text: "WPA2 Personal"; color: Theme.text; font-size: 13px; }
                                    }
                                    FormRow {
                                        label: "Band";
                                        HorizontalLayout {
                                            alignment: start;
                                            Segmented { options: ["Automatic", "2.4 GHz", "5 GHz"]; selected <=> root.hotspot-band; label: "Band"; height: 34px; }
                                        }
                                    }
                                    if root.hotspot-warning != "": Banner { tone: "warn"; text: root.hotspot-warning; dismissible: false; }
                                    if root.hotspot-on: VerticalLayout {
                                        spacing: 8px;
                                        SectionLabel { text: root.hotspot-clients.length == 0 ? "NO DEVICES YET" : "CONNECTED DEVICES · " + root.hotspot-clients.length; }
                                        for c in root.hotspot-clients: Rectangle {
                                            height: 50px;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: Theme.border2;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text { text: c.name; color: Theme.text; font-weight: 500; }
                                                    Text { text: c.address; color: Theme.muted; font-size: 12px; font-family: "JetBrains Mono"; }
                                                }
                                                Text { text: c.since; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 220px;
                                        height: 220px;
                                        border-radius: 12px;
                                        background: white;
                                        Image { source: root.hotspot-qr; width: 200px; height: 200px; image-rendering: pixelated; }
                                        // Nothing answers it while the hotspot is off: dimmed, under
                                        // a veil rather than an opacity layer.
                                        Rectangle { border-radius: parent.border-radius; background: Theme.surface.with-alpha(0.82); visible: !root.hotspot-on; }
                                    }
                                    Text {
                                        text: root.hotspot-on ? "Scan with a phone camera to join" : "Turn the hotspot on to share";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    if root.page == "bluetooth": Hero {
                        title: "Bluetooth";
                        sub: root.bt.hero-sub;
                        // Off, missing or not running: only the title, its line and the switch.
                        hero-height: root.compact || (root.bt.state != "list" && root.bt.state != "loading") ? 136px : 206px;
                        compact: root.compact;
                        aside: bt-tools.width + 18px;
                        if root.bt.state == "list": HeroSubject {
                            x: 24px;
                            y: parent.height - self.height - (root.compact ? 16px : 22px);
                            width: parent.width - 48px;
                            height: root.compact ? 56px : 96px;
                            compact: root.compact;
                            info: root.bt.hero;
                        }
                        bt-tools := HorizontalLayout {
                            x: parent.width - self.width - 18px;
                            y: 18px;
                            width: self.preferred-width;
                            height: 34px;
                            spacing: 8px;
                            if root.bt.state == "list": IconButton { icon: "rescan"; label: "Look for devices again"; size: 34px; clicked => { root.bt-act("rescan", ""); keys.focus(); } }
                            if root.bt.state == "list": IconButton { icon: "gear"; label: "Adapter settings"; size: 34px; clicked => { root.bt-act("adapter", ""); } }
                            if root.bt.state == "list": PillSwitch {
                                label: "Visible";
                                on: root.bt.visible;
                                note: root.bt.visible-left;
                                toggled => { root.bt-act("visible", ""); keys.focus(); }
                            }
                            if root.bt.state == "list" || root.bt.state == "off": PillSwitch {
                                label: "Bluetooth";
                                on: root.bt.powered;
                                toggled => { root.bt-act("power", ""); keys.focus(); }
                            }
                        }
                    }
                    if root.page == "bluetooth": Scroll {
                        vertical-stretch: 1;
                        fill: true;
                        bar-inset: -16px;
                        BluetoothPage {
                            vertical-stretch: 1;
                            page: root.bt;
                            follow-selection <=> root.follow-selection;
                            act(verb, argument) => { root.bt-act(verb, argument); keys.focus(); }
                        }
                    }
                    if root.page == "displays": DisplaysPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        window-height: root.window-height;
                        view: root.displays;
                        tab <=> root.displays-tab;
                        page-tab <=> root.displays-page-tab;
                        act(verb, arg, value) => { root.displays-act(verb, arg, value); }
                        drop(i, x, y) => { root.displays-drop(i, x, y); }
                        snap(i, x, y, threshold, free) => { return root.displays-snap(i, x, y, threshold, free); }
                    }
                    if root.page == "keyboard": KeyboardPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        view: root.keyboard;
                        act(verb, arg, value) => { root.input-act(verb, arg, value); }
                    }
                    if root.page == "mouse": MousePage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        view: root.mouse;
                        act(verb, arg, value) => { root.input-act(verb, arg, value); }
                    }
                    if root.page == "sound": SoundPage {
                        vertical-stretch: 1;
                        compact: root.compact;
                        page: root.sound;
                        tab <=> root.sound-tab;
                        act(verb, id, value) => { root.sound-act(verb, id, value); }
                    }
                    if root.page == "settings": SettingsHero {
                        compact: root.compact;
                        sub: "Saved to " + root.config-path;
                        wallpaper-in-use: root.ap-wallpaper-in-use;
                        name: root.ap-name;
                        name-text: root.ap-name-text;
                        chips: root.ap-chips;
                    }
                    if root.page == "settings": settings-scroll := Scroll {
                        // Wide enough for the colour files beside the rest.
                        property <bool> two-columns: self.width >= 1240px;
                        // The columns follow its width, so its least width can't follow them; one
                        // column fits the smallest window.
                        min-width: 0;
                        vertical-stretch: 1;
                        bar-inset: -16px;
                        // As tall as its settings.
                        settings-card := Card {
                            HorizontalLayout {
                                padding: 22px;
                                padding-top: 10px;
                                spacing: 40px;
                                alignment: start;
                                VerticalLayout {
                                    preferred-width: 720px;
                                    max-width: 720px;
                                    horizontal-stretch: 1;
                                    alignment: start;
                                    SectionLabel { text: "APPEARANCE"; height: 30px; vertical-alignment: bottom; }
                                    AppearanceSettings {
                                        follow: root.ap-follow;
                                        follow-available: root.ap-follow-available;
                                        wallpaper-in-use: root.ap-wallpaper-in-use;
                                        swatches: root.ap-swatches;
                                        note: root.ap-note;
                                        mode: root.ap-mode;
                                        gradient: root.ap-gradient;
                                        follow-toggled => { root.ap-act("follow", 0); keys.focus(); }
                                        theme-chosen(i) => { root.ap-act("theme", i); keys.focus(); }
                                        mode-chosen(i) => { root.ap-act("mode", i); keys.focus(); }
                                        gradient-toggled => { root.ap-act("gradient", 0); keys.focus(); }
                                    }
                                    if !settings-scroll.two-columns: VerticalLayout {
                                        SettingRow { label: "Colour files"; description: "Read in order; the first usable one wins"; }
                                        ColourFiles { sources: root.sources; config-path: root.config-path; }
                                    }
                                    SectionLabel { text: "GENERAL"; height: 46px; vertical-alignment: bottom; }
                                    for o[i] in root.options: SettingRow {
                                        label: o.label;
                                        description: o.sub;
                                        first: i == 0;
                                        Switch { on: o.on; label: o.label; focus-key: "option:" + o.id; toggled => { root.option-toggled(o.id); } }
                                    }
                                    SectionLabel { text: "PASSWORDS"; height: 46px; vertical-alignment: bottom; }
                                    // Where they're kept: something to know, not a setting.
                                    HorizontalLayout {
                                        padding-top: 6px;
                                        spacing: 8px;
                                        VerticalLayout { alignment: start; padding-top: 1px; Icon { name: "info"; tint: Theme.faint; size: 14px; } }
                                        Text { text: "Passwords \"for me only\": " + root.keyring-label + "."; color: Theme.muted; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                                    }
                                }
                                if settings-scroll.two-columns: VerticalLayout {
                                    preferred-width: 720px;
                                    max-width: 720px;
                                    horizontal-stretch: 1;
                                    alignment: start;
                                    SectionLabel { text: "COLOUR FILES"; height: 30px; vertical-alignment: bottom; }
                                    Text { text: "Read in order; the first usable one wins"; color: Theme.faint; font-size: 12px; height: 30px; vertical-alignment: center; }
                                    ColourFiles { sources: root.sources; config-path: root.config-path; }
                                }
                            }
                        }
                    }
                }
                // Keyboard hints: only the keys that work on the page and in its state (Rust
                // works them out).
                Rectangle {
                    height: 30px;
                    background: Theme.bg;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: 16px;
                        spacing: 18px;
                        alignment: start;
                        for h in root.hints: Kbd { key: h.key; label: h.label; }
                        // Lets the bar (and so the window) grow wider than its hints.
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    // A dialog that closes takes the keyboard focus with it, and not every dialog closes through
    // its own buttons (the time after Apply runs out, NetworkManager withdraws its question, a
    // choice in "Add a connection" opens the editor): the window's keys get it back, and then the
    // control that had the focus before the dialog opened, if there was one.
    property <bool> modal-open: root.confirm-open || root.join-open || root.add-open || root.hostname-open || root.share-open
        || root.bt-pair-open || root.bt-adapter-open || root.bt-rename-open || root.files.sending || root.files.incoming
        || (root.page == "displays" && (root.displays.keep-open || root.displays.config-open))
        || (root.page == "keyboard" && root.keyboard.add-open) || (root.page == "mouse" && root.mouse.own-open);
    changed modal-open => { if !self.modal-open { keys.focus(); Focus.give-back(); } }

    // The control with the focus can go away (a dialog closes, a button isn't offered any more),
    // and Slint drops the focus with it: no key would arrive anywhere. While a control has the
    // focus, it answers these probes; when one goes unanswered, the window takes the focus.
    Timer {
        interval: 150ms;
        running: Focus.on-control;
        triggered => {
            if Focus.answer != Focus.probe {
                Focus.on-control = false;
                Focus.key = "";
                if root.editor-open { editor.take-focus(); } else { keys.focus(); }
            }
            Focus.probe += 1;
        }
    }

    // The confirmation dialog, over everything. Nothing is typed in it, so a click beside it
    // cancels it.
    if root.confirm-open: Modal {
        card-width: 420px;
        label: root.confirm-title;
        backdrop-dismisses: true;
        dismissed => { root.confirm-cancelled(); keys.focus(); }
        Text { text: root.confirm-title; color: Theme.text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
        Text { text: root.confirm-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            padding-top: 6px;
            spacing: 8px;
            alignment: end;
            Button { label: "Cancel"; button-height: 36px; clicked => { root.confirm-cancelled(); keys.focus(); } }
            Button { label: root.confirm-button; kind: root.confirm-destructive ? "destructive" : "primary"; button-height: 36px; clicked => { root.confirm-accepted(); keys.focus(); } }
        }
    }

    if root.join-open: JoinDialog {
        mode: root.join-mode;
        title: root.join-title;
        subtitle: root.join-subtitle;
        error: root.join-error;
        securities: root.join-securities;
        password-hints: root.join-password-hints;
        storage-hints: root.join-storage-hints;
        name <=> root.join-name;
        security <=> root.join-security;
        password <=> root.join-password;
        storage <=> root.join-storage;
        autoconnect <=> root.join-autoconnect;
        valid: root.join-check(root.join-mode, root.join-name, root.join-security, root.join-password);
        accepted => { root.join-accepted(); keys.focus(); }
        cancelled => { root.join-cancelled(); keys.focus(); }
    }

    // The editor covers the card it was opened from (the owner, 2026-11-06: "lets just make it
    // cover the card it was called from"): the details card for Edit and the pane's other
    // buttons, while the card is as wide as the editor's form needs (24 px padding on each
    // side, the 168 px labels and the 520 px port list, its widest control: 736 px). Otherwise,
    // and when opened from the hero or the list, it covers the page under the hero. The sidebar
    // and the hero stay in sight but take no clicks, as when the editor covered them.
    property <Area> page-area;
    property <Area> details-area;
    // Set by the details pane's buttons, cleared by the other ways in, and noted when it opens.
    property <bool> editor-from-details;
    property <bool> editor-opened-from-details;
    property <bool> editor-in-details: root.editor-opened-from-details && root.has-details && root.details-area.width >= 736px;
    // The page scrolls: only the part of the details card in sight.
    property <length> details-top: max(root.details-area.y, root.page-area.y);
    property <Area> editor-area: !root.network-page
        ? { x: page-body.absolute-position.x + 22px, y: page-body.absolute-position.y + 18px, width: page-body.width - 44px, height: page-body.height - 36px }
        : !root.editor-in-details ? root.page-area
        : { x: root.details-area.x, y: root.details-top, width: root.details-area.width,
            height: min(root.details-area.y + root.details-area.height, root.page-area.y + root.page-area.height) - root.details-top };
    changed editor-open => {
        if self.editor-open {
            root.editor-opened-from-details = root.editor-from-details;
            root.editor-from-details = false;
            // As a dialog does (FocusTrap), so the control that opened it gets the focus back.
            Focus.opener = Focus.on-control ? Focus.serial : 0;
            Focus.opener-key = Focus.on-control ? Focus.key : "";
            editor.take-focus();
        } else {
            keys.focus();
            Focus.give-back();
        }
    }
    // It sweeps in from the right of its card. The slide is a fraction of the card's width, not
    // a position: an animated x would trail behind a resize and show the closed editor in the
    // window's new space.
    property <float> editor-slide: root.editor-open ? 0 : 1;
    animate editor-slide { duration: 220ms; easing: ease-out; }
    editor := Editor {
        width: root.width;
        height: root.height;
        visible: root.editor-slide < 1;
        slide: root.editor-slide;
        card-x: root.editor-area.x;
        card-y: root.editor-area.y;
        card-width: root.editor-area.width;
        card-height: root.editor-area.height;
        title: root.editor-title;
        subtitle: root.editor-subtitle;
        tabs: root.editor-tabs;
        tab <=> root.editor-tab;
        form <=> root.editor-form;
        errors: root.editor-errors;
        options: root.editor-options;
        dirty: root.editor-dirty;
        valid: root.editor-valid;
        busy: root.editor-busy;
        new: root.editor-new;
        footer: root.editor-footer;
        footer-tone: root.editor-footer-tone;
        routes-open: root.editor-routes;
        ports-open: root.editor-ports-open;
        port-chosen(interface) => { root.editor-port-chosen(interface); }
        back => { root.editor-back(); }
        apply => { root.editor-apply(); }
        revert => { root.editor-revert(); }
        form-edited => { root.editor-edited(); }
        add-row(what) => { root.editor-add-row(what); }
        remove-row(what, i) => { root.editor-remove-row(what, i); }
        add-dns(family) => { root.editor-add-dns(family); }
        edit-routes(family) => { root.editor-edit-routes(family); }
        routes-done(keep) => { root.editor-routes-done(keep); }
        choose-file(field) => { root.editor-choose-file(field); }
        wg-generate => { root.editor-wg-generate(); }
        wg-show-key => { root.editor-wg-show-key(); }
        wg-export => { root.editor-wg-export(); }
        add-allowed(i) => { root.editor-add-allowed(i); }
    }

    if root.add-open: add-modal := Modal {
        card-width: min(760px, self.width - 32px);
        label: "Add a connection";
        backdrop-dismisses: true;
        dismissed => { root.add-cancelled(); keys.focus(); }
        Text { text: "Add a connection"; color: Theme.text; font-size: 17px; font-weight: 600; }
        for group in [
            { title: "NETWORKS", kinds: [
                { id: "wifi", icon: "wifi", title: "Wi-Fi", text: "Hidden and Enterprise (802.1X) too", ready: true },
                { id: "wired", icon: "wired", title: "Wired", text: "Ethernet, DHCP or static", ready: true },
                { id: "hotspot", icon: "hotspot", title: "Hotspot", text: "Share a connection over Wi-Fi", ready: true },
            ] },
            { title: "VPN", kinds: [
                { id: "wireguard", icon: "vpn", title: "WireGuard", text: "Built in. Empty or from a .conf", ready: true },
                { id: "openvpn", icon: "vpn", title: "OpenVPN", text: "By hand or from an .ovpn", ready: true },
                { id: "openconnect", icon: "vpn", title: "AnyConnect", text: "Cisco, with Microsoft 365 sign‑in too", ready: true },
                { id: "import", icon: "saved", title: "Import…", text: "A .conf, an .ovpn, or your openconnect-saml profiles", ready: true },
            ] },
            { title: "VIRTUAL INTERFACES", kinds: [
                { id: "vlan", icon: "vlan", title: "VLAN", text: "A tagged network on a wired device", ready: true },
                { id: "bridge", icon: "bridge", title: "Bridge", text: "Join devices into one network, e.g. for VMs", ready: true },
                { id: "bond", icon: "bond", title: "Bond", text: "Combine devices for failover or speed", ready: true },
            ] },
        ]: VerticalLayout {
            spacing: 10px;
            SectionLabel { text: group.title; }
            HorizontalLayout {
                spacing: 10px;
                for kind in group.kinds: Focusable {
                    // Equal widths, and as tall as the text needs.
                    width: (add-modal.card-width - 48px - (group.kinds.length - 1) * 10px) / group.kinds.length;
                    min-height: max(76px, tile-text.min-height);
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border2;
                    enabled: kind.ready;
                    background: self.has-hover ? Theme.hover : transparent;
                    opacity: kind.ready ? 1 : 0.5;
                    accessible-role: button;
                    accessible-label: kind.title;
                    accessible-enabled: kind.ready;
                    accessible-action-default => { if kind.ready { root.add-chosen(kind.id); } }
                    activated => { root.add-chosen(kind.id); }
                    tile-text := HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        VerticalLayout { alignment: start; Icon { name: kind.icon; tint: Theme.accent; } }
                        VerticalLayout {
                            spacing: 3px;
                            alignment: start;
                            Text { text: kind.title; color: Theme.text; font-weight: 600; font-size: 14px; wrap: word-wrap; }
                            Text { text: kind.text; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-top: 6px;
            alignment: end;
            Button { label: "Cancel"; button-height: 36px; clicked => { root.add-cancelled(); keys.focus(); } }
        }
    }

    if root.hostname-open: Modal {
        card-width: 420px;
        card-spacing: 12px;
        label: "Hostname";
        dismissed => { root.hostname-cancelled(); keys.focus(); }
        Text { text: "Hostname"; color: Theme.text; font-size: 17px; font-weight: 600; }
        Text { text: "The computer's name on the network. Changing it needs an admin password."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
        TextField {
            text <=> root.hostname-input;
            mono: true;
            autofocus: true;
            label: "Hostname";
            invalid: root.hostname-error != "";
            accepted => { if root.hostname-error == "" { root.hostname-save(); keys.focus(); } }
        }
        if root.hostname-error != "": Text { text: root.hostname-error; color: Theme.danger; font-size: 12px; }
        HorizontalLayout {
            padding-top: 6px;
            spacing: 8px;
            alignment: end;
            Button { label: "Cancel"; button-height: 36px; clicked => { root.hostname-cancelled(); keys.focus(); } }
            Button { label: "Save"; kind: "primary"; button-height: 36px; enabled: root.hostname-error == ""; clicked => { root.hostname-save(); keys.focus(); } }
        }
    }

    if root.share-open: Modal {
        card-width: 400px;
        label: root.share-title;
        backdrop-dismisses: true;
        dismissed => { root.share-closed(); keys.focus(); }
        VerticalLayout {
            spacing: 3px;
            Text { text: root.share-title; color: Theme.text; font-size: 17px; font-weight: 600; }
            Text { text: "Scan with a phone camera to join."; color: Theme.muted; font-size: 13px; }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 264px;
                height: 264px;
                border-radius: 14px;
                background: white;
                Image { source: root.share-qr; width: 240px; height: 240px; image-rendering: pixelated; }
            }
        }
        if root.share-password != "": HorizontalLayout {
            spacing: 12px;
            Text { text: "Password"; color: Theme.muted; font-size: 13px; width: 90px; vertical-alignment: center; }
            Rectangle {
                height: 30px;
                horizontal-stretch: 1;
                TextInput { text: root.share-password; read-only: true; color: Theme.text; font-family: "JetBrains Mono"; font-size: 13px; vertical-alignment: center; single-line: true; }
            }
        }
        HorizontalLayout {
            padding-top: 4px;
            alignment: end;
            Button { label: "Close"; button-height: 36px; clicked => { root.share-closed(); keys.focus(); } }
        }
    }

    if root.page == "displays" && root.displays.keep-open: KeepDialog {
        view: root.displays;
        keep => { root.displays-act("keep", "", 0); keys.focus(); }
        revert => { root.displays-act("revert-now", "", 0); keys.focus(); }
    }
    if root.page == "displays" && root.displays.config-open: ConfigDialog {
        view: root.displays;
        closed => { root.displays-act("close-config", "", 0); keys.focus(); }
    }
    if root.page == "keyboard" && root.keyboard.add-open: AddLayoutDialog {
        view: root.keyboard;
        query(text) => { root.input-act("add-query", text, 0); }
        add(i) => { root.input-act("add", "" + i, 0); keys.focus(); }
        closed => { root.input-act("add-close", "", 0); keys.focus(); }
    }
    if root.page == "mouse" && root.mouse.own-open: OwnSettingsDialog {
        view: root.mouse;
        pick(name) => { root.input-act("own", name, 0); keys.focus(); }
        closed => { root.input-act("own-close", "", 0); keys.focus(); }
    }
    if root.files.sending: SendFilesDialog {
        view: root.files;
        cancel => { root.files-act("cancel"); keys.focus(); }
        hide => { root.files-act("hide"); keys.focus(); }
    }
    if root.files.incoming: IncomingFileDialog {
        view: root.files;
        always <=> root.files-always;
        accept => { root.files-act("accept"); keys.focus(); }
        decline => { root.files-act("decline"); keys.focus(); }
    }
    if root.bt-pair-open: BtPairDialog {
        pair: root.bt-pair;
        code <=> root.bt-pair-code;
        always <=> root.bt-pair-always;
        accepted => { root.bt-act("pair-accept", ""); keys.focus(); }
        cancelled => { root.bt-act("pair-cancel", ""); keys.focus(); }
    }
    if root.bt-adapter-open: BtAdapterDialog {
        adapter: root.bt-adapter-label;
        pairable <=> root.bt-pairable;
        name <=> root.bt-adapter-name;
        visible-choice <=> root.bt-visible-choice;
        saved => { root.bt-act("adapter-save", ""); keys.focus(); }
        cancelled => { root.bt-act("adapter-close", ""); keys.focus(); }
    }
    if root.bt-rename-open: BtRenameDialog {
        title: root.bt-rename-title;
        hint: root.bt-rename-hint;
        name <=> root.bt-rename-name;
        saved => { root.bt-act("rename-save", ""); keys.focus(); }
        cancelled => { root.bt-act("rename-cancel", ""); keys.focus(); }
    }
}
