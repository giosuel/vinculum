// The colours, set from Rust (src/theme.rs): the built-in theme, or the first usable colour
// source in config.toml. The defaults are the built-in dark theme.

export global Theme {
    in-out property <color> bg: #111315;
    in-out property <color> panel: #17191c;
    in-out property <color> surface: #1b1e21;
    in-out property <color> border: #262a2f;
    in-out property <color> border2: #2a2e33;
    in-out property <color> ctrl-border: #353a40;
    in-out property <color> ctrl-bg: #23272b;
    in-out property <color> input-bg: #1f2226;
    in-out property <color> text: #e8eaed;
    in-out property <color> muted: #a0a7af;
    in-out property <color> faint: #8b929a;
    in-out property <color> icon-soft: #c9ced4;
    in-out property <color> accent: #5cc8b0;
    in-out property <color> on-accent: #0c1513;
    in-out property <color> accent-soft-bg: #1f2a27;
    in-out property <color> accent-soft-border: #2c4a42;
    in-out property <color> off-track: #3a3f46;
    in-out property <color> knob-off: #c9ced4;
    in-out property <color> bar-off: #3a3f46;
    in-out property <color> sel-bg: #23272b;
    in-out property <color> danger: #f08a7a;
    in-out property <color> warn-bg: #2a2518;
    in-out property <color> warn-border: #5a4c25;
    in-out property <color> warn-text: #e9cf8f;
    /// The accent glow behind a page's hero, and whether to draw it.
    in-out property <color> glow: #173a33;
    in-out property <bool> gradient: true;

    // A tone name from Rust ("accent", "danger", "muted", "faint") as a colour.
    public pure function tone(name: string) -> color {
        if name == "accent" { return accent; }
        if name == "danger" { return danger; }
        if name == "faint" { return faint; }
        if name == "text" { return text; }
        return muted;
    }
}
