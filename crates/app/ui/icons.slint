// Line icons on a 16×16 grid, the same paths as in the mockups.
import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.muted;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: tint;
    stroke-width: 1.5px;
    fill: transparent;
    commands: name == "wifi" ? "M2 6.5a9 9 0 0 1 12 0M4.2 9a6 6 0 0 1 7.6 0M6.4 11.4a3 3 0 0 1 3.2 0M7.6 13.4a0.4 0.4 0 1 0 0.8 0a0.4 0.4 0 1 0 -0.8 0"
        : name == "wifi-off" ? "M2 6.5a9 9 0 0 1 12 0M4.2 9a6 6 0 0 1 7.6 0M6.4 11.4a3 3 0 0 1 3.2 0M2.5 2.5l11 11"
        : name == "wired" ? "M3 3.5h10v8h-10zM6 11.5v-2M8 11.5v-2M10 11.5v-2M8 11.5v2"
        : name == "vpn" ? "M8 2l5 2v4c0 3-2.2 5-5 6-2.8-1-5-3-5-6V4z"
        : name == "vlan" ? "M2 5h12v6h-12zM5 5V3M11 5V3M8 11v2"
        : name == "bridge" ? "M2 11h12M3 11V7M13 11V7M3 7c2-3 8-3 10 0M6 11V8M10 11V8"
        : name == "bond" ? "M2 3h5v10h-5zM9 3h5v10h-5zM7 6h2M7 10h2"
        : name == "port" ? "M5 3v5.5a2 2 0 0 0 2 2h6M10.5 8l2.5 2.5-2.5 2.5"
        : name == "hotspot" ? "M6.6 8a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0 -2.8 0M5.2 5.2a4 4 0 0 0 0 5.6M10.8 5.2a4 4 0 0 1 0 5.6M3.2 3.2a6.8 6.8 0 0 0 0 9.6M12.8 3.2a6.8 6.8 0 0 1 0 9.6"
        : name == "saved" ? "M3 4h10M3 8h10M3 12h6"
        : name == "settings" ? "M3 4.5h6M12 4.5h1M3 11.5h1M7 11.5h6M9 4.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0M4 11.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0"
        : name == "lock" ? "M3.5 7h9v6.5h-9zM5.5 7V5a2.5 2.5 0 0 1 5 0v2"
        : name == "search" ? "M2.8 7a4.2 4.2 0 1 0 8.4 0a4.2 4.2 0 1 0 -8.4 0M10.2 10.2l3.3 3.3"
        : name == "rescan" ? "M13 8a5 5 0 1 1-1.5-3.5M13 2.5v2.5h-2.5"
        : name == "plane" ? "M7 2.5c0-0.8 0.4-1.2 1-1.2s1 0.4 1 1.2V6l5 3v1.5L9 9v3l1.5 1.2v1.1L8 13.6l-2.5 0.7v-1.1L7 12V9l-5 1.5V9l5-3z"
        : name == "warning" ? "M8 2l6.5 11.5h-13zM8 6.5v3M8 11.6v0.2"
        : name == "error" ? "M2 8a6 6 0 1 0 12 0a6 6 0 1 0 -12 0M8 4.8v3.6M8 11v0.2"
        : name == "plus" ? "M8 3v10M3 8h10"
        : name == "eye" ? "M1.5 8c1.6-3 3.8-4.5 6.5-4.5s4.9 1.5 6.5 4.5c-1.6 3-3.8 4.5-6.5 4.5S3.1 11 1.5 8zM6 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
        : name == "eye-off" ? "M1.5 8c1.6-3 3.8-4.5 6.5-4.5s4.9 1.5 6.5 4.5c-1.6 3-3.8 4.5-6.5 4.5S3.1 11 1.5 8zM6 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M2.5 2.5l11 11"
        : name == "check" ? "M3.5 8.5l3 3 6-7"
        : name == "chevron" ? "M4.5 6l3.5 3.5 3.5-3.5"
        : name == "close" ? "M4 4l8 8M12 4l-8 8"
        : name == "bluetooth" ? "M4.5 5l7 6L8 14V2l3.5 3-7 6"
        : name == "bluetooth-off" ? "M4.5 5l3.5 3M11.5 11L8 14V8M8 5.3V2l3.5 3-1.8 1.6M2.5 2.5l11 11"
        : name == "headphones" ? "M2.5 11V8.5a5.5 5.5 0 0 1 11 0V11M3.5 9.5h1a1 1 0 0 1 1 1v2.5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-2.5a1 1 0 0 1 1-1zM11.5 9.5h1a1 1 0 0 1 1 1v2.5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-2.5a1 1 0 0 1 1-1z"
        : name == "phone" ? "M5.9 1.5h4.2a1.4 1.4 0 0 1 1.4 1.4v10.2a1.4 1.4 0 0 1-1.4 1.4h-4.2a1.4 1.4 0 0 1-1.4-1.4V2.9a1.4 1.4 0 0 1 1.4-1.4zM7.2 12.4h1.6"
        : name == "mouse" ? "M8 1.5a3.5 3.5 0 0 1 3.5 3.5v6a3.5 3.5 0 0 1-7 0V5a3.5 3.5 0 0 1 3.5-3.5zM8 1.5v4"
        : name == "speaker" ? "M5.6 1.5h4.8a1.6 1.6 0 0 1 1.6 1.6v9.8a1.6 1.6 0 0 1-1.6 1.6h-4.8a1.6 1.6 0 0 1-1.6-1.6V3.1a1.6 1.6 0 0 1 1.6-1.6zM5.7 9.8a2.3 2.3 0 1 0 4.6 0a2.3 2.3 0 1 0 -4.6 0M8 4.6h0.01"
        : name == "keyboard" ? "M2.8 4h10.4a1.3 1.3 0 0 1 1.3 1.3v5.9a1.3 1.3 0 0 1-1.3 1.3H2.8a1.3 1.3 0 0 1-1.3-1.3V5.3A1.3 1.3 0 0 1 2.8 4zM4 6.8h0.2M6.4 6.8h0.2M8.8 6.8h0.2M11.2 6.8h0.2M5 9.8h6"
        : name == "car" ? "M2.5 10.5V8l1.6-3.6a1.2 1.2 0 0 1 1.1-0.7h5.6a1.2 1.2 0 0 1 1.1 0.7L13.5 8v2.5a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1zM2.5 8h11M4.5 11.5v1.5M11.5 11.5v1.5"
        : name == "computer" ? "M3.2 2.5h9.6a1.2 1.2 0 0 1 1.2 1.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2a1.2 1.2 0 0 1-1.2-1.2V3.7a1.2 1.2 0 0 1 1.2-1.2zM5.5 14h5M8 11.5V14"
        : name == "gamepad" ? "M5 5h6a3.5 3.5 0 0 1 0 7c-1 0-1.6-0.6-2.2-1.4H7.2C6.6 11.4 6 12 5 12a3.5 3.5 0 0 1 0-7zM5 7.2v2.4M3.8 8.4h2.4M10.6 8h0.01M11.8 9.2h0.01"
        : name == "gear" ? "M6 8a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M8 1.8v1.6M8 12.6v1.6M1.8 8h1.6M12.6 8h1.6M3.6 3.6l1.1 1.1M11.3 11.3l1.1 1.1M3.6 12.4l1.1-1.1M11.3 4.7l1.1-1.1"
        : name == "pencil" ? "M10.5 2.8l2.7 2.7L6 12.7 2.8 13.2l0.5-3.2z"
        : name == "globe" ? "M2 8a6 6 0 1 0 12 0a6 6 0 1 0 -12 0M2 8h12M8 2c1.8 1.7 2.6 3.8 2.6 6S9.8 12.3 8 14c-1.8-1.7-2.6-3.8-2.6-6S6.2 3.7 8 2z"
        : name == "upload" ? "M8 11V2.5M4.8 5.7L8 2.5l3.2 3.2M2.5 10.5v2a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-2"
        : name == "file" ? "M4 1.8h5l3 3v9.4H4zM9 1.8v3h3"
        : name == "palette" ? "M8 2a6 6 0 1 0 0 12c0.9 0 1.4-0.6 1.4-1.3 0-0.8-0.7-1.2-0.7-2 0-0.7 0.6-1.2 1.3-1.2H12a2 2 0 0 0 2-2C14 4.5 11.3 2 8 2zM4.4 7.6a0.7 0.7 0 1 0 1.4 0a0.7 0.7 0 1 0 -1.4 0M6.6 4.9a0.7 0.7 0 1 0 1.4 0a0.7 0.7 0 1 0 -1.4 0M9.8 5.3a0.7 0.7 0 1 0 1.4 0a0.7 0.7 0 1 0 -1.4 0"
        : name == "volume" ? "M2.5 6h2.5l3.5-3v10L5 10H2.5zM11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.5a6.3 6.3 0 0 1 0 9"
        : name == "volume-off" ? "M2.5 6h2.5l3.5-3v10L5 10H2.5zM11 6l3.5 4M14.5 6L11 10"
        : name == "mic" ? "M6 2.8a2 2 0 0 1 4 0v4.4a2 2 0 0 1-4 0zM3.8 7.2a4.2 4.2 0 0 0 8.4 0M8 11.4v2.8M5.6 14.2h4.8"
        : name == "mic-off" ? "M6 2.8a2 2 0 0 1 4 0v4.4a2 2 0 0 1-4 0zM3.8 7.2a4.2 4.2 0 0 0 8.4 0M8 11.4v2.8M5.6 14.2h4.8M2.5 2.5l11 11"
        : name == "app" ? "M3 3h4v4H3zM9 3h4v4H9zM3 9h4v4H3zM9 9h4v4H9z"
        : name == "tv" ? "M2.5 3h11v8h-11zM5.5 14h5M8 11v3"
        : name == "monitor" ? "M3.2 2.5h9.6a1.2 1.2 0 0 1 1.2 1.2v6.6a1.2 1.2 0 0 1-1.2 1.2H3.2a1.2 1.2 0 0 1-1.2-1.2V3.7a1.2 1.2 0 0 1 1.2-1.2zM5.5 14h5M8 11.5V14"
        : "";
}

/// Four signal bars, `bars` of them lit.
export component SignalBars inherits HorizontalLayout {
    in property <int> bars;
    spacing: 2px;
    alignment: start;
    width: 20px;
    height: 14px;
    for i in 4: Rectangle {
        y: parent.height - self.height;
        width: 3px;
        height: (4 + i * 3) * 1px;
        border-radius: 1px;
        background: i < root.bars ? Theme.accent : Theme.bar-off;
    }
}

/// The node-cube logo, drawn in the theme's colours.
export component Logo inherits Rectangle {
    in property <length> size: 28px;
    width: size;
    height: size;
    // Back edges and spokes first, dim; then the lit front edges; nodes on top.
    Path {
        width: 100%; height: 100%;
        viewbox-width: 64; viewbox-height: 64;
        stroke: Theme.accent-soft-border; stroke-width: 1.6px; fill: transparent;
        commands: "M32 32L13.3 21.2M32 32L50.7 21.2M32 32L32 53.6M32 32L13.3 42.8M32 32L50.7 42.8M32 32L32 10.4";
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 64; viewbox-height: 64;
        stroke: Theme.accent; stroke-width: 3px; fill: transparent; stroke-line-cap: round;
        commands: "M32 10.4L50.7 21.2L50.7 42.8L32 53.6L13.3 42.8L13.3 21.2Z";
    }
    for p in [{x: 32, y: 10.4}, {x: 50.7, y: 21.2}, {x: 50.7, y: 42.8}, {x: 32, y: 53.6}, {x: 13.3, y: 42.8}, {x: 13.3, y: 21.2}]: Rectangle {
        x: (p.x - 3.4) / 64 * root.width;
        y: (p.y - 3.4) / 64 * root.height;
        width: 6.8 / 64 * root.width;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
    }
    Rectangle {
        x: (32 - 5) / 64 * root.width;
        y: (32 - 5) / 64 * root.height;
        width: 10 / 64 * root.width;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.text;
    }
}

/// A battery outline, filled to `percent`.
export component Battery inherits Rectangle {
    in property <int> percent;
    in property <color> tint: Theme.muted;
    width: 18px;
    height: 10px;
    Rectangle {
        x: 0.75px;
        y: 0.75px;
        width: 14px;
        height: 8.5px;
        border-radius: 2px;
        border-width: 1.2px;
        border-color: root.tint;
    }
    Rectangle { x: 15.6px; y: 3.2px; width: 1.6px; height: 3.6px; border-radius: 0.6px; background: root.tint; }
    Rectangle { x: 2.5px; y: 2.5px; width: 10px * clamp(root.percent, 5, 100) / 100; height: 5px; border-radius: 1px; background: root.tint; }
}

/// A turning arc: something is in progress.
export component Spinner inherits Rectangle {
    in property <length> size: 12px;
    in property <color> tint: Theme.accent;
    width: size;
    height: size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.border2;
        stroke-width: 2px;
        fill: transparent;
        commands: "M2 8a6 6 0 1 0 12 0a6 6 0 1 0 -12 0";
    }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        commands: "M8 2a6 6 0 0 1 6 6";
        transform-rotation: mod(animation-tick() / 2.5ms, 360) * 1deg;
    }
}
