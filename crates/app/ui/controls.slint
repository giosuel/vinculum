// Buttons, switches and the small pieces the pages are built from, styled like the mockups.
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

/// The keyboard focus, shared by every control. `key` names the control that has it, so that a
/// control Slint rebuilds (every row of a list Rust sends again) takes it back; `keyboard` says
/// it came from the keyboard, which is when the ring shows. `on-control`, `probe` and `answer`
/// let the window notice that the control with the focus is gone (see MainWindow).
export global Focus {
    in-out property <string> key;
    in-out property <bool> keyboard;
    in-out property <bool> on-control;
    in-out property <int> probe;
    in-out property <int> answer;
    /// Counts the times a control gained the focus; each control keeps its number, so that a
    /// dialog can give the focus back to the one that had it when it opened (`opener`, noted by
    /// FocusTrap). `back-to` and `back-key` call that control, or its rebuilt copy.
    in-out property <int> serial;
    in-out property <int> opener;
    in-out property <string> opener-key;
    in-out property <int> back-to;
    in-out property <string> back-key;
    /// Moves the focus on as Tab (true) or Shift+Tab (false) would: Rust presses the key.
    callback step(bool);
    /// A dialog closed: the control that had the focus before it opened takes it back.
    public function give-back() {
        self.back-to = self.opener;
        self.back-key = self.opener-key;
        self.opener = 0;
        self.opener-key = "";
    }
}

/// What every control the keyboard reaches is built on: Tab and Shift+Tab reach it, Space and
/// Enter activate it (as a click does), and a 2 px accent ring 2 px outside it shows the focus.
/// The ring is only for focus from the keyboard: a click doesn't move the focus, and hides it.
export component Focusable inherits Rectangle {
    in property <bool> enabled: true;
    /// Set on a control in a `for`: the rebuilt control with the same key gets the focus back.
    in property <string> focus-key;
    /// A second key, for the selected row of a list: when the arrow keys move the selection,
    /// the newly selected row takes the focus.
    in property <string> selected-key;
    /// The gap between the control and its ring. -2px draws the ring on its edge, for rows that
    /// fill a list, which would cut off a ring outside them.
    in property <length> ring-gap: 2px;
    /// False when the control handles the pointer itself (a slider, the options of a segmented
    /// control).
    in property <bool> clickable: true;
    /// False for a control Tab passes over, which the arrow keys reach instead (the sidebar's
    /// pages but one).
    in property <bool> tab-stop: true;
    out property <bool> has-focus: scope.has-focus;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    /// A click, Space or Enter.
    callback activated();
    /// Any other key, before Space and Enter; `accept` if it was used.
    callback key(KeyEvent) -> EventResult;
    forward-focus: scope;
    init => {
        if (root.focus-key != "" && Focus.key == root.focus-key) || (root.selected-key != "" && Focus.key == root.selected-key) {
            scope.focus();
        }
    }
    // Answers the window's probes while this control has the focus. (No `if` element: one per
    // control makes the generated code too big to compile in 8 GB.)
    property <int> probe: scope.has-focus ? Focus.probe : -1;
    changed probe => { if scope.has-focus { Focus.answer = self.probe; } }
    // Its number from the last time it gained the focus (Focus.serial).
    property <int> serial;
    property <bool> called-back: Focus.back-to != 0 && (Focus.back-to == root.serial || (root.focus-key != "" && Focus.back-key == root.focus-key));
    changed called-back => { if self.called-back { scope.focus(); } }
    scope := FocusScope {
        enabled: root.enabled;
        focus-on-tab-navigation: root.tab-stop;
        // A click doesn't take the focus from the page, so the window's shortcuts keep working.
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation { Focus.keyboard = true; }
            Focus.key = root.focus-key;
            Focus.serial += 1;
            root.serial = Focus.serial;
            Focus.back-to = 0;
            Focus.back-key = "";
            Focus.on-control = true;
            Focus.answer = Focus.probe;
        }
        focus-lost(reason) => {
            if reason != FocusReason.window-activation && Focus.key == root.focus-key { Focus.key = ""; }
            Focus.on-control = false;
        }
        key-pressed(event) => {
            if root.key(event) == EventResult.accept { return accept; }
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if event.text == " " || event.text == Key.Return {
                root.activated();
                // What it did may have given the window the focus (as a click does); a keyboard
                // user carries on from here.
                scope.focus();
                return accept;
            }
            reject
        }
    }
    // Under the children, so that a button in a row still gets its own clicks.
    touch := TouchArea {
        enabled: root.enabled && root.clickable;
        mouse-cursor: pointer;
        pointer-event(event) => { if event.kind == PointerEventKind.down { Focus.keyboard = false; } }
        clicked => { root.activated(); }
    }
    @children
    ring := Rectangle {
        visible: scope.has-focus && Focus.keyboard;
        x: -root.ring-gap - 2px;
        y: self.x;
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius == 0 ? 0 : root.border-radius - self.x;
    }
}

/// A dialog's card. Tab and Shift+Tab stay among its controls, going round from the last to the
/// first and back, instead of on to the page behind the dialog. Slint has no such scope, so two
/// empty stops, before and after the controls, catch the focus as it leaves and send it round:
/// the stop at the other end takes it, and Rust presses Tab again from there (Focus.step).
/// When the card opens, it notes the control with the focus, for Focus.give-back().
export component FocusTrap inherits Rectangle {
    // Which way the last Tab in the card went.
    property <bool> backward;
    init => {
        Focus.opener = Focus.on-control ? Focus.serial : 0;
        Focus.opener-key = Focus.on-control ? Focus.key : "";
    }
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                root.backward = event.text == Key.Backtab || event.modifiers.shift;
            }
            reject
        }
        // Only a stop going backwards, past the first control, and `end` only going forwards.
        start := FocusScope {
            width: 0;
            height: 0;
            focus-on-click: false;
            focus-on-tab-navigation: root.backward;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    end.focus();
                    Focus.step(false);
                }
            }
        }
        @children
        end := FocusScope {
            width: 0;
            height: 0;
            focus-on-click: false;
            focus-on-tab-navigation: !root.backward;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    start.focus();
                    Focus.step(true);
                }
            }
        }
    }
}

/// kind: "primary", "secondary", "danger" (red text) or "destructive" (red button).
export component Button inherits Focusable {
    in property <string> label;
    in property <string> kind: "secondary";
    in property <length> button-height: 34px;
    callback clicked();
    height: button-height;
    // Shrinks (eliding the label) before it makes a narrow window impossible.
    min-width: 56px;
    preferred-width: text.preferred-width + 24px;
    border-radius: 8px;
    border-width: kind == "danger" || kind == "destructive" ? 0 : 1px;
    // Turned off, every kind is a flat grey button with faint text: a primary one in a darker
    // accent still looked pressable. (No opacity layer: one per button is too much code.)
    border-color: !root.enabled ? Theme.border : kind == "primary" ? Theme.accent : Theme.ctrl-border;
    background: kind == "danger" ? transparent : !root.enabled ? Theme.ctrl-bg : kind == "primary" ? Theme.accent : kind == "destructive" ? Theme.danger : (self.has-hover ? Theme.hovered(Theme.ctrl-bg) : Theme.ctrl-bg);
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { clicked(); } }
    activated => { root.clicked(); }
    text := Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        color: !root.enabled ? Theme.faint : kind == "primary" ? Theme.on-accent : kind == "destructive" ? Theme.bg : kind == "danger" ? Theme.danger : Theme.text;
        font-size: 13px;
        font-weight: kind == "primary" || kind == "destructive" ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

/// A square button with only an icon; `label` names it for screen readers. 32 px on a page, 34
/// in a hero; `flat` (no border) for the small ones inside a row, a field or a banner.
export component IconButton inherits Focusable {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    in property <bool> flat;
    callback clicked();
    width: size;
    height: size;
    border-radius: size > 28px ? 8px : 6px;
    border-width: flat ? 0 : 1px;
    border-color: Theme.ctrl-border;
    background: self.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    activated => { root.clicked(); }
    Icon { name: root.icon; size: root.icon-size; tint: root.has-hover ? Theme.text : Theme.icon-soft; }
}

/// Adds an item to the list above it ("Add address", "Add a layout…"): as wide as its label.
export component AddButton inherits Focusable {
    in property <string> label;
    callback clicked();
    height: 32px;
    width: text.preferred-width + 24px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.enabled ? Theme.ctrl-border : Theme.border;
    background: self.has-hover && root.enabled ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { clicked(); } }
    activated => { root.clicked(); }
    text := Text { text: root.label; color: root.enabled ? Theme.icon-soft : Theme.faint; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
}

/// An on/off switch, drawn 20 px tall (22 in a pill) in a 24 px tall target. Off, its track has a
/// `ctrl-border` edge, which stands out 3:1 from the card. Turned off (`enabled: false`), it's
/// flat and faint; `shows-only` draws it as usable all the same, for a pill that takes the
/// clicks itself.
export component Switch inherits Focusable {
    in property <bool> on;
    in property <string> label;
    in property <length> switch-width: 34px;
    in property <bool> shows-only;
    callback toggled();
    property <bool> live: root.enabled || root.shows-only;
    width: switch-width;
    height: 24px;
    border-radius: self.height / 2;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: on;
    accessible-enabled: root.live;
    accessible-action-default => { if root.live { toggled(); } }
    activated => { root.toggled(); }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.switch-width == 34px ? 20px : 22px;
        border-radius: self.height / 2;
        background: !root.live ? Theme.ctrl-bg : root.on ? Theme.accent : Theme.off-track;
        border-width: root.on || !root.live ? 0 : 1px;
        border-color: Theme.ctrl-border;
        Rectangle {
            x: root.on ? parent.width - self.width - 2px : 2px;
            y: (parent.height - self.height) / 2;
            width: parent.height - 4px;
            height: self.width;
            border-radius: self.width / 2;
            background: !root.live ? Theme.faint : root.on ? Theme.on-accent : Theme.knob-off;
            animate x { duration: 120ms; easing: ease-out; }
        }
    }
}

/// A switch in a pill with its label, as the hero's master switches are: the whole pill
/// toggles, and the whole pill is one stop for the keyboard. note: a short machine value after
/// the label ("2:41"), if any.
export component PillSwitch inherits Focusable {
    in property <string> label;
    in property <bool> on;
    in property <string> note;
    callback toggled();
    width: pill.preferred-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.ctrl-border;
    background: self.has-hover ? Theme.hovered(Theme.input-bg) : Theme.input-bg;
    activated => { root.toggled(); }
    pill := HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        Text { text: root.label; color: Theme.text; font-size: 13px; vertical-alignment: center; }
        if root.note != "": Text { text: root.note; color: Theme.accent; font-size: 12px; font-family: "JetBrains Mono"; vertical-alignment: center; }
        // Only shows the state: the pill takes the clicks and the keyboard. A screen reader
        // still switches it here.
        Switch {
            on: root.on;
            label: root.label;
            switch-width: 40px;
            enabled: false;
            shows-only: true;
            y: (parent.height - self.height) / 2;
            toggled => { root.toggled(); }
        }
    }
}

// The headings, one scale for every page: a card's title, the uppercase label of a group of
// rows inside a card, and a field's label above its control.

export component CardTitle inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 600;
    vertical-alignment: center;
}

/// The small uppercase label above a group of rows.
export component SectionLabel inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
}

/// A message at the top of what it's about. tone: "info", "warn" or "danger", each with its own
/// icon. A bold `title` if there is one, the text, a button (`action`), and Dismiss unless it
/// can't be dismissed (it goes when what it says is fixed).
export component Banner inherits Rectangle {
    in property <string> tone: "info";
    in property <string> title;
    in property <string> text;
    in property <string> action;
    in property <bool> dismissible: true;
    callback action-clicked();
    callback dismissed();
    border-radius: 8px;
    border-width: 1px;
    border-color: tone == "danger" ? Theme.danger : tone == "warn" ? Theme.warn-border : Theme.border2;
    background: tone == "warn" ? Theme.warn-bg : transparent;
    accessible-role: AccessibleRole.text;
    accessible-label: title == "" ? text : title + " " + text;
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        // On the title's line, or beside a line of text.
        VerticalLayout {
            alignment: root.title != "" ? LayoutAlignment.start : LayoutAlignment.center;
            Icon {
                name: root.tone == "danger" ? "error" : root.tone == "warn" ? "warning" : "info";
                tint: root.tone == "danger" ? Theme.danger : root.tone == "warn" ? Theme.warn-text : Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            if root.title != "": Text { text: root.title; color: root.tone == "danger" ? Theme.danger : Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            Text {
                text: root.text;
                color: root.tone == "warn" ? Theme.warn-text : root.title != "" ? Theme.muted : Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            Button { label: root.action; button-height: 28px; min-width: self.preferred-width; horizontal-stretch: 0; clicked => { root.action-clicked(); } }
        }
        if root.dismissible: VerticalLayout {
            alignment: center;
            IconButton { icon: "close"; label: "Dismiss"; flat: true; size: 24px; icon-size: 12px; clicked => { root.dismissed(); } }
        }
    }
}

/// A key in the bar at the bottom of the window, and what it does on the page shown (Rust sends
/// only the keys that work there and then).
export struct Hint { key: string, label: string }

export component Kbd inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    spacing: 6px;
    alignment: start;
    Rectangle {
        border-width: 1px;
        border-color: Theme.border2;
        border-radius: 4px;
        width: k.preferred-width + 10px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        k := Text { text: root.key; color: Theme.icon-soft; font-size: 11px; font-family: "JetBrains Mono"; vertical-alignment: center; horizontal-alignment: center; }
    }
    Text { text: root.label; color: Theme.faint; font-size: 12px; vertical-alignment: center; }
}

/// A vertical scroll area with a thin scrollbar, shown when its content doesn't fit. Its
/// children are laid out top to bottom at its width. With `fill`, they fill its height (a list
/// card stretching) and only scroll once they're down to their minimum height; otherwise they
/// keep their preferred height (the details pane).
export component Scroll inherits Rectangle {
    in property <bool> fill;
    in property <length> spacing;
    /// The scrollbar's distance from the right edge; a negative one puts it in the padding
    /// beside the area instead of over its content.
    in property <length> bar-inset: 2px;
    /// The height the content asks for, for a page that sizes the area after it.
    out property <length> content-height: body.preferred-height;
    /// Scrolled by the user, with the wheel or the scrollbar.
    callback scrolled();
    // Its size comes from where it's put, never from the content; the content's width is still
    // the least it takes.
    min-width: body.min-width;
    min-height: 0;
    preferred-height: 0;
    max-width: 100000px;
    max-height: 100000px;
    property <length> range: flick.content-height - flick.height;
    /// The content doesn't fit, so it scrolls (and the scrollbar shows).
    out property <bool> overflows: root.range > 0.5px;
    // Content that got shorter (other details, say) stays at the bottom, not below it.
    changed range => { flick.content-y = max(flick.content-y, -max(0, root.range)); }

    /// Scrolls just enough to show the part from `top` (in window coordinates) that's `size` tall.
    public function reveal(top: length, size: length) {
        if top < self.absolute-position.y {
            flick.content-y = min(0, flick.content-y + self.absolute-position.y - top);
        } else if top + size > self.absolute-position.y + self.height {
            flick.content-y = max(-root.range, flick.content-y - (top + size - self.absolute-position.y - self.height));
        }
    }

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        // Dragging with the mouse belongs to what's under it (sliders, the monitors); the wheel,
        // the touchpad and the scrollbar scroll.
        mouse-drag-pan-enabled: false;
        content-height: max(self.height, root.fill ? body.min-height : body.preferred-height);
        flicked => { root.scrolled(); }
        body := VerticalLayout {
            width: flick.width;
            height: flick.content-height;
            spacing: root.spacing;
            alignment: root.fill ? LayoutAlignment.stretch : LayoutAlignment.start;
            @children
        }
    }

    if root.overflows: Rectangle {
        property <length> thumb: max(32px, self.height * flick.height / flick.content-height);
        property <length> start;
        x: root.width - self.width - root.bar-inset;
        width: 10px;
        accessible-role: none;
        Rectangle {
            x: parent.width - self.width;
            y: (parent.height - parent.thumb) * (-flick.content-y / root.range);
            width: touch.has-hover || touch.pressed ? 8px : 6px;
            height: parent.thumb;
            border-radius: self.width / 2;
            background: touch.has-hover || touch.pressed ? Theme.muted : Theme.faint;
            opacity: touch.has-hover || touch.pressed ? 0.9 : 0.55;
        }
        // Drag the thumb, or click beside it to move it there.
        touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    let top = (parent.height - parent.thumb) * (-flick.content-y / root.range);
                    if self.mouse-y < top || self.mouse-y > top + parent.thumb {
                        flick.content-y = -max(0, min(root.range, (self.mouse-y - parent.thumb / 2) / (parent.height - parent.thumb) * root.range));
                        root.scrolled();
                    }
                    parent.start = flick.content-y;
                }
            }
            moved => {
                if self.pressed {
                    flick.content-y = -max(0, min(root.range, -parent.start + (self.mouse-y - self.pressed-y) / (parent.height - parent.thumb) * root.range));
                    root.scrolled();
                }
            }
        }
    }
}
